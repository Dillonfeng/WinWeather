var CLOUD_D='<path d="M10 23h13a4.5 4.5 0 0 0 0-9 6.5 6.5 0 0 0-12 1.8A4 4 0 0 0 10 23z" fill="#90a4ae"/>';
var SUNRAYS='<g stroke="#ff8f00" stroke-width="2" stroke-linecap="round"><line x1="16" y1="1.6" x2="16" y2="4.6"/><line x1="16" y1="27.4" x2="16" y2="30.4"/><line x1="1.6" y1="16" x2="4.6" y2="16"/><line x1="27.4" y1="16" x2="30.4" y2="16"/><line x1="5.5" y1="5.5" x2="7.6" y2="7.6"/><line x1="24.4" y1="24.4" x2="26.5" y2="26.5"/><line x1="5.5" y1="26.5" x2="7.6" y2="24.4"/><line x1="24.4" y1="7.6" x2="26.5" y2="5.5"/></g>';
var DROPS3='<g stroke="#1e88e5" stroke-width="2.4" stroke-linecap="round"><line x1="11" y1="25" x2="9.5" y2="29.5"/><line x1="16" y1="25" x2="14.5" y2="29.5"/><line x1="21" y1="25" x2="19.5" y2="29.5"/></g>';
var DROPS5='<g stroke="#0d47a1" stroke-width="2.2" stroke-linecap="round"><line x1="8" y1="25" x2="6.5" y2="30"/><line x1="12" y1="25" x2="10.5" y2="30"/><line x1="16" y1="25" x2="14.5" y2="30"/><line x1="20" y1="25" x2="18.5" y2="30"/><line x1="24" y1="25" x2="22.5" y2="30"/></g>';
var FLAKES='<g stroke="#29b6f6" stroke-width="1.8" stroke-linecap="round"><line x1="11" y1="25.5" x2="11" y2="30"/><line x1="9" y1="26.6" x2="13" y2="28.9"/><line x1="13" y1="26.6" x2="9" y2="28.9"/><line x1="20" y1="25.5" x2="20" y2="30"/><line x1="18" y1="26.6" x2="22" y2="28.9"/><line x1="22" y1="26.6" x2="18" y2="28.9"/></g>';
var BOLT='<path d="M17.5 23l-4.5 6.5h3l-1.6 5.2 5.3-7.4h-3.1l1.9-4.3z" fill="#ffca28" stroke="#ff8f00" stroke-width="0.8"/>';
var FOGL='<g stroke="#78909c" stroke-width="2" stroke-linecap="round"><line x1="5" y1="26" x2="27" y2="26"/><line x1="8" y1="29.5" x2="24" y2="29.5"/></g>';
function weatherIcon(type){
  var t=type||"";
  if(t.indexOf("台风")>=0) return SVGH+'<circle cx="16" cy="16" r="13" fill="none" stroke="#c0392b" stroke-width="2.5"/>'
    +'<path d="M16 6c-2.5 3.4-2.5 6.6 0 10 2.5-3.4 2.5-6.6 0-10z" fill="#e74c3c"/>'
    +'<path d="M16 26c-2.5-3.4-2.5-6.6 0-10 2.5 3.4 2.5 6.6 0 10z" fill="#e74c3c"/>'
    +'<path d="M6 16c3.4-2.5 6.6-2.5 10 0-3.4 2.5-6.6 2.5-10 0z" fill="#e74c3c"/>'
    +'<path d="M26 16c-3.4 2.5-6.6 2.5-10 0 3.4-2.5 6.6-2.5 10 0z" fill="#e74c3c"/>'
    +'<circle cx="16" cy="16" r="2.6" fill="#fff" stroke="#c0392b" stroke-width="1.2"/></svg>';
  if(t.indexOf("雷")>=0) return SVGH+CLOUD_D+BOLT+"</svg>";
  if(t.indexOf("暴雨")>=0||t.indexOf("大雨")>=0) return SVGH+CLOUD_D+DROPS5+"</svg>";
  if(t.indexOf("雨")>=0) return SVGH+CLOUD_L+DROPS3+"</svg>";
  if(t.indexOf("雪")>=0) return SVGH+CLOUD_L+FLAKES+"</svg>";
  if(t.indexOf("雾")>=0||t.indexOf("霾")>=0) return SVGH+CLOUD_L+FOGL+"</svg>";
  if(t.indexOf("晴")>=0&&t.indexOf("多云")>=0) return SVGH+'<circle cx="12" cy="12" r="6" fill="#ffc107"/>'+CLOUD_L+"</svg>";
  if(t.indexOf("多云")>=0||t.indexOf("晴间")>=0) return SVGH+'<circle cx="11" cy="11" r="5.4" fill="#ffc107"/>'+CLOUD_L+"</svg>";
  if(t.indexOf("晴")>=0) return SVGH+'<circle cx="16" cy="16" r="7.5" fill="#ffb300"/>'+SUNRAYS+"</svg>";
  return SVGH+CLOUD_D+"</svg>";
}

/* ============================================================
   应用状态与界面
   ============================================================ */
var cur=new Date();
var viewY, viewM;
var inMonthView=false;
var cfg={city:"北京",code:"101010100",lat:39.9042,lng:116.4074,weekStart:1,showSchool:0};
var lastWeather=null, lastFetchTs=0, weatherFailed=false, weatherRetry=0;
var renderedYMD=null;
var lastTodayKey=0;   /* 上一次心跳看到的"今天"（YYYYMMDD），用于跨天检测 */
var posterKey=null, posterDetail=false, posterBusy=0;

function isToday(y,m,d){
  var n=new Date();
  return n.getFullYear()==y && n.getMonth()+1==m && n.getDate()==d;
}
function todayKeyOf(dt){
  return dt.getFullYear()*10000+(dt.getMonth()+1)*100+dt.getDate();
}
/* dt 是否等于 key 那天（key 形如 20261014） */
function isKeyOf(key, dt){
  return !!dt && todayKeyOf(dt)===key;
}
function fsoObj(){ try{ return new ActiveXObject("Scripting.FileSystemObject"); }catch(e){ return null; } }
function appFolder(){
  try{ return fsoObj().GetParentFolderName(location.pathname.replace(/\//g,"\\")); }catch(e){ return ""; }
}
function parseCfgText(s){
  var c={}, m;
  m=/"city"\s*:\s*"([^"]*)"/.exec(s);       if(m) c.city=m[1];
  m=/"lat"\s*:\s*(-?[0-9.]+)/.exec(s);      if(m) c.lat=parseFloat(m[1]);
  m=/"lng"\s*:\s*(-?[0-9.]+)/.exec(s);      if(m) c.lng=parseFloat(m[1]);
  m=/"code"\s*:\s*"([^"]*)"/.exec(s);       if(m) c.code=m[1];
  m=/"weekStart"\s*:\s*([01])/.exec(s);     if(m) c.weekStart=parseInt(m[1],10);
  m=/"showSchool"\s*:\s*([01])/.exec(s);   if(m) c.showSchool=parseInt(m[1],10);
  if(isNaN(c.lat)||isNaN(c.lng)) return null;
  return c;
}
function codeToCity(code){
  for(var k in cityMap){
    if(cityMap[k].code==code) return {city:k, code:code, lat:cityMap[k].lat, lng:cityMap[k].lng};
  }
  return null;
}
function loadCfg(){
  var folder=appFolder();
  if(!folder) return;
  try{
    var fso=fsoObj(), p=folder+"\\huangli_cfg.json";
    if(!fso.FileExists(p)) return;
    var f=fso.OpenTextFile(p,1);
    var s=f.ReadAll(); f.Close();
    var c=parseCfgText(s);
    if(!c) return;
    /* 每周起始日（0=周日, 1=周一）与城市无关，需在下面重建 c 之后回填 */
    var ws=(c.weekStart===0)?0:1;
    var shRaw=c.showSchool;   /* 可能为 undefined（老配置没有该字段） */
    /* 以城市编码为准，保证城市名/经纬度/天气编码三者始终一致 */
    if(c.code){
      var byCode=codeToCity(c.code);
      if(byCode) c=byCode;
      else c={city:(c.city||"北京"), code:c.code, lat:c.lat, lng:c.lng};
    }else if(c.city && cityMap[c.city]){
      c={city:c.city, code:cityMap[c.city].code, lat:cityMap[c.city].lat, lng:cityMap[c.city].lng};
    }else{
      return; /* 配置损坏，回到默认城市 */
    }
    cfg=c;
    cfg.weekStart=ws;
    /* 老配置缺该字段时：深圳默认开启春秋假，其他城市默认关闭 */
    cfg.showSchool=(shRaw===undefined)?((cfg.city==="深圳")?1:0):(shRaw===1?1:0);
  }catch(e){}
}
function saveCfg(){
  var folder=appFolder();
  if(!folder) return;
  try{
    var fso=fsoObj();
    /* 只写 ASCII（城市编码+经纬度），彻底避开系统代码页的中文编码问题 */
    var f=fso.CreateTextFile(folder+"\\huangli_cfg.json",true);
    f.Write('{"code":"'+cfg.code+'","lat":'+cfg.lat+',"lng":'+cfg.lng+',"weekStart":'+(cfg.weekStart===0?0:1)+',"showSchool":'+(cfg.showSchool===1?1:0)+'}\r\n');
    f.Close();
  }catch(e){}
}

/* ============================================================
   节日 / 节气 大图海报
   ============================================================ */
function posterGrad(name){
  if(/雪|寒|冬|霜/.test(name)) return ["#16305c","#93b7dd"];
  if(/秋|露|分|处暑/.test(name)) return ["#7d4310","#e2b25c"];
  if(/春|花|清|植|七|情/.test(name)) return ["#7a1f43","#e8a3b6"];
  if(/夏|暑|火|龙|端|劳/.test(name)) return ["#7d1d14","#e07c3c"];
  if(/雪/.test(name)) return ["#16305c","#93b7dd"];
  return ["#8e1b12","#e0b155"];
}
function posterSafe(name){ return String(name).replace(/[\\\/:*?"<>|]/g,""); }
/* 配图来源解析：依次尝试 jpg / jpeg / png / gif / bmp */
var POSTER_EXT=["jpg","jpeg","png","gif","bmp"];
function posterImgDir(){ var f=appFolder(); return f? f+"\\images" : ""; }
function posterRelOf(name,ext){
  var d=posterImgDir();
  if(!d) return "";
  return "images/"+posterSafe(name)+"."+ext;
}
function posterAbsOf(name,ext){
  var d=posterImgDir();
  if(!d) return "";
  return d+"\\"+posterSafe(name)+"."+ext;
}
/* 找出该节日实际存在的本地图片扩展名；没有则返回空 */
function posterLocalExt(name){
  var i, p;
  try{ var fso=fsoObj(); if(!fso) return ""; }catch(e){ return ""; }
  for(i=0;i<POSTER_EXT.length;i++){
    p=posterAbsOf(name,POSTER_EXT[i]);
    if(p && fso.FileExists(p)) return POSTER_EXT[i];
  }
  return "";
}
function posterRel(name){ return "images/"+posterSafe(name)+".jpg"; }
function posterAbs(name){
  var folder=appFolder();
  if(!folder) return "";
  return folder+"\\images\\"+posterSafe(name)+".jpg";
}
function posterHave(name){ return !!posterLocalExt(name); }
/* pic 字段的含义：
   空        -> 用节日名搜索（默认）
   http 开头 -> 直接当图片网址使用，不搜索
   其它文字  -> 先当本地图片文件名(同名.图片)找，找不到就用它当搜索关键词 */
function posterPicKind(pic){
  var p=String(pic||"").replace(/^\s+|\s+$/g,"");
  if(!p) return {kind:"auto",val:""};
  if(/^https?:\/\//i.test(p)) return {kind:"url",val:p};
  return {kind:"kw",val:p};
}
function xhrGet(url,onDone,isImg){
  var xhr=null, finished=false;
  try{ xhr=new ActiveXObject("MSXML2.ServerXMLHTTP.6.0"); }catch(e){ xhr=null; }
  if(!xhr){ onDone(false,null); return; }
  function finish(ok,data){ if(finished) return; finished=true; try{ onDone(ok,data); }catch(e2){} }
  try{
    try{ xhr.setTimeouts(40000,10000,10000,30000); }catch(e6){}
    xhr.open("GET",url,true);
    try{ xhr.setRequestHeader("User-Agent","Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1)"); }catch(e2){}
    if(isImg){
      try{ xhr.setRequestHeader("Accept","image/jpeg,image/png,*/*"); }catch(e7){}
      try{ xhr.setRequestHeader("Referer", /bing\.com/i.test(url)?"http://cn.bing.com/":"http://image.baidu.com/"); }catch(e8){}
    }
    xhr.onreadystatechange=function(){
      if(xhr.readyState==4){
        if(xhr.status==200){
          var body=null, text=null;
          try{ body=xhr.responseBody; }catch(e9){}
          try{ text=xhr.responseText; }catch(e10){}
          finish(true,{text:text, body:body});
        }else{ finish(false,null); }
      }
    };
    xhr.send(null);
  }catch(e){ finish(false,null); }
}
function isImgUrl(u){
  if(/\.(jpg|jpeg|png|gif|bmp|webp)(\?|$)/i.test(u)) return true;
  if(/\/it\/u=/.test(u)) return true;
  if(/\/thumb|\/bdimg|\/pic|\/image/i.test(u)) return true;
  return false;
}
function baiduImages(name,onList){
  var url="http://image.baidu.com/search/acjson?tn=resultjson_com&ipn=rj&ct=201326592&word="
        +encodeURIComponent(name)+"&pn=0&rn=12";
  xhrGet(url,function(ok,data){
    if(!ok||!data||!data.text){ onList([]); return; }
    var t=data.text, pairs=[], re=/"(objURL|middleURL|thumbURL|fromURLMiddle)"\s*:\s*"(https?:\/\/[^"]+)"/g, m;
    while((m=re.exec(t))){ pairs.push({k:m[1],u:m[2]}); }
    var order=["middleURL","objURL","fromURLMiddle","thumbURL"], out=[], oi, p;
    for(oi=0;oi<order.length;oi++){
      for(p=0;p<pairs.length;p++){
        if(pairs[p].k!==order[oi]) continue;
        var u=pairs[p].u;
        if(!isImgUrl(u)) continue;
        if(/logo|icon|qrcode/i.test(u)) continue;
        if(out.join("|").indexOf(u)>=0) continue;
        out.push(u);
        if(out.length>=8) break;
      }
      if(out.length>=8) break;
    }
    onList(out);
  });
}
function bingImages(name,onList){
  var url="http://cn.bing.com/search?q="+encodeURIComponent(name)+"&form=HDRSC2&first=1";
  xhrGet(url,function(ok,data){
    if(!ok||!data||!data.text){ onList([]); return; }
    var t=data.text, out=[], re=/"murl"\s*:\s*"(https?:\/\/[^"]+\.(?:jpg|jpeg|png))"/gi, m;
    while((m=re.exec(t)) && out.length<8){
      if(out.join("|").indexOf(m[1])>=0) continue;
      out.push(m[1]);
    }
    onList(out);
  });
}
var posterUrlMap=null;
function posterCacheFile(){ var f=appFolder(); return f? f+"\\images\\poster_urls.txt" : ""; }
function loadPosterUrls(){
  posterUrlMap={};
  var p=posterCacheFile();
  if(!p) return;
  try{
    var fso=fsoObj();
    if(fso.FileExists(p)){
      var f=fso.OpenTextFile(p,1), s=f.ReadAll(); f.Close();
      var lines=s.split("\n"), i, k;
      for(i=0;i<lines.length;i++){
        k=lines[i].split("\t");
        if(k.length>1){
          var nm=k[0].replace(/^\s+|\s+$/g,""), ur=k[1].replace(/^\s+|\s+$/g,"");
          if(nm&&ur) posterUrlMap[nm]=ur;
        }
      }
    }
  }catch(e){}
}
function savePosterUrl(name,url){
  if(!posterUrlMap) loadPosterUrls();
  if(posterUrlMap[name]) return;
  posterUrlMap[name]=url;
  var p=posterCacheFile();
  if(!p) return;
  try{
    var fso=fsoObj(), dir=appFolder()+"\\images";
    if(!fso.FolderExists(dir)) fso.CreateFolder(dir);
    var f=fso.CreateTextFile(p,true);
    f.Write(name+"\t"+url+"\r\n");
    f.Close();
  }catch(e){}
}
function posterSetSrc(url,name){
  var img=document.getElementById("posterImg");
  if(!img) return;
  img.style.display="block";
  try{ img.setAttribute("data-name",name||""); }catch(e){}
  img.src=url;
}
/* 异步回调可能晚于用户切换：名字已变就丢弃结果，避免旧图覆盖新图 */
function posterIsCurrent(name){
  return posterKey===name;
}
/* 切换节日时立刻抹掉上一张图，灰底占位，不让旧图滞留 */
function posterClearIfChanged(name){
  var img=document.getElementById("posterImg");
  if(!img) return;
  var cur="";
  try{ cur=img.getAttribute("data-name")||""; }catch(e){}
  if(cur===name) return;
  try{ img.onerror=null; img.onload=null; }catch(e1){}
  /* removeAttribute 与 src="" 都做一遍，确保旧图真的从渲染中撤掉 */
  try{ img.removeAttribute("src"); }catch(e2){}
  try{ img.src=""; }catch(e3){}
  img.style.display="none";
  try{ img.setAttribute("data-name",name||""); }catch(e3){}
}
function posterEnsureImage(name,pic){
  if(!name) return;
  posterClearIfChanged(name);
  /* 1) 本地图片优先：节日名 或 pic 指定的文件名 */
  var ext=posterLocalExt(name);
  if(ext){ posterSetSrc(posterRelOf(name,ext),name); return; }
  var pk=posterPicKind(pic);
  if(pk.kind==="kw" && pk.val){
    var e2=posterLocalExt(pk.val);
    if(e2){ posterSetSrc(posterRelOf(pk.val,e2),name); return; }
  }
  /* 2) pic 直接给了图片网址 -> 不搜索 */
  if(pk.kind==="url"){ posterSetSrc(pk.val,name); return; }
  /* 3) 已缓存的搜索结果 */
  if(!posterUrlMap) loadPosterUrls();
  var cacheKey=posterSafe(pk.kind==="kw"?pk.val:name);
  if(posterUrlMap[cacheKey]){ posterSetSrc(posterUrlMap[cacheKey],name); return; }
  if(posterBusy) return;            /* 正在下载其它节日，本次放弃 */
  /* 4) 联网搜索，关键词优先用 pic */
  var kw=(pk.kind==="kw"&&pk.val)?pk.val:name;
  posterBusy=1;
  defer(function(){
    baiduImages(kw,function(list){
      posterBusy=0;
      if(!posterIsCurrent(name)) return;
      if(list.length){ posterPick(name,cacheKey,list,0); return; }
      bingImages(kw,function(l2){
        posterBusy=0;
        if(posterIsCurrent(name) && l2.length) posterPick(name,cacheKey,l2,0);
      });
    });
  }, 500);
}
function posterPick(name,cacheKey,list,i){
  if(i>=list.length) return;
  if(!posterIsCurrent(name)) return;
  var img=document.getElementById("posterImg");
  if(!img) return;
  var url=list[i];
  img.onerror=function(){ if(posterIsCurrent(name)) posterPick(name,cacheKey,list,i+1); };
  img.onload=function(){ img.onerror=null; };
  img.style.display="block";
  try{ img.setAttribute("data-name",name); }catch(e){}
  img.src=url;
  if(i===0) savePosterUrl(cacheKey,url);
}
function updatePoster(y,m,d,lunar){
  var p=document.getElementById("poster");
  if(!p) return;
  if(inMonthView){ p.style.display="none"; return; }
  if(posterKey && !posterDetail){
    var g=posterGrad(posterKey);
    try{
      document.getElementById("pgStop1").setAttribute("stop-color",g[0]);
      document.getElementById("pgStop2").setAttribute("stop-color",g[1]);
    }catch(e){}
    document.getElementById("posterName").innerHTML=posterKey;
    document.getElementById("posterDate").innerHTML=y+"年"+m+"月"+d+"日 · 农历"
      +(lunar.isLeap?"闰":"")+monthName(lunar.month)+cDay(lunar.day);
    p.style.display="block";
    document.getElementById("dayView").style.display="none";
    posterEnsureImage(posterKey,posterPicOf(posterKey));
  }else{
    p.style.display="none";
    document.getElementById("dayView").style.display="table";
    posterClearIfChanged("");   /* 非节日日期：抹掉残留海报，避免下次进入时闪现旧图 */
  }
}
function bindPoster(){
  document.getElementById("poster").onclick=function(){
    posterDetail=true;
    var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
    updatePoster(y,m,d,toLunar(y,m,d));
  };
  document.getElementById("festLine").onclick=function(){
    var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
    var lu=toLunar(y,m,d);
    /* 弹窗：当天有自定义节日时再次滚动显示 */
    var mf=myFind(y,m,d,lu), i, wt=[];
    for(i=0;i<mf.length;i++){ if(mf[i].text) wt.push(mf[i].name+"　"+mf[i].text); }
    if(wt.length){ showMarquee(escHtml(wt.join("　　")), renderedYMD+"|"+mf[0].name); }
    if(posterKey && !posterDetail){
      posterDetail=false;
      updatePoster(y,m,d,lu);
    }
  };
}

function renderDay(){
  var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
  renderedYMD=y*10000+m*100+d;
  var lunar=toLunar(y,m,d);
  var p=pillars(y,m,d);
  var term=termIdxOfDay(y,m,d);
  var f=festivals(y,m,d,lunar,term);
  var dow=cur.getDay();
  var dayClass="dayNormal";
  if(f.length>0) dayClass="dayFest";
  else if(dow==0||dow==6) dayClass="dayWeekend";
  document.getElementById("sYearMonth").innerHTML=y+"年"+m+"月　星期"+"日一二三四五六".charAt(dow);
  var sd=document.getElementById("sDay");
  sd.className="bigday "+dayClass;
  sd.innerHTML=d;
  document.getElementById("lunarLine").innerHTML="农历 "+(lunar.isLeap?"闰":"")+monthName(lunar.month)+cDay(lunar.day);
  document.getElementById("gzLine").innerHTML=p.yGan+p.yZhi+"("+p.yAnimal+")年　"+p.mGan+p.mZhi+"月　"+p.dGan+p.dZhi+"日";
  var banner="&nbsp;";
  posterKey = posterPickName(f);
  posterDetail = false;
  if(f.length){
    banner="今日 "+f.join("　");
    if(posterKey) banner+="<span class='more'>▸ 查看大图</span>";
  }
  document.getElementById("festLine").className=(f.length&&posterKey)?"banner has":"banner";
  /* 没有节日时不保留空行，否则会白占约 23px，让「干支↔宜忌」之间出现空洞 */
  document.getElementById("festLine").style.display=(f.length)?"block":"none";
  document.getElementById("festLine").innerHTML=banner;
  var off=(p.dBranchIdx-p.mBranchIdx+12)%12;
  document.getElementById("yiList").innerHTML=OfficerYi[off].join("　");
  document.getElementById("jiList").innerHTML=OfficerJi[off].join("　");
  var chongB=(p.dBranchIdx+6)%12;
  document.getElementById("chongLine").innerHTML="<b>冲"+Animals[chongB]+"</b>("+Zhi[chongB]+")　"+shaOf(p.dBranchIdx)+"　·　值神："+Officer[off]+"日";
  var mp=moonPhase(lunar.day);
  document.getElementById("moonLine").innerHTML=mp[0]+"月相 "+mp[1];
  renderWeatherLine(y,m,d);
  var sv=sunTime(y,m,d,cfg.lat,cfg.lng,true), ss=sunTime(y,m,d,cfg.lat,cfg.lng,false);
  var sunEl=document.getElementById("sunLine");
  sunEl.innerHTML=ICON_SRISE+"日出 "+sv+"　"+ICON_SSET+"日落 "+ss;
  sunEl.title="按城市坐标 "+cfg.lat.toFixed(2)+"°N, "+cfg.lng.toFixed(2)+"°E 天文计算（NOAA 算法），与官方数据相差不超过 1~2 分钟；不同网站因取用观测点不同可能有几分钟出入。";
  updatePoster(y,m,d,lunar);
  /* 自定义节日滚动大字（每天只弹一次；点击可提前关闭） */
  var mf=myFind(y,m,d,lunar);
  if(mf.length){
    var withText=[], i;
    for(i=0;i<mf.length;i++){ if(mf[i].text) withText.push(mf[i].name+"　"+mf[i].text); }
    var mk=renderedYMD+"|"+mf[0].name;
    if(withText.length && toastKey!==mk){
      defer(function(){ showMarquee(escHtml(withText.join("　　")), mk); }, 260);
    }
  }
}
function escHtml(s){
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

function renderWeatherLine(y,m,d){
  var el=document.getElementById("weatherLine");
  var idx=currentForecastIndex();
  var fc=(idx>=0&&lastWeather&&lastWeather.forecast)?lastWeather.forecast[idx]:null;
  var lv=live;
  if(fc||lv){
    /* 天气状况以中国气象局(sojson)为准：wttr.in 用的是自有测站，偶发"附近有雨"就报毛毛雨，
       与国内官方口径不符。数值(温度/体感/风/气压/能见度)仍取 wttr.in 的实况，更及时。 */
    var cmaType=(fc&&fc.type)?fc.type:"";
    var wrType=(lv&&lv.type)?lv.type:"";
    var type=cmaType||wrType;
    var iconT=cmaType||wrType||"阴";
    var main="";
    if(lv&&lv.temp!=="") main=lv.temp+"°"+((lv.feels!=="")?(" 体感"+lv.feels+"°"):"");
    else if(fc) main=fc.low+"~"+fc.high+"°";
    var tip=[];
    if(fc) tip.push("气象局 "+fc.low+"~"+fc.high+"° "+fc.type);
    if(lv){ tip.push("实况 "+lv.temp+"°"); if(lv.pres) tip.push("气压 "+lv.pres+"hPa"); if(lv.vis) tip.push("能见度 "+lv.vis+"km"); if(lv.wind) tip.push(lv.wind+" "+lv.windKmh+"km/h"); }
    if(cmaType&&wrType&&cmaType!==wrType) tip.push("wttr.in 测站为"+wrType+"（"+(lv&&lv.desc?lv.desc:"")+"），与气象局口径可能有差异");
    var tpTxt=typhoonText();
    if(tpTxt) tip.push("⚠ 台风： "+tpTxt+(TYPHOON_AT?"（"+TYPHOON_AT+" 更新）":""));
    if(liveAt) tip.push("更新 "+liveAt);
    var wtxt=weatherIcon(iconT)+cfg.city+" "+type+"　"+main;
    if(tpTxt) wtxt=weatherIcon("台风")+cfg.city+" <span class='tyw'>⚠ "+tpTxt+"</span>";
    el.innerHTML=wtxt;
    el.title=tip.join(" · ");
    if(idx>=0) renderForecast5(idx);
    renderAirLine();
    return;
  }
  if(weatherFailed){
    el.innerHTML=weatherIcon("☁")+cfg.city+" 天气获取失败（请检查网络）";
  }else{
    el.innerHTML=weatherIcon("☁")+cfg.city+" 天气获取中…";
  }
  var el5=document.getElementById("fc5");
  if(el5) el5.innerHTML="";
  var el6=document.getElementById("airLine");
  if(el6) el6.innerHTML="&nbsp;";
}
function weekLabelOf(ymd){
  var p=String(ymd).split("-");
  if(p.length<3) return "";
  var w=new Date(parseInt(p[0],10), parseInt(p[1],10)-1, parseInt(p[2],10)).getDay();
  return "周"+"日一二三四五六".charAt(w);
}
function renderForecast5(idx){
  var el=document.getElementById("fc5");
  if(!el) return;
  var fc=lastWeather.forecast;
  var n=fc.length-idx; if(n>5) n=5;
  if(n<=0){ el.innerHTML=""; return; }
  var html="", i;
  for(i=0;i<n;i++){
    var f=fc[idx+i];
    var lbl=(i==0)?"今天":((i==1)?"明天":weekLabelOf(f.ymd));
    var a=aqiInfo(f.aqi);
    var aq=(a&&i==0)?"":"";
    var aqHtml=(a)?"<span class='aqism' style='color:"+a.c+";' title='当日预报AQI "+f.aqi+" "+a.n+"（非实时）'>"+f.aqi+"</span>":"";
    html+="<div class='cell'>"
        +"<div class='d'>"+lbl+aqHtml+"</div>"
        +"<div class='ic'>"+weatherIcon(f.type)+"</div>"
        +"<div class='t'>"+f.low+"~"+f.high+"°</div>"
        +"</div>";
  }
  el.innerHTML=html;
}

function defer(fn, ms){ try{ setTimeout(fn, ms||300); }catch(e){ try{ fn(); }catch(e2){} } }
function numOnly(s){ var m=/(-?[0-9]+(?:\.[0-9]+)?)/.exec(String(s)); return m?m[1]:""; }
function parseWeatherText(t){
  var res={wendu:"",shidu:"",pm25:"",pm10:"",quality:"",obsTime:"",aqi:-1,forecast:[]}, m, i;
  m=/"time"\s*:\s*"([^"]*)"/.exec(t);   if(m) res.obsTime=m[1];
  /* 顶层官方 AQI：出现在 "sunrise","sunset" 之后，紧跟 sunset，区别于 forecast[].aqi */
  m=/"sunset"\s*:\s*"[^"]*"\s*,\s*"aqi"\s*:\s*(\d+)/.exec(t); if(m) res.aqi=parseInt(m[1],10);
  m=/"wendu"\s*:\s*"([^"]*)"/.exec(t);   if(m) res.wendu=m[1];
  m=/"shidu"\s*:\s*"([^"]*)"/.exec(t);   if(m) res.shidu=m[1];
  m=/"pm25"\s*:\s*(-?[0-9.]+)/.exec(t);  if(m) res.pm25=m[1];
  m=/"pm10"\s*:\s*(-?[0-9.]+)/.exec(t);  if(m) res.pm10=m[1];
  m=/"quality"\s*:\s*"([^"]*)"/.exec(t); if(m) res.quality=m[1];
  var fm=/"forecast"\s*:\s*\[([\s\S]*?)\]\s*,\s*"yesterday"/.exec(t);
  if(!fm) fm=/"forecast"\s*:\s*\[([\s\S]*?)\]/.exec(t);
  if(fm){
    var chunks=fm[1].split("},{");
    for(i=0;i<chunks.length;i++){
      var c=chunks[i];
      var y=/"ymd"\s*:\s*"([^"]*)"/.exec(c);
      if(!y) continue;
      var ty=/"type"\s*:\s*"([^"]*)"/.exec(c);
      var lo=/"low"\s*:\s*"([^"]*)"/.exec(c);
      var hi=/"high"\s*:\s*"([^"]*)"/.exec(c);
      var aq=/"aqi"\s*:\s*(-?[0-9]+)/.exec(c);
      if(ty&&lo&&hi){
        res.forecast.push({ymd:y[1], type:ty[1], low:numOnly(lo[1]), high:numOnly(hi[1]),
                           aqi:aq?parseInt(aq[1],10):-1});
      }
    }
  }
  return res.forecast.length?res:null;
}
/* 国标 HJ 633-2012：IAQI 与污染物浓度分段对应，格式 [浓度上限, IAQI] */
var PM25_BP=[[0,0],[35,50],[75,100],[115,150],[150,200],[250,300],[350,400],[500,500]];
var PM10_BP =[[0,0],[50,50],[150,100],[250,150],[350,200],[420,300],[500,400],[600,500]];
function iaqiOf(c, bp){
  c=parseFloat(c);
  if(isNaN(c)||c<0) return -1;
  if(c>bp[bp.length-1][0]) c=bp[bp.length-1][0];
  for(var i=1;i<bp.length;i++){
    if(c<=bp[i][0]){
      return Math.round(bp[i-1][1]+(c-bp[i-1][0])/(bp[i][0]-bp[i-1][0])*(bp[i][1]-bp[i-1][1]));
    }
  }
  return bp[bp.length-1][1];
}
/* 实时 AQI：取 PM2.5 与 PM10 的较大 IAQI（国标取最大者） */
function calcRealtimeAQI(){
  if(!lastWeather) return -1;
  var a=iaqiOf(lastWeather.pm25,PM25_BP), b=iaqiOf(lastWeather.pm10,PM10_BP);
  if(a>b) return a;
  if(b>a) return b;
  return a;
}
function aqiInfo(v){
  if(v==null||isNaN(v)||v<0) return null;
  if(v<=50)  return {n:"优",c:"#1b5e20",bg:"#e8f5e9"};
  if(v<=100) return {n:"良",c:"#827717",bg:"#f9fbe7"};
  if(v<=150) return {n:"轻度污染",c:"#e65100",bg:"#fff3e0"};
  if(v<=200) return {n:"中度污染",c:"#c62828",bg:"#ffebee"};
  if(v<=300) return {n:"重度污染",c:"#6a1b9a",bg:"#f3e5f5"};
  return {n:"严重污染",c:"#7b1fa2",bg:"#ede7f6"};
}
function currentForecastIndex(){
  if(!lastWeather||!lastWeather.forecast) return -1;
  var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
  var ds=y+"-"+(m<10?"0"+m:m)+"-"+(d<10?"0"+d:d);
  for(var i=0;i<lastWeather.forecast.length;i++){
    if(lastWeather.forecast[i].ymd==ds) return i;
  }
  return -1;
}
function renderAirLine(){
  var el=document.getElementById("airLine");
  if(!el) return;
  var parts=[], tip=[];
  var lv=live;
  if(lv){
    if(lv.hum!=="") parts.push("湿度 <b>"+lv.hum+"%</b>");
    if(lv.wind) parts.push(lv.wind+"风 "+(lv.windKmh||"")+"km/h");
    /* 气压：中国气象局接口不提供，只能取 wttr.in 实况（悬停里已注明来源） */
    if(lv.pres) parts.push("气压 <b>"+lv.pres+"</b>");
  }else if(lastWeather && lastWeather.shidu){
    parts.push("湿度 <b>"+lastWeather.shidu+"</b>");
  }
/* 优先用中国气象局官方 AQI（含 O3/NO2 等全部污染物）；
   官方值缺失时才退回用 PM2.5/PM10 按国标 HJ633 自行换算。 */
var offAqi=(lastWeather&&lastWeather.aqi>=0)?lastWeather.aqi:-1;
var rt=(offAqi>=0)?offAqi:calcRealtimeAQI();
if(rt>=0){
    var a=aqiInfo(rt);
    if(a) parts.push("<span class='aqi' style='color:"+a.c+";background:"+a.bg+"'>空气 "+rt+" "+a.n+"</span>");
    tip.push(offAqi>=0?"AQI 为中国气象局官方发布值（含全部污染物）":"AQI 为国标HJ633按PM2.5/PM10换算（官方值缺失时的近似）");
    if(lastWeather.pm25) tip.push("PM2.5 "+lastWeather.pm25+" μg/m³");
    if(lastWeather.pm10) tip.push("PM10 "+lastWeather.pm10+" μg/m³");
    if(lastWeather.quality) tip.push("站点评级 "+lastWeather.quality);
    if(lastWeather.obsTime) tip.push("污染物观测 "+lastWeather.obsTime);
  }else{
    var idx=currentForecastIndex();
    if(lastWeather&&lastWeather.forecast&&idx>=0){
      var f=lastWeather.forecast[idx], a2=aqiInfo(f.aqi);
      if(a2) parts.push("<span class='aqi' style='color:"+a2.c+";background:"+a2.bg+"'>日AQI "+f.aqi+" "+a2.n+"</span>");
      tip.push("AQI 为当日预报值（非实时）");
    }
  }
  if(lv&&lv.pres) tip.push("气压 "+lv.pres+" hPa");
  if(lv&&lv.vis) tip.push("能见度 "+lv.vis+" km");
  if(liveAt) tip.push("天气更新 "+liveAt);
  el.innerHTML=parts.length?parts.join("　"):"&nbsp;";
  el.title=tip.join(" · ");
}

function weatherRetryLater(){
  if(weatherRetry>=2) return;
  weatherRetry++;
  defer(function(){ fetchWeather(true); }, 2500);
}
function fetchWeather(force){
  var now=new Date().getTime();
  if(!force && now-lastFetchTs<30*60*1000) return;
  lastFetchTs=now;
  var url="http://t.weather.sojson.com/api/weather/city/"+cfg.code;
  var xhr=null;
  try{ xhr=new ActiveXObject("MSXML2.ServerXMLHTTP.6.0"); }catch(e){
    try{ xhr=new ActiveXObject("Msxml2.XMLHTTP.6.0"); }catch(e2){
      try{ xhr=new XMLHttpRequest(); }catch(e3){ xhr=null; }
    }
  }
  if(!xhr){ weatherFailed=true; weatherRetryLater(); return; }
  try{
    try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e5){}
    xhr.open("GET",url,true);
    try{ xhr.setRequestHeader("User-Agent","Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1)"); }catch(e4){}
    xhr.onreadystatechange=function(){
      if(xhr.readyState==4){
        if(xhr.status==200){
          try{
            var w=parseWeatherText(xhr.responseText);
            if(w){ lastWeather=w; weatherFailed=false; weatherRetry=0; }
            else { weatherFailed=true; weatherRetryLater(); }
          }catch(ex){ weatherFailed=true; weatherRetryLater(); }
        }else{ weatherFailed=true; weatherRetryLater(); }
        if(!inMonthView) renderWeatherLine(cur.getFullYear(),cur.getMonth()+1,cur.getDate());
      }
    };
    xhr.send(null);
  }catch(e){ weatherFailed=true; weatherRetryLater(); }
}

var WEEK_CN=["日","一","二","三","四","五","六"];
function renderCalHead(ws){
  var tr=document.getElementById("calHead");
  if(!tr) return;
  /* IE 下不能给 tr 赋 innerHTML（抛"该操作的目标对象无效"），必须逐格删建 */
  try{ while(tr.cells.length>0){ tr.deleteCell(0); } }catch(e){}
  var i, dow, th;
  for(i=0;i<7;i++){
    dow=(ws+i)%7;                             /* 0=周日 … 6=周六 */
    th=document.createElement("th");
    th.innerHTML=WEEK_CN[dow];
    if(dow===0 || dow===6){ th.style.color="#c22012"; }
    tr.appendChild(th);
  }
}
function renderMonth(){
  var y=viewY, m=viewM;
  document.getElementById("mTitle").innerHTML=y+"年 "+m+"月"
    +"<span class='sync'>"+(holHasYear(y)?"调休已同步":"调休待公布")+"</span>";
  var first=new Date(y,m-1,1);
  var ws=(cfg.weekStart===0)?0:1;        /* 0=周日开头 1=周一开头 */
  renderCalHead(ws);
  var startCol=(first.getDay()-ws+7)%7;
  var days=solarDays(y,m);
  var t1n=(m-1)*2, t2n=t1n+1;
  var t1d=sTermDay(y,t1n), t2d=sTermDay(y,t2n);
  var n=new Date();
  var isThis=(n.getFullYear()==y && n.getMonth()+1==m);
  var tb=document.getElementById("calBody");
  var r, c, dnum=1;
  /* 注意：本环境下给 tbody 赋 innerHTML 会抛"该操作的目标对象无效"，
     必须用 insertRow/insertCell 构建，单元格内部再用 innerHTML 是正常的。 */
  while(tb.rows.length>0){ tb.deleteRow(0); }
  for(r=0;r<6;r++){
    var tr=tb.insertRow();
    for(c=0;c<7;c++){
      var td=tr.insertCell();
      var idx=r*7+c;
      if(idx<startCol || dnum>days){ td.className="empty"; continue; }
      var dd=dnum;
      var lunar=toLunar(y,m,dd);
      var adj=holDay(y,m,dd);                 /* 国务院调休安排 */
      var cls="", sub="";
      /* 副标题优先级：节气 > 节日 > 调休标记 > 农历 */
      if(dd==t1d){ sub=termNames[t1n]; cls="term"; }
      else if(dd==t2d){ sub=termNames[t2n]; cls="term"; }
      else{
        var f=festivals(y,m,dd,lunar,-1);
        if(f.length){ sub=f[0]; cls="fest"; }
      }
      if(!sub && adj && adj.type=="work"){
        sub="<span class='ban'>班</span>";
      }else if(!sub && adj && adj.type=="off"){
        var nm=adj.name;
        if(nm && !/^初[一二三四五六七八九十]$/.test(nm) && nm!="除夕"){ sub=nm; cls="fest"; }
        else sub="<span class='off'>休</span>";
      }
      if(!sub){
        if(lunar.day==1){ sub=(lunar.isLeap?"闰":"")+monthName(lunar.month); cls="lunar1"; }
        else sub=cDay(lunar.day);
      }
      var isToday=(isThis && dd==n.getDate());
      var sdCls="", tdCls="";
      if(isToday) tdCls="today";
      if(adj && adj.type=="work"){ tdCls=(tdCls?tdCls+" ":"")+"workday"; sdCls=" sdWork"; }
      else if(adj && adj.type=="off"){ tdCls=(tdCls?tdCls+" ":"")+"restday"; sdCls=" sdRest"; }
      else if(!isToday){
        if(cls=="fest"||cls=="term") sdCls=" sdFest";
        else if((ws+c)%7===0 || (ws+c)%7===6) sdCls=" sdWeekend";
      }
      td.className=tdCls;
      td.setAttribute("data-d", dd);
      td.innerHTML="<div class='sd"+sdCls+"'>"+dd+"</div><div class='ld "+cls+"'>"+sub+"</div>";
      dnum++;
    }
    if(dnum>days) break;
  }
}

function showView(month){
  inMonthView=month;
  document.getElementById("dayView").style.display=month?"none":"table";
  document.getElementById("monthView").style.display=month?"block":"none";
  document.getElementById("prevLbl").innerHTML=month?"上一月":"前一天";
  document.getElementById("nextLbl").innerHTML=month?"下一月":"后一天";
  document.getElementById("toggleBtn").innerHTML=month?"返回黄历":"万年历";
  if(month){ viewY=cur.getFullYear(); viewM=cur.getMonth()+1; renderMonth(); }
  else{ renderDay(); }
}

function shiftDay(delta){
  var nd=new Date(cur.getFullYear(),cur.getMonth(),cur.getDate()+delta);
  if(nd<new Date(1900,1,1) || nd>new Date(2100,11,31)) return;
  cur=nd;
  renderDay();
}
function shiftMonth(delta){
  var m=viewM+delta, y=viewY;
  while(m>12){ m-=12; y++; }
  while(m<1){ m+=12; y--; }
  if(y<1900 || y>2100) return;
  viewY=y; viewM=m; renderMonth();
}
function goToday(){ cur=new Date(); if(inMonthView){ viewY=cur.getFullYear(); viewM=cur.getMonth()+1; renderMonth(); } else { renderDay(); } }

/* ---------- 拖动 + 自动隐藏 ---------- */
var dragging=false, offX=0, offY=0;
var navTimer=0, topTimer=0;
function hideBars(){
  var ft=document.getElementById("floatTop"), nv=document.getElementById("nav");
  if(ft) ft.style.display="none";
  if(nv) nv.style.display="none";
}
function clearBarTimers(){
  try{ if(navTimer){ clearTimeout(navTimer); navTimer=0; } }catch(e){}
  try{ if(topTimer){ clearTimeout(topTimer); topTimer=0; } }catch(e){}
}
/* 兜底：即使鼠标不再移动，也强制在若干毫秒后收起，避免停留不消失 */
function armBarTimers(){
  clearBarTimers();
  try{
    navTimer=setTimeout(function(){
      var nv=document.getElementById("nav");
      if(nv) nv.style.display="none";
      navTimer=0;
    },2600);
    topTimer=setTimeout(function(){
      var ft=document.getElementById("floatTop");
      if(ft) ft.style.display="none";
      topTimer=0;
    },2600);
  }catch(e){}
}
function updateBars(){
  var e=window.event;
  if(!e) return;
  var y=e.clientY||0;
  var h=document.documentElement.clientHeight||document.body.clientHeight||660;
  var ft=document.getElementById("floatTop"), nv=document.getElementById("nav");
  var wantTop=(y>0 && y<32);
  var wantNav=(y>0 && y>h-50);
  if(ft) ft.style.display=wantTop?"block":"none";
  if(nv) nv.style.display=wantNav?"block":"none";
  if(wantTop||wantNav) armBarTimers(); else clearBarTimers();
}
function bindDrag(){
  document.onmousedown=function(){
    var e=window.event, t=e.srcElement;
    if(!t) return;
    if(t.tagName=="BUTTON"||t.tagName=="INPUT"||t.tagName=="TD"||t.tagName=="A") return;
    var p=t;
    while(p){
      if(p.id=="settings") return;
      p=p.parentNode;
    }
    dragging=true;
    offX=e.screenX-window.screenLeft;
    offY=e.screenY-window.screenTop;
  };
  document.onmousemove=function(){
    var e=window.event;
    if(dragging){
      window.moveTo(e.screenX-offX, e.screenY-offY);
    }
    updateBars();
  };
  document.onmouseup=function(){ dragging=false; };
  /* 指针离开窗口：立即收起（relatedTarget 为空表示真的离开了文档） */
  document.onmouseleave=function(){ dragging=false; hideBars(); clearBarTimers(); };
  document.onmouseout=function(){
    var e=window.event;
    if(!e.relatedTarget){ dragging=false; hideBars(); clearBarTimers(); }
  };
  window.onblur=function(){ hideBars(); clearBarTimers(); };
}

function tick(){
  /* 跨天自动翻页 + 天气定时刷新 + 调休安排每日复查 */
  var n=new Date();
  var key=todayKeyOf(n);
  if(!lastTodayKey) lastTodayKey=key;
  if(key!==lastTodayKey){
    /* 真实日期已变。若用户原本停在"今天"，自动跟进新的一天；否则保持所看日期不动，只刷新标记 */
    var oldY=Math.floor(lastTodayKey/10000), oldM=Math.floor(lastTodayKey/100)%100;
    if(inMonthView){
      if(viewY===oldY && viewM===oldM){ viewY=n.getFullYear(); viewM=n.getMonth()+1; }
      renderMonth();
    }else{
      if(isKeyOf(lastTodayKey, cur)){ cur=new Date(n.getFullYear(), n.getMonth(), n.getDate()); }
      renderedYMD=null;
      renderDay();
    }
    lastTodayKey=key;
    fetchWeather(true);
    fetchLive();
  }else if(!inMonthView && isToday(cur.getFullYear(),cur.getMonth()+1,cur.getDate()) && key!=renderedYMD){
    renderDay();
  }
  fetchWeather(false);
  if(holNeedSync()) syncHolidays(false, function(st,updated){ if(updated) redrawCurrent(); });
  if(schoolNeedSync()) syncSchool(false, function(){ redrawCurrent(); });
  /* 实况每 10 分钟刷新一次（原 30 分钟，过于滞后） */
  var nowMs=n.getTime();
  if(nowMs-lastLiveTs>=10*60*1000){
    lastLiveTs=nowMs;
    fetchLive();
    fetchTyphoon();
  }
}
var lastLiveTs=0;
function redrawCurrent(){
  try{
    if(inMonthView) renderMonth(); else renderDay();
  }catch(e){}
}

var mfMsgTimer=0;
function mfMsg(txt, ok){
  var el=document.getElementById("mfMsg");
  if(!el) return;
  el.innerHTML=txt?("<span class='"+(ok?"ok":"err")+"'>"+escHtml(txt)+"</span>"):"";
  try{ if(mfMsgTimer){ clearTimeout(mfMsgTimer); mfMsgTimer=0; } }catch(e){}
  if(txt){
    try{ mfMsgTimer=setTimeout(function(){ var e2=document.getElementById("mfMsg"); if(e2) e2.innerHTML=""; }, 5000); }
    catch(e2){}
  }
}
function mfSetBtn(editing){
  var b=document.getElementById("mfAdd"), c=document.getElementById("mfCancel");
  if(b) b.innerHTML=editing?"保存修改":"添加";
  if(c) c.style.display=editing?"inline-block":"none";
}
function mfStartEdit(idx){
  var it=MYF[idx];
  if(!it) return;
  mfEditIdx=idx;
  var nEl=document.getElementById("mfName"), dEl=document.getElementById("mfDate"),
      tEl=document.getElementById("mfText"), yEl=document.getElementById("mfType"),
      pEl=document.getElementById("mfPic");
  if(nEl) nEl.value=it.name;
  if(yEl) yEl.value=it.type;
  if(dEl) dEl.value=(it.type=="L")?it.date:it.date;
  if(tEl) tEl.value=it.text||"";
  if(pEl) pEl.value=it.pic||"";
  mfSetBtn(true);
  mfMsg("正在修改「"+it.name+"」，改完点「保存修改」", true);
  try{ nEl.focus(); }catch(e){}
}
function mfCancelEdit(){
  mfEditIdx=-1;
  var nEl=document.getElementById("mfName"), dEl=document.getElementById("mfDate"),
      tEl=document.getElementById("mfText"), pEl=document.getElementById("mfPic");
  if(nEl) nEl.value=""; if(dEl) dEl.value=""; if(tEl) tEl.value=""; if(pEl) pEl.value="";
  mfSetBtn(false);
  mfMsg("");
}
function mfAddAction(){
  var nEl=document.getElementById("mfName"), dEl=document.getElementById("mfDate"),
      tEl=document.getElementById("mfText"), yEl=document.getElementById("mfType"),
      pEl=document.getElementById("mfPic");
  if(!nEl||!dEl||!yEl) return;
  var name=String(nEl.value||"").replace(/^\s+|\s+$/g,"");
  if(!name){ mfMsg("请先填写名称"); try{ nEl.focus(); }catch(e1){} return; }
  var type=String(yEl.value||"Y");
  if(type!="Y" && type!="L" && type!="O") type="Y";
  var dt=myNormalizeDate(dEl.value, type);
  if(!dt){
    mfMsg(type=="O"?"日期格式应为 2027-03-14":(type=="L"?"农历日期格式应为 8-15":"公历日期格式应为 03-14"));
    try{ dEl.focus(); }catch(e2){}
    return;
  }
  var i, it;
  for(i=0;i<MYF.length;i++){
    if(i===mfEditIdx) continue;
    it=MYF[i];
    if(it.type==type && it.name==name && it.date==dt){ mfMsg("「"+name+"」"+myTypeLabel(type)+" "+dt+" 已存在"); return; }
  }
  var rec={type:type, name:name, date:dt, text:String((tEl&&tEl.value)||"").replace(/^\s+|\s+$/g,""),
            pic:String((pEl&&pEl.value)||"").replace(/^\s+|\s+$/g,"")};
  var editing=mfEditIdx>=0;
  if(editing) MYF[mfEditIdx]=rec; else MYF.push(rec);
  mfEditIdx=-1;
  myRebuildMap();
  var saved=mySave();
  renderMfList(); redrawCurrent();
  nEl.value=""; dEl.value=""; if(tEl) tEl.value=""; if(pEl) pEl.value="";
  mfSetBtn(false);
  mfMsg(saved
      ?(editing?("已保存「"+name+"」的修改"):("已添加「"+name+"」"+myDesc(rec)))
      :(editing?("已修改，但写入 myfest.txt 失败，重启后会恢复"):("已添加，但写入 myfest.txt 失败，重启后会丢失")),
      saved);
  try{ nEl.focus(); }catch(e3){}
}
function bindSettingsUI(){
  var addBtn=document.getElementById("mfAdd");
  if(addBtn) addBtn.onclick=mfAddAction;
  var kf=function(e){
    var k=e.keyCode||e.which;
    if(k==13){ try{ e.returnValue=false; }catch(e4){} mfAddAction(); }
  };
  var ids=["mfName","mfDate","mfText","mfPic"];
  for(var q=0;q<ids.length;q++){
    var inp=document.getElementById(ids[q]);
    if(inp) inp.onkeypress=kf;
  }
  var canBtn=document.getElementById("mfCancel");
  if(canBtn) canBtn.onclick=mfCancelEdit;
  document.getElementById("mfList").onclick=function(e){
    var t=e.srcElement;
    if(!t) return;
    if(t.className=="x"){
      var idx=parseInt(t.getAttribute("data-i"),10);
      if(isNaN(idx)) return;
      if(!confirm("删除「"+MYF[idx].name+"」？")) return;
      if(mfEditIdx===idx) mfCancelEdit();
      else if(mfEditIdx>idx) mfEditIdx--;
      MYF.splice(idx,1);
      myRebuildMap();
      var okDel=mySave();
      renderMfList();
      redrawCurrent();
      if(!okDel) mfMsg("已删除，但写入 myfest.txt 失败，重启后会恢复", false);
      return;
    }
    if(t.className=="e"){
      var ei=parseInt(t.getAttribute("data-i"),10);
      if(!isNaN(ei)) mfStartEdit(ei);
      return;
    }
    var p=t;
    while(p && p.id!="mfList"){
      if(String(p.className||"").indexOf("mfItem")>=0){
        var ci=parseInt(p.getAttribute("data-e"),10);
        if(!isNaN(ci)) mfStartEdit(ci);
        return;
      }
      p=p.parentNode;
    }
  };
}
function renderMfList(){
  var el=document.getElementById("mfList");
  if(!el) return;
  if(!MYF.length){ el.innerHTML="<div class='mfEmpty'>还没有自定义节日，在下面添加吧。</div>"; return; }
  var html="", i, it;
  for(i=0;i<MYF.length;i++){
    it=MYF[i];
    html+="<div class='mfItem"+(i===mfEditIdx?" editing":"")+"' data-e='"+i+"'>"
        +"<span class='e' data-i='"+i+"' title='编辑'>✎</span>"
        +"<span class='x' data-i='"+i+"' title='删除'>✕</span>"
        +"<b>"+escHtml(it.name)+"</b> <span class='d'>"+myDesc(it)+"</span>"
        +"<span class='d'> · "+myTypeLabel(it.type)+"</span>"
        +(it.text?("<div class='t'>"+escHtml(it.text)+"</div>"):"")
        +(it.pic?("<div class='t' style='color:#2e7d32'>配图："+escHtml(it.pic)+"</div>"):"")
        +"</div>";
  }
  el.innerHTML=html;
}
/* ============================================================
   开机自动启动（写 HKCU Run，无需管理员权限）
   本程序是 GUI 程序，不能做成 Windows Service（Service 在 Session 0
   无桌面，无法显示窗口），因此改为登录后自动启动。
   ============================================================ */
var RUN_SUB="Software\\Microsoft\\Windows\\CurrentVersion\\Run";
var RUN_NAME="WinCalendar";
function shellObj(){ try{ return new ActiveXObject("WScript.Shell"); }catch(e){ return null; } }
function runRegFull(){ return "HKCU\\"+RUN_SUB+"\\"+RUN_NAME; }
function autostartCmd(htaPath){
  var raw="";
  if(htaPath!=null) raw=String(htaPath);
  else{
    try{ raw=String((typeof location!="undefined" && location && location.pathname)||""); }catch(e){ raw=""; }
  }
  var hta=raw.replace(/\//g,"\\");
  if(!/\.hta$/i.test(hta)) return "";
  var mshta="mshta.exe";
  try{
    var s=new ActiveXObject("WScript.Shell");
    if(s) mshta=s.ExpandEnvironmentStrings("%SystemRoot%\\System32\\mshta.exe");
  }catch(e){}
  return '"'+mshta+'" "'+hta+'"';
}
function isAutostart(){
  try{
    var s=shellObj();
    if(!s) return false;
    var v=s.RegRead(runRegFull());
    return !!(v && String(v).length);
  }catch(e){ return false; }
}
function setAutostart(on){
  var s=shellObj();
  if(!s) return false;
  var p=runRegFull();
  if(on){
    var cmd=autostartCmd();
    if(!cmd) return false;
    try{ s.RegWrite(p, cmd, "REG_SZ"); return true; }catch(e){ return false; }
  }
  if(!isAutostart()) return true;   /* 本来就是关的，无需删除 */
  try{ s.RegDelete(p); return !isAutostart(); }catch(e2){ return false; }
}
/* ============================================================
   台风信息（中国气象局台风网 typhoon.nmc.cn，免密钥、支持 HTTP）
   注意：暴雨/高温/雷电等各类气象预警目前没有免密钥的 HTTP 接口，
   只能覆盖台风。如需其它预警类型，只能后续接入带 key 的商业 API。
   ============================================================ */
var TYPHOON_URL="http://typhoon.nmc.cn/weatherservice/typhoon/jsons/list_default";
var TYPHOONS=[];          /* 活跃台风 [{cn,en,num}] */
var TYPHOON_AT="";
var TYPHOON_STATUS={TS:"热带风暴",STS:"强热带风暴",TY:"台风",STY:"强台风",SuperTY:"超强台风",TD:"热带低压"};
/* 把 JSONP 里的一条数组按顶层逗号切分，正确跳过引号与嵌套括号 */
function splitTopLevel(s){
  var out=[], buf="", i, c, depth=0, q=false;
  for(i=0;i<s.length;i++){
    c=s.charAt(i);
    if(q){
      buf+=c;
      if(c==="\\"){ buf+=s.charAt(++i); continue; }
      if(c==='"') q=false;
      continue;
    }
    if(c==='"'){ q=true; buf+=c; continue; }
    if(c==="["||c==="{"){ depth++; buf+=c; continue; }
    if(c==="]"||c==="}"){ depth--; buf+=c; continue; }
    if(c===","&&depth===0){ out.push(buf); buf=""; continue; }
    buf+=c;
  }
  if(buf.length) out.push(buf);
  return out;
}
function parseTyphoonList(txt){
  try{
    var rows=[], re=/\[\s*(\d+)\s*,/g, m, start;
    while((m=re.exec(txt))){
      start=m.index;
      var depth=0, i, c, end=-1, q=false;
      for(i=start;i<txt.length;i++){
        c=txt.charAt(i);
        if(q){ if(c==="\\"){ i++; continue; } if(c==='"') q=false; continue; }
        if(c==='"'){ q=true; continue; }
        if(c==="[") depth++;
        else if(c==="]"){ depth--; if(depth===0){ end=i; break; } }
      }
      if(end<0) break;
      var inner=txt.substring(start,end+1);
      var f=splitTopLevel(inner.substring(1,inner.length-1));
      if(f.length>=8) rows.push(f);
      re.lastIndex=end;
    }
    /* 解析不出任何条目：区分"合法的空列表"与"响应损坏"。
       返回 null 表示本次失败，调用方会保留上一次的台风数据，不会误清空。 */
    if(!rows.length){
      return /"typhoonList"\s*:\s*\[\s*\]/.test(txt)?[]:null;
    }
    var out=[], i, r;
    for(i=0;i<rows.length;i++){
      r=rows[i];
      var status=String(r[7]||"").replace(/"/g,"");
      if(status==="stop") continue;            /* 已停编，不显示 */
      out.push({
        id:r[0].replace(/"/g,""),
        en:String(r[1]||"").replace(/"/g,""),
        cn:String(r[2]||"").replace(/"/g,"").replace(/\\n/g,""),
        num:r[3].replace(/"/g,""),
        status:status,
        level:TYPHOON_STATUS[status]||"编号中"
      });
    }
    return out;
  }catch(e){ return null; }
}
function fetchTyphoon(cb){
  cb=cb||function(){};
  xhrGet(TYPHOON_URL,function(ok,data){
    if(ok&&data&&data.text){
      var t=parseTyphoonList(data.text);
      if(t){ TYPHOONS=t; TYPHOON_AT=nowClock(); }
    }
    cb(ok);
  });
}
/* 台风提示文案；无台风返回空串 */
function typhoonText(){
  if(!TYPHOONS.length) return "";
  var a=[], i;
  for(i=0;i<TYPHOONS.length;i++){ a.push(TYPHOONS[i].cn+"（"+TYPHOONS[i].num+"·"+TYPHOONS[i].level+"）"); }
  return a.join("、");
}
function initApp(){
  try{ window.resizeTo(430,660); }catch(e){}
  try{ window.moveTo(screen.availWidth-460,30); }catch(e){}
  loadCfg();
  bindDrag();
  bindPoster();
  bindToast();
  bindMarquee();
  bindSettingsUI();
  bindSchoolUI();
  myLoad();
  schoolLoad();
  holInit(); holLoad();
  document.getElementById("btnClose").onclick=function(){ window.close(); };
  document.getElementById("btnSettings").onclick=function(){
    var sel=document.getElementById("cfgCity");
    if(!sel.options.length){
      for(var k in cityMap){
        sel.options[sel.options.length]=new Option(k,k);
      }
    }
    sel.value=cfg.city;
    var wsel=document.getElementById("cfgWeek");
    if(wsel) wsel.value=(cfg.weekStart===0)?"0":"1";
    var ssel=document.getElementById("cfgSchool");
    if(ssel) ssel.value=(cfg.showSchool===1)?"1":"0";
    var asel=document.getElementById("cfgAuto");
    if(asel) asel.value=isAutostart()?"1":"0";
    sel.onchange=function(){ cfg.city=sel.value; updateSchoolRow(); renderSchList(); };
    updateSchoolRow();
    renderSchList();
    renderMfList();
    document.getElementById("holTip").innerHTML=
      "放假调休安排来自国务院办公厅通知，可联网自动同步。<br>"+escHtml(holStatusText());
    document.getElementById("settings").style.display="block";
  };
  document.getElementById("cfgSave").onclick=function(){
    /* 开机自启：写/删 HKCU Run 注册表项 */
    var asel=document.getElementById("cfgAuto");
    if(asel){
      var wantOn=(asel.value==="1");
      var okAuto=setAutostart(wantOn);
      if(!okAuto){
        alert(wantOn?"无法写入启动项，请检查注册表权限。":"无法删除启动项，请检查注册表权限。");
      }else if(wantOn){
        asel.title=autostartCmd();
      }
    }
    var city=document.getElementById("cfgCity").value;
    var ssel=document.getElementById("cfgSchool");
    cfg.showSchool=(ssel&&ssel.value==="1" && SCHOOL_MAP[city])?1:0;
    if(city && cityMap[city]){
      cfg.city=city;
      cfg.code=cityMap[city].code;
      cfg.lat=cityMap[city].lat;
      cfg.lng=cityMap[city].lng;
      lastWeather=null; weatherFailed=false; live=null;
      fetchWeather(true); fetchLive();
    }
    /* 每周起始日与城市无关，单独设置并始终落盘 */
    var wsel=document.getElementById("cfgWeek");
    cfg.weekStart=(wsel&&wsel.value==="0")?0:1;
    saveCfg();
    document.getElementById("settings").style.display="none";
    redrawCurrent();
  };
  document.getElementById("cfgCancel").onclick=function(){
    document.getElementById("settings").style.display="none";
  };
  document.getElementById("holSync").onclick=function(){
    var btn=this, tip=document.getElementById("holTip");
    btn.disabled=true; tip.innerHTML="正在同步国务院放假调休安排…";
    syncHolidays(true,function(st,updated){
      btn.disabled=false;
      tip.innerHTML=(updated?("已更新 "+updated+" 个年度"):"未获取到更新（可能尚未公布或无网络）")
        +"　当前："+holStatusText();
      redrawCurrent();
    });
  };
  document.getElementById("schSync").onclick=function(){
    var btn=this, tip=document.getElementById("schTip");
    btn.disabled=true; tip.innerHTML="正在检查校历数据…";
    syncSchool(true,function(st){
      btn.disabled=false;
      updateSchoolRow();
      tip.innerHTML=(st=="synced"?"校历已更新。\n":"暂无可用远程校历数据源，已使用内置数据。\n")+schoolStatusText();
      redrawCurrent();
    });
  };
  document.getElementById("prevBtn").onclick=function(){ inMonthView?shiftMonth(-1):shiftDay(-1); };
  document.getElementById("nextBtn").onclick=function(){ inMonthView?shiftMonth(1):shiftDay(1); };
  document.getElementById("todayBtn").onclick=goToday;
  document.getElementById("toggleBtn").onclick=function(){ showView(!inMonthView); };
  document.getElementById("prevYear").onclick=function(){ shiftMonth(-12); };
  document.getElementById("nextYear").onclick=function(){ shiftMonth(12); };
  document.getElementById("prevMonth").onclick=function(){ shiftMonth(-1); };
  document.getElementById("nextMonth").onclick=function(){ shiftMonth(1); };
  document.getElementById("calBody").onclick=function(){
    var e=window.event, t=e.srcElement;
    while(t && t.tagName!="TD") t=t.parentNode;
    if(t && t.getAttribute("data-d")){
      cur=new Date(viewY,viewM-1,parseInt(t.getAttribute("data-d"),10));
      showView(false);
    }
  };
  showView(false);
  lastTodayKey=todayKeyOf(new Date());
  defer(function(){ fetchWeather(true); fetchLive(); }, 400);
  defer(function(){ fetchTyphoon(); }, 900);
  defer(function(){ fetchLive(); }, 2500);
  /* 调休安排：启动后延迟同步（避开 onload 阶段的请求限制），之后每天复查一次 */
  defer(function(){ syncHolidays(false, function(st,updated){ if(updated) redrawCurrent(); }); }, 1200);
  setInterval(tick,30000);
}

if(typeof window!="undefined"){ window.onload=initApp; }
//__HL_END__
</script>
</body>
</html>
