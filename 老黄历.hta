  ["祈福","求嗣","嫁娶","立约","捕捉"],
  ["求医","治病","破屋","坏垣","余事勿取"],
  ["祭祀","安床","拆卸","破土","启钻"],
  ["嫁娶","开市","交易","立券","出行","动土","祈福"],
  ["祭祀","纳财","签约","纳畜","捕捉","收账"],
  ["祭祀","祈福","入学","开市","嫁娶","出行","动土"],
  ["祭祀","筑堤","补垣","塞穴","安葬"]];
var OfficerJi = [
  ["动土","开仓","嫁娶","纳采"],
  ["开市","动土","嫁娶","移徙","探病"],
  ["服药","栽种","动土","移徙","入宅"],
  ["嫁娶","开市","安葬","移徙"],
  ["栽种","掘井","词讼","出行"],
  ["移徙","远行","开仓","出货财"],
  ["诸事不宜"],
