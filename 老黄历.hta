<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=9">
<title>老黄历</title>
<HTA:APPLICATION
  ID="oHuangLi"
  APPLICATIONNAME="HuangLi"
  BORDER="none"
  CAPTION="no"
  SYSMENU="no"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SHOWINTASKBAR="no"
  SINGLEINSTANCE="yes"
  SCROLL="no"
  CONTEXTMENU="no"
  INNERBORDER="no"
  SELECTION="no"
/>
<style>
html,body{margin:0;padding:0;overflow:hidden;background:#b3251a;
  font-family:"KaiTi","STKaiti","楷体","DFKai-SB",serif;width:100%;height:100%;}
#app{position:absolute;top:0;left:0;right:0;bottom:0;background:#b3251a;color:#2b2b2b;overflow:hidden;}
#page{position:absolute;top:2px;left:2px;right:2px;bottom:2px;background:#f7f0dc;overflow:hidden;
  border:1px solid #d9b877;}
/* ---------- 顶部浮动栏（鼠标靠近顶部显示） ---------- */
#floatTop{position:absolute;top:0;left:0;right:0;height:28px;z-index:15;display:none;
  background:#b3251a;color:#fbe9c6;font-size:15px;font-weight:bold;
  letter-spacing:8px;text-align:center;line-height:28px;cursor:move;}
#floatTop .tbbtn{position:absolute;top:0;width:32px;height:28px;line-height:28px;text-align:center;
  border:none;background:transparent;color:#fbe9c6;font-size:16px;cursor:pointer;letter-spacing:0;
  font-family:"Segoe UI Symbol",sans-serif;padding:0;}
#floatTop .tbbtn:hover{background:#8f1d12;color:#fff;}
#btnSettings{left:0;}
#btnClose{right:0;}
/* ============ 每日黄历 ============ */
#dayView{display:table;width:100%;height:100%;table-layout:fixed;}
.dvRow{display:table-row;}
/* Row1 只留够「年月日+农历+干支」的高度：内容顶对齐 + 固定上内边距，
   使丙午马年停在原位置；行末不留空白，紧接宜忌。
   多出来的高度全部给 Row3，由放大的月相图标与 5 天预报消化。 */
#dayView .dvRow:nth-child(1){height:38%;}
#dayView .dvRow:nth-child(2){height:19%;}
#dayView .dvRow:nth-child(3){height:43%;}
.dvCell{display:table-cell;padding:0 14px;}
/* 顶对齐 + 固定上内边距：让干支行停在原来的绝对位置，行末不留缝 */
/* padding-top 30 让「年月星期」避开自动隐藏的 28px 顶栏（页面 y=30 起，顶栏到 y=28） */
.dvHeroCell{vertical-align:top;text-align:center;padding-top:28px;}
.dvYijiCell{vertical-align:middle;padding:4px 12px;}
.dvInfoCell{vertical-align:top;padding:2px 12px 6px;}
.solarRow{text-align:center;}
.ym{font-size:19px;color:#7a6242;letter-spacing:3px;}
/* margin-top 由 28 降到 9，把上面让出的 19px 补回来，
   使大数字及其下方（农历/干支）位置保持不变 */
.bigday{font-size:140px;font-weight:bold;line-height:1.0;margin-top:17px;
  font-family:"Bahnschrift","Consolas","Courier New",monospace;}
.bigday.dayNormal{color:#2e7d32;}
.bigday.dayWeekend{color:#1565c0;}
.bigday.dayFest{color:#c22012;}
.lunarLine{text-align:center;font-size:26px;color:#a8231a;margin-top:0;letter-spacing:1px;}
.gzLine{text-align:center;font-size:16px;color:#5a4a3a;margin-top:0;}
.banner{text-align:center;font-size:19px;font-weight:bold;color:#b3251a;margin-top:6px;min-height:26px;letter-spacing:1px;}
.banner.has{cursor:pointer;}
.banner .more{font-size:13px;font-weight:normal;color:#8a6a2a;text-decoration:underline;margin-left:6px;}
/* ============ 节日 / 节气 大图海报 ============ */
#poster{position:absolute;top:0;left:0;right:0;bottom:0;z-index:12;display:none;cursor:pointer;
  background:#8e1b12;overflow:hidden;}
#posterSvg{position:absolute;top:0;left:0;width:100%;height:100%;}
#posterImg{position:absolute;top:0;left:0;width:100%;height:100%;display:none;}
#posterShade{position:absolute;left:0;right:0;bottom:0;height:132px;background:rgba(0,0,0,0.48);}
#posterName{position:absolute;left:0;right:0;bottom:58px;text-align:center;color:#fff6dd;
  font-size:46px;font-weight:bold;letter-spacing:10px;}
#posterDate{position:absolute;left:0;right:0;bottom:26px;text-align:center;color:#ffe9b8;
  font-size:16px;letter-spacing:2px;}
#posterHint{position:absolute;left:0;right:0;top:0;height:24px;line-height:24px;text-align:center;
  color:#fff6dd;font-size:12px;background:rgba(0,0,0,0.4);letter-spacing:4px;}
.yiji{border:1px solid #c9a063;background:#fdf8ec;width:100%;}
.yiji table{width:100%;border-collapse:collapse;table-layout:fixed;}
.yiji td{width:50%;vertical-align:top;padding:9px 12px;}
.yiji td.sep{border-left:1px dashed #d8b877;}
.stamp{display:inline-block;width:30px;height:30px;line-height:30px;text-align:center;
  font-size:18px;font-weight:bold;color:#fff;border-radius:4px;}
.yiStamp{background:#a8231a;}
.jiStamp{background:#3a3a3a;}
.yjList{font-size:15.5px;line-height:23px;color:#2b2b2b;margin-top:4px;}
.infoLine{text-align:center;font-size:15px;color:#5a4a3a;line-height:23px;}
.infoLine b{color:#a8231a;}
.aqi{display:inline-block;padding:0 7px;border-radius:9px;font-size:12.5px;line-height:19px;
  vertical-align:1px;font-weight:bold;}
.aqism{font-size:11px;margin-left:3px;font-weight:bold;}
.wico{font-size:30px;line-height:1;vertical-align:middle;margin-right:3px;}
.wsvg{width:30px;height:30px;vertical-align:middle;margin-right:3px;}
.wsvg.moon{width:44px;height:44px;margin-right:8px;vertical-align:-9px;}
.wsvg.sm{width:23px;height:23px;margin-right:2px;vertical-align:-3px;}
#moonLine{font-size:17px;margin:0;line-height:44px;}
#sunLine{margin-top:2px;}
/* 未来五天天气 */
.fc5{margin-top:5px;padding-top:4px;border-top:1px dashed #d8b877;}
.fc5 .cell{display:inline-block;width:20%;text-align:center;vertical-align:top;}
.fc5 .d{font-size:12.5px;color:#7a6a55;line-height:17px;}
.fc5 .ic{height:34px;line-height:34px;}
.fc5 .wsvg{width:30px;height:30px;margin:0;}
.fc5 .t{font-size:12.5px;color:#a8231a;font-weight:bold;line-height:17px;}
.aqism{font-size:11.5px;margin-left:3px;font-weight:bold;}
.tyw{color:#c0392b;font-weight:bold;}
.fc5 .t b{font-weight:normal;color:#c9a063;}
/* ============ 万年历 ============ */
#monthView{position:absolute;top:0;left:0;right:0;bottom:0;display:none;}
.mHeader{position:absolute;top:0;left:0;right:0;height:46px;text-align:center;line-height:46px;
  border-bottom:1px solid #e6d5ad;background:#f2e7cc;}
.mHeader button{border:none;background:#b3251a;color:#fbe9c6;font-size:15px;width:32px;height:30px;
  cursor:pointer;margin:0 3px;vertical-align:middle;font-family:inherit;}
.mHeader button:hover{background:#8f1d12;}
#mTitle{font-size:23px;font-weight:bold;color:#8c2f23;vertical-align:middle;display:inline-block;
  min-width:160px;letter-spacing:2px;}
#calWrap{position:absolute;top:52px;left:8px;right:8px;bottom:8px;}
#calTable{width:100%;height:100%;border-collapse:collapse;table-layout:fixed;}
#calTable th{font-size:15px;color:#8c2f23;border:1px solid #e0d2b0;background:#efe4c8;padding:4px 0;font-weight:bold;}
#calTable td{border:1px solid #e6dabd;vertical-align:middle;padding:2px;cursor:pointer;background:#fbf6e9;text-align:center;}
#calTable td:hover{background:#f3e5c3;}
#calTable td.empty{background:transparent;border-color:#efe6cf;cursor:default;}
#calTable td.today{background:#b3251a;}
#calTable td.today .sd,#calTable td.today .ld{color:#fff !important;}
.sd{font-size:22px;font-weight:bold;color:#2b2b2b;font-family:"Bahnschrift","Consolas",monospace;text-align:center;}
.sd.sdFest{color:#c22012;}
.sd.sdWeekend{color:#2b6cb0;}
.sd.sdWork{color:#8a6a2a;}
.sd.sdRest{color:#c22012;}
#calTable td.workday{background:#f7f0e2;}
#calTable td.restday{background:#fdf1ee;}
#calTable td.today.workday,#calTable td.today.restday{background:#b3251a;}
.ld .ban{display:inline-block;background:#8a6a2a;color:#fff;border-radius:2px;
  font-size:10px;line-height:13px;padding:0 3px;}
.ld .off{display:inline-block;background:#c22012;color:#fff;border-radius:2px;
  font-size:10px;line-height:13px;padding:0 3px;}
#mTitle .sync{font-size:11px;font-weight:normal;color:#8a7a60;margin-left:8px;letter-spacing:0;}
.ld{font-size:13px;color:#7a6a55;text-align:center;white-space:nowrap;overflow:hidden;}
.ld .ico{font-size:14px;vertical-align:middle;margin-right:1px;}
.ld.fest,.ld.term{color:#c22012;font-weight:bold;}
.ld.lunar1{color:#8c2f23;}
/* ---------- 底部导航（自动隐藏） ---------- */
#nav{position:absolute;bottom:0;left:0;right:0;height:48px;z-index:15;display:none;
  background:#b3251a;border-top:2px solid #8f1d12;text-align:center;}
#nav button{border:none;background:#f2e7cc;color:#a8231a;font-size:15px;font-weight:bold;
  padding:0 13px;height:32px;margin:8px 4px 0 4px;cursor:pointer;font-family:inherit;
  border-radius:3px;}
#nav button:hover{background:#fff8e7;}
/* ---------- 自定义节日提示 ---------- */
#toast{position:absolute;top:96px;left:22px;right:22px;z-index:30;display:none;cursor:pointer;
  background:#fff8e7;border:2px solid #b3251a;box-shadow:0 8px 24px rgba(60,20,10,0.42);
  padding:13px 16px;color:#3a2f28;}
#toast .tclose{position:absolute;top:1px;right:7px;color:#b3251a;font-size:17px;line-height:20px;}
#toast .ttitle{font-size:17px;font-weight:bold;color:#b3251a;margin-bottom:6px;letter-spacing:1px;}
#toast .tbody{font-size:13.5px;line-height:20px;color:#5a4a3a;white-space:pre-wrap;}
#toast .thint{font-size:11px;color:#9a8a70;margin-top:7px;}
#mqOverlay{position:absolute;top:0;left:0;width:100%;height:100%;z-index:40;display:none;cursor:pointer;overflow:hidden;
  background:rgba(60,20,10,0.55);}
#mqText{position:absolute;top:44%;left:0;white-space:nowrap;
  font-size:52px;font-weight:bold;color:#ffe9a8;letter-spacing:4px;
  text-shadow:0 3px 10px rgba(0,0,0,0.75),0 0 26px rgba(255,180,60,0.55);
  font-family:"Microsoft YaHei","SimHei",sans-serif;}
/* ---------- 设置 ---------- */
#settings{position:absolute;top:40px;left:24px;right:24px;max-height:580px;overflow:auto;
  background:#fff8e7;border:2px solid #b3251a;
  box-shadow:0 6px 18px rgba(60,20,10,0.35);
  padding:14px;z-index:20;display:none;font-size:14px;color:#3a2f28;}
#settings .sect{font-size:13.5px;font-weight:bold;color:#b3251a;border-top:1px solid #e0d0a8;
  padding-top:9px;margin:12px 0 7px;letter-spacing:1px;}
.mfItem{border:1px solid #e0d0a8;background:#fffdf6;padding:5px 8px;margin-bottom:5px;font-size:13px;position:relative;}
.mfItem b{color:#a8231a;}
.mfItem .d{color:#7a6a55;font-size:11.5px;}
.mfItem .x{position:absolute;top:3px;right:7px;color:#b3251a;font-weight:bold;cursor:pointer;font-size:14px;}
.mfItem .e{position:absolute;top:3px;right:24px;color:#2e7d32;font-weight:bold;cursor:pointer;font-size:14px;}
.mfItem.editing{background:#fff3d6;border-color:#d4a017;}
.mfItem .t{color:#5a4a3a;font-size:12px;margin-top:2px;white-space:pre-wrap;}
.mfAdd input,.mfAdd select{width:100%;font-family:inherit;font-size:13px;padding:3px 5px;
  border:1px solid #c9a063;background:#fff;margin-bottom:5px;}
.mfAdd .two{display:inline-block;width:48.5%;vertical-align:top;}
.mfAdd .two2{display:inline-block;width:48.5%;vertical-align:top;margin-left:2%;}
.mfEmpty{font-size:12px;color:#9a8a70;padding:4px 0;}
.mfMsg{min-height:17px;font-size:12px;margin-top:3px;}
.mfMsg .err{color:#b3251a;}
.mfMsg .ok{color:#1b5e20;}
#settings .row{margin-bottom:12px;}
#settings label{display:inline-block;width:56px;}
#settings select{width:180px;font-family:inherit;font-size:15px;padding:3px 4px;border:1px solid #c9a063;background:#fff;}
#settings button{border:none;background:#b3251a;color:#fbe9c6;font-size:15px;padding:6px 18px;margin-right:8px;cursor:pointer;font-family:inherit;border-radius:3px;}
#settings .hint{font-size:13px;color:#8a7a60;margin-bottom:12px;}
</style>
</head>
<body>
<div id="app">
  <div id="floatTop">
    <button id="btnSettings" class="tbbtn" title="设置">⚙</button>
    老黄历
    <button id="btnClose" class="tbbtn" title="关闭">✕</button>
  </div>

  <div id="page">
    <!-- 每日一页 -->
    <div id="dayView">
      <div class="dvRow">
        <div class="dvCell dvHeroCell">
          <div class="solarRow">
            <div class="ym" id="sYearMonth"></div>
            <div class="bigday" id="sDay"></div>
          </div>
          <div class="lunarLine" id="lunarLine"></div>
          <div class="gzLine" id="gzLine"></div>
          <div class="banner" id="festLine"></div>
        </div>
      </div>
      <div class="dvRow">
        <div class="dvCell dvYijiCell">
          <div class="yiji">
            <table>
              <tr>
                <td><div class="stamp yiStamp">宜</div><div class="yjList" id="yiList"></div></td>
                <td class="sep"><div class="stamp jiStamp">忌</div><div class="yjList" id="jiList"></div></td>
              </tr>
            </table>
          </div>
        </div>
      </div>
      <div class="dvRow">
        <div class="dvCell dvInfoCell">
          <div class="infoLine" id="chongLine"></div>
          <div class="infoLine" id="moonLine"></div>
          <div class="infoLine" id="weatherLine"></div>
          <div class="infoLine" id="airLine"></div>
          <div class="fc5" id="fc5"></div>
          <div class="infoLine" id="sunLine"></div>
        </div>
      </div>
    </div>

    <!-- 节日 / 节气 大图海报（点击翻回当前布局） -->
    <div id="poster">
      <svg id="posterSvg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"
           preserveAspectRatio="xMidYMid slice" viewBox="0 0 424 654">
        <defs>
          <linearGradient id="pgGrad" x1="0" y1="0" x2="0.5" y2="1">
            <stop id="pgStop1" offset="0" stop-color="#8e1b12"/>
            <stop id="pgStop2" offset="1" stop-color="#e0b155"/>
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="424" height="654" fill="url(#pgGrad)"/>
      </svg>
      <img id="posterImg" alt="">
      <div id="posterShade"></div>
      <div id="posterName"></div>
      <div id="posterDate"></div>
      <div id="posterHint">点击查看今日详情</div>
    </div>

    <!-- 万年历 -->
    <div id="monthView">
      <div class="mHeader">
        <button id="prevYear" title="上一年">≪</button>
        <button id="prevMonth" title="上一月">◀</button>
        <span id="mTitle"></span>
        <button id="nextMonth" title="下一月">▶</button>
        <button id="nextYear" title="下一年">≫</button>
      </div>
      <div id="calWrap">
        <table id="calTable">
          <thead>
            <tr id="calHead"><th>一</th><th>二</th><th>三</th><th>四</th><th>五</th><th style="color:#c22012;">六</th><th style="color:#c22012;">日</th></tr>
          </thead>
          <tbody id="calBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="nav">
    <button id="prevBtn">◀ <span id="prevLbl">前一天</span></button>
    <button id="todayBtn">回到今天</button>
    <button id="nextBtn"><span id="nextLbl">后一天</span> ▶</button>
    <button id="toggleBtn">万年历</button>
  </div>

  <!-- 自定义节日弹窗 -->
  <div id="toast">
    <div class="tclose">✕</div>
    <div class="ttitle" id="toastTitle"></div>
    <div class="tbody" id="toastBody"></div>
    <div class="thint">点击任意处关闭</div>
  </div>

  <!-- 自定义节日滚动大字 -->
  <div id="mqOverlay">
    <div id="mqText"></div>
  </div>

  <!-- 设置面板 -->
  <div id="settings">
    <div class="hint">选择城市（天气数据来源：中国气象局，国内可直连）</div>
    <div class="row"><label>城市</label><select id="cfgCity"></select></div>
    <div class="row"><label>每周</label><select id="cfgWeek">
      <option value="1">周一开头</option>
      <option value="0">周日开头</option>
    </select></div>
    <div class="row"><label>开机</label><select id="cfgAuto">
      <option value="0">不自动启动</option>
      <option value="1">登录后自动启动</option>
    </select></div>
    <div class="row" id="schRow"><label>学校</label><select id="cfgSchool">
      <option value="0">不显示学校假期</option>
      <option value="1">显示学校假期（寒暑假/春秋假）</option>
    </select></div>
    <div class="hint" id="schTip"></div>
    <div id="schList"></div>
    <div class="mfAdd">
      <input id="schName" placeholder="名称，如：寒假">
      <span class="two"><input id="schFrom" placeholder="开始 2027-01-23"></span><span class="two2"><input id="schTo" placeholder="结束 2027-02-21"></span>
      <button id="schAdd">添加校历</button>
      <button id="schCancel" style="display:none;">取消</button>
      <div id="schMsg" class="mfMsg"></div>
    </div>
    <div class="row">
      <button id="cfgSave">保存</button>
      <button id="cfgCancel">取消</button>
      <button id="holSync">同步调休</button>
      <button id="schSync">同步校历</button>
    </div>
    <div class="hint" id="holTip">放假调休安排来自国务院办公厅通知，可联网自动同步。</div>

    <div class="sect">自定义节日（结婚纪念日、生日等）</div>
    <div id="mfList"></div>
    <div class="mfAdd">
      <input id="mfName" placeholder="名称，如：结婚纪念日">
      <span class="two"><select id="mfType">
        <option value="Y">每年（公历）</option>
        <option value="L">每年（农历）</option>
        <option value="O">仅一次</option>
      </select></span><span class="two2"><input id="mfDate" placeholder="03-14 / 农历8-15 / 2027-03-14"></span>
      <input id="mfText" placeholder="弹窗文字，如：结婚十周年！">
      <input id="mfPic" placeholder="配图（可选）：图片网址 / 搜索词 / images 下的图片名">
      <button id="mfAdd">添加</button>
      <button id="mfCancel" style="display:none;">取消</button>
      <div id="mfMsg" class="mfMsg"></div>
    </div>
  </div>
</div>

<script language="javascript">
//__HL_START__
/* ============================================================
   农历 / 节气 / 干支 引擎（1900-01-31 ~ 2100-12-31）
   ============================================================ */
var lunarInfo = [
0x04bd8,0x04ae0,0x0a570,0x054d5,0x0d260,0x0d950,0x16554,0x056a0,0x09ad0,0x055d2,
0x04ae0,0x0a5b6,0x0a4d0,0x0d250,0x1d255,0x0b540,0x0d6a0,0x0ada2,0x095b0,0x14977,
0x04970,0x0a4b0,0x0b4b5,0x06a50,0x06d40,0x1ab54,0x02b60,0x09570,0x052f2,0x04970,
0x06566,0x0d4a0,0x0ea50,0x06e95,0x05ad0,0x02b60,0x186e3,0x092e0,0x1c8d7,0x0c950,
0x0d4a0,0x1d8a6,0x0b550,0x056a0,0x1a5b4,0x025d0,0x092d0,0x0d2b2,0x0a950,0x0b557,
0x06ca0,0x0b550,0x15355,0x04da0,0x0a5b0,0x14573,0x052b0,0x0a9a8,0x0e950,0x06aa0,
0x0aea6,0x0ab50,0x04b60,0x0aae4,0x0a570,0x05260,0x0f263,0x0d950,0x05b57,0x056a0,
0x096d0,0x04dd5,0x04ad0,0x0a4d0,0x0d4d4,0x0d250,0x0d558,0x0b540,0x0b6a0,0x195a6,
0x095b0,0x049b0,0x0a974,0x0a4b0,0x0b27a,0x06a50,0x06d40,0x0af46,0x0ab60,0x09570,
0x04af5,0x04970,0x064b0,0x074a3,0x0ea50,0x06b58,0x055c0,0x0ab60,0x096d5,0x092e0,
