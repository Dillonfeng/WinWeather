var solarMonth = [31,28,31,30,31,30,31,31,30,31,30,31];
var Gan  = ["甲","乙","丙","丁","戊","己","庚","辛","壬","癸"];
var Zhi  = ["子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥"];
var Animals = ["鼠","牛","虎","兔","龙","蛇","马","羊","猴","鸡","狗","猪"];
var termNames = ["小寒","大寒","立春","雨水","惊蛰","春分","清明","谷雨","立夏","小满","芒种","夏至","小暑","大暑","立秋","处暑","白露","秋分","寒露","霜降","立冬","小雪","大雪","冬至"];
var numCn = ["","一","二","三","四","五","六","七","八","九"];

var lFests = {"1-1":"春节","1-15":"元宵节","2-2":"龙抬头","5-5":"端午节","7-7":"七夕节","7-15":"中元节","8-15":"中秋节","9-9":"重阳节","12-8":"腊八节","12-23":"小年(北)","12-24":"小年(南)"};
/* 固定日期节日（公历）：含东方传统纪念日与西方节日 */
var sFests = {
  "1-1":"元旦","2-14":"情人节","3-5":"雷锋纪念日","3-8":"妇女节","3-12":"植树节",
  "3-15":"消费者权益日","3-22":"世界水日","4-1":"愚人节","4-22":"世界地球日",
  "4-23":"世界读书日","5-1":"劳动节","5-4":"青年节","5-12":"护士节",
  "6-1":"儿童节","6-5":"世界环境日","6-6":"爱眼日","7-1":"建党节","8-1":"建军节",
  "9-3":"抗战胜利日","9-10":"教师节","9-18":"九一八纪念日","10-1":"国庆节",
  "10-31":"万圣夜","11-1":"万圣节","11-11":"光棍节","12-13":"国家公祭日",
  "12-24":"平安夜","12-25":"圣诞节"
};
/* 大节日：当天展示整页配图；其余小节日仅在日历中标注 */
var majorFests = {
  "元旦":1,"春节":1,"除夕":1,"元宵节":1,"龙抬头":1,"端午节":1,"七夕节":1,
  "中秋节":1,"重阳节":1,"腊八节":1,"劳动节":1,"国庆节":1,"儿童节":1,
  "圣诞节":1,"平安夜":1,"情人节":1
};
/* 复活节（西方，用匿名格里高利算法） */
function easterDate(y){
  var a=y%19, b=Math.floor(y/100), c=y%100;
  var d=Math.floor(b/4), e=b%4, f=Math.floor((b+8)/25), g=Math.floor((b-f+1)/3);
  var h=(19*a+b-d-g+15)%30, i=Math.floor(c/4), k=c%4;
  var l=(32+2*e+2*i-h-k)%7, mm=Math.floor((a+11*h+22*l)/451);
  var mon=Math.floor((h+l-7*mm+114)/31), day=((h+l-7*mm+114)%31)+1;
  return new Date(y,mon-1,day);
}
/* 浮动节日：母亲节/父亲节/感恩节/黑色星期五/复活节 */
function movableFests(y,m,d){
  var out=[], dt=new Date(y,m-1,d), w=dt.getDay(), dom=dt.getDate();
  if(m==5 && w==0 && dom>=8 && dom<=14) out.push("母亲节");
  if(m==6 && w==0 && dom>=15 && dom<=21) out.push("父亲节");
  if(m==11 && w==4 && dom>=22 && dom<=28){ out.push("感恩节"); }
  if(m==11 && w==5 && dom>=23 && dom<=29) out.push("黑色星期五");
  var ea=easterDate(y);
  if(m==ea.getMonth()+1 && d==ea.getDate()) out.push("复活节");
  var gf=new Date(ea.getFullYear(),ea.getMonth(),ea.getDate()-2);
  if(m==gf.getMonth()+1 && d==gf.getDate()) out.push("受难日");
  return out;
}

