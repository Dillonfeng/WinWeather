var CLOUD_L='<path d="M10 23h13a4.5 4.5 0 0 0 0-9 6.5 6.5 0 0 0-12 1.8A4 4 0 0 0 10 23z" fill="#cfd8dc"/>';
var CLOUD_D='<path d="M10 23h13a4.5 4.5 0 0 0 0-9 6.5 6.5 0 0 0-12 1.8A4 4 0 0 0 10 23z" fill="#90a4ae"/>';
var SUNRAYS='<g stroke="#ff8f00" stroke-width="2" stroke-linecap="round"><line x1="16" y1="1.6" x2="16" y2="4.6"/><line x1="16" y1="27.4" x2="16" y2="30.4"/><line x1="1.6" y1="16" x2="4.6" y2="16"/><line x1="27.4" y1="16" x2="30.4" y2="16"/><line x1="5.5" y1="5.5" x2="7.6" y2="7.6"/><line x1="24.4" y1="24.4" x2="26.5" y2="26.5"/><line x1="5.5" y1="26.5" x2="7.6" y2="24.4"/><line x1="24.4" y1="7.6" x2="26.5" y2="5.5"/></g>';
var DROPS3='<g stroke="#1e88e5" stroke-width="2.4" stroke-linecap="round"><line x1="11" y1="25" x2="9.5" y2="29.5"/><line x1="16" y1="25" x2="14.5" y2="29.5"/><line x1="21" y1="25" x2="19.5" y2="29.5"/></g>';
var DROPS5='<g stroke="#0d47a1" stroke-width="2.2" stroke-linecap="round"><line x1="8" y1="25" x2="6.5" y2="30"/><line x1="12" y1="25" x2="10.5" y2="30"/><line x1="16" y1="25" x2="14.5" y2="30"/><line x1="20" y1="25" x2="18.5" y2="30"/><line x1="24" y1="25" x2="22.5" y2="30"/></g>';
var FLAKES='<g stroke="#29b6f6" stroke-width="1.8" stroke-linecap="round"><line x1="11" y1="25.5" x2="11" y2="30"/><line x1="9" y1="26.6" x2="13" y2="28.9"/><line x1="13" y1="26.6" x2="9" y2="28.9"/><line x1="20" y1="25.5" x2="20" y2="30"/><line x1="18" y1="26.6" x2="22" y2="28.9"/><line x1="22" y1="26.6" x2="18" y2="28.9"/></g>';
var BOLT='<path d="M17.5 23l-4.5 6.5h3l-1.6 5.2 5.3-7.4h-3.1l1.9-4.3z" fill="#ffca28" stroke="#ff8f00" stroke-width="0.8"/>';
var FOGL='<g stroke="#78909c" stroke-width="2" stroke-linecap="round"><line x1="5" y1="26" x2="27" y2="26"/><line x1="8" y1="29.5" x2="24" y2="29.5"/></g>';
function weatherIcon(type){
  var t=type||"";
  if(t.indexOf("台风")>=0) return SVGH+'<circle cx="16" cy="16" r="13" fill="none" stroke="#c0392b" stroke-width="2.5"/>'
    +'<path d="M16 6c-2.5 3.4-2.5 6.6 0 10 2.5-3.4 2.5-6.6 0-10z" fill="#e74c3c"/>'
    +'<path d="M16 26c-2.5-3.4-2.5-6.6 0-10 2.5 3.4 2.5 6.6 0 10z" fill="#e74c3c"/>'
    +'<path d="M6 16c3.4-2.5 6.6-2.5 10 0-3.4 2.5-6.6 2.5-10 0z" fill="#e74c3c"/>'
    +'<path d="M26 16c-3.4 2.5-6.6 2.5-10 0 3.4-2.5 6.6-2.5 10 0z" fill="#e74c3c"/>'
    +'<circle cx="16" cy="16" r="2.6" fill="#fff" stroke="#c0392b" stroke-width="1.2"/></svg>';
  if(t.indexOf("雷")>=0) return SVGH+CLOUD_D+BOLT+"</svg>";
  if(t.indexOf("暴雨")>=0||t.indexOf("大雨")>=0) return SVGH+CLOUD_D+DROPS5+"</svg>";
  if(t.indexOf("雨")>=0) return SVGH+CLOUD_L+DROPS3+"</svg>";
  if(t.indexOf("雪")>=0) return SVGH+CLOUD_L+FLAKES+"</svg>";
  if(t.indexOf("雾")>=0||t.indexOf("霾")>=0) return SVGH+CLOUD_L+FOGL+"</svg>";
  if(t.indexOf("晴")>=0&&t.indexOf("多云")>=0) return SVGH+'<circle cx="12" cy="12" r="6" fill="#ffc107"/>'+CLOUD_L+"</svg>";
  if(t.indexOf("多云")>=0||t.indexOf("晴间")>=0) return SVGH+'<circle cx="11" cy="11" r="5.4" fill="#ffc107"/>'+CLOUD_L+"</svg>";
  if(t.indexOf("晴")>=0) return SVGH+'<circle cx="16" cy="16" r="7.5" fill="#ffb300"/>'+SUNRAYS+"</svg>";
  return SVGH+CLOUD_D+"</svg>";
}

/* ============================================================
   应用状态与界面
   ============================================================ */
var cur=new Date();
var viewY, viewM;
var inMonthView=false;
var cfg={city:"北京",code:"101010100",lat:39.9042,lng:116.4074,weekStart:1,showSchool:0,winW:0,winH:0,winX:0,winY:0,geoDone:0,manualCity:0};
var lastWeather=null, lastFetchTs=0, weatherFailed=false, weatherRetry=0;
/* 最近一次成功取得的官方(sojson)天气类型，例如"多云"。
   sojson 偶发失败时继续沿用，不回退到 wttr.in 测站的天气代码。 */
var lastOfficialType="";
/* 天气网官方(weather.com.cn)当日预报：d1.weather.com.cn/dingzhi 接口，
   与 weather.com.cn 官网同源同口径（sojson 虽同为气象局数据，但预报类型
   与官网页面存在"小雨/多云"这类口径差异，用户以官网为准）。null=尚未取得。 */
var officialWx=null;
var officialLive=null;   /* weather1d 页面实况（observe24h_data：温度/湿度/风向/风力/AQI） */
var renderedYMD=null;
var lastTodayKey=0;   /* 上一次心跳看到的"今天"（YYYYMMDD），用于跨天检测 */
var posterKey=null, posterDetail=false, posterBusy=0;

function isToday(y,m,d){
  var n=new Date();
  return n.getFullYear()==y && n.getMonth()+1==m && n.getDate()==d;
}
function todayKeyOf(dt){
  return dt.getFullYear()*10000+(dt.getMonth()+1)*100+dt.getDate();
}
/* dt 是否等于 key 那天（key 形如 20261014） */
function isKeyOf(key, dt){
  return !!dt && todayKeyOf(dt)===key;
}
function fsoObj(){ try{ return new ActiveXObject("Scripting.FileSystemObject"); }catch(e){ return null; } }
function appFolder(){
  try{ return fsoObj().GetParentFolderName(location.pathname.replace(/\//g,"\\")); }catch(e){ return ""; }
}
function parseCfgText(s){
  var c={}, m;
  m=/"city"\s*:\s*"([^"]*)"/.exec(s);       if(m) c.city=ascUnescape(m[1]);
  m=/"lat"\s*:\s*(-?[0-9.]+)/.exec(s);      if(m) c.lat=parseFloat(m[1]);
  m=/"lng"\s*:\s*(-?[0-9.]+)/.exec(s);      if(m) c.lng=parseFloat(m[1]);
  m=/"code"\s*:\s*"([^"]*)"/.exec(s);       if(m) c.code=m[1];
  m=/"weekStart"\s*:\s*([01])/.exec(s);     if(m) c.weekStart=parseInt(m[1],10);
  m=/"showSchool"\s*:\s*([01])/.exec(s);   if(m) c.showSchool=parseInt(m[1],10);
  m=/"winW"\s*:\s*(\d+)/.exec(s);          if(m) c.winW=parseInt(m[1],10);
  m=/"winH"\s*:\s*(\d+)/.exec(s);          if(m) c.winH=parseInt(m[1],10);
  /* 位置可能为负（多显示器时副屏在主屏左侧） */
  m=/"winX"\s*:\s*(-?\d+)/.exec(s);        if(m) c.winX=parseInt(m[1],10);
  m=/"winY"\s*:\s*(-?\d+)/.exec(s);        if(m) c.winY=parseInt(m[1],10);
  m=/"geoDone"\s*:\s*([01])/.exec(s);      if(m) c.geoDone=parseInt(m[1],10);
  m=/"manualCity"\s*:\s*([01])/.exec(s);   if(m) c.manualCity=parseInt(m[1],10);
  /* 和风 API Key（32 位十六进制字符串，正则允许任意非引号字符） */
  m=/"qweatherKey"\s*:\s*"([^"]*)"/.exec(s); if(m) c.qweatherKey=m[1];
  if(isNaN(c.lat)||isNaN(c.lng)) return null;
  return c;
}
function codeToCity(code){
  for(var k in cityMap){
    if(cityMap[k].code==code) return {city:k, code:code, lat:cityMap[k].lat, lng:cityMap[k].lng};
  }
  return null;
}
function loadCfg(){
  var folder=appFolder();
  if(!folder) return;
  try{
    var fso=fsoObj(), p=folder+"\\huangli_cfg.json";
    if(!fso.FileExists(p)) return;
    var f=fso.OpenTextFile(p,1);
    var s=f.ReadAll(); f.Close();
    var c=parseCfgText(s);
    if(!c) return;
    /* [DEBUG] cfg 原始字段 */
    _log("[loadCfg] raw cfg keys: "+Object.keys(c).join(",")+" qweatherKey="+JSON.stringify(c.qweatherKey));
    /* 每周起始日（0=周日, 1=周一）与城市无关，需在下面重建 c 之后回填 */
    var ws=(c.weekStart===0)?0:1;
    var shRaw=c.showSchool;   /* 可能为 undefined（老配置没有该字段） */
    /* 窗口尺寸同理：必须在下面 c 被整体替换之前先取出来 */
    var winW=(typeof c.winW==="number" && c.winW>0)?c.winW:0;
    var winH=(typeof c.winH==="number" && c.winH>0)?c.winH:0;
    var winX=(typeof c.winX==="number")?c.winX:0;
    var winY=(typeof c.winY==="number")?c.winY:0;
    /* 是否已完成过一次自动定位（1=不再每次启动联网查询） */
    var geo=(c.geoDone===1)?1:0;
    /* 是否手动选过城市（1=启动不再自动定位，避免覆盖用户明确选择） */
    var mc=(c.manualCity===1)?1:0;
    /* 以城市编码为准，保证城市名/经纬度/天气编码三者始终一致。
       注意此分支会整体替换 c，只保留 {city,code,lat,lng}，
       因此其余字段必须在替换前取出、替换后回填。 */
    var _qwKey=c.qweatherKey; /* [FIX] 替换 c 之前先存下和风 key */
    if(c.code){
      var byCode=codeToCity(c.code);
      /* 老版本可能存过区级城市（已从 cityMap 移除），
         保留其 code+坐标，让 weather.com.cn 继续用区级编码 */
      if(c.city && cityMap[c.city] && cityMap[c.city].code==c.code){
        c={city:c.city, code:c.code, lat:cityMap[c.city].lat, lng:cityMap[c.city].lng};
      }else if(byCode){
        c=byCode;
      }else{
        c={city:(c.city||"北京"), code:c.code, lat:c.lat, lng:c.lng};
      }
    }else if(c.city && cityMap[c.city]){
      c={city:c.city, code:cityMap[c.city].code, lat:cityMap[c.city].lat, lng:cityMap[c.city].lng};
    }else if(c.city && !isNaN(c.lat) && !isNaN(c.lng)){
      /* 临时城市（自动定位到的非 cityMap 城市，code 为空）：
         保留真实地名+坐标，和风按坐标直查天气 */
      c={city:c.city, code:"", lat:c.lat, lng:c.lng};
    }else{
      return; /* 配置损坏，回到默认城市 */
    }
    cfg=c;
    cfg.weekStart=ws;
    /* 老配置缺该字段时：城市有校历数据（含区级归属）则默认开启，否则关闭 */
    cfg.showSchool=(shRaw===undefined)?(schoolSeedOf(cfg.city)?1:0):(shRaw===1?1:0);
    /* 上次退出时的窗口大小与位置；0 表示从未调整过，启动时用设计基准 */
    cfg.winW=winW;
    cfg.winH=winH;
    cfg.winX=winX;
    cfg.winY=winY;
    cfg.geoDone=geo;
    cfg.manualCity=mc;
    /* 和风天气 API Key：从 cfg 读，避免硬编码进源码（cfg 已 gitignore） */
    /* [FIX] _qwKey 是替换 c 之前存的；c.qweatherKey 在被替换后已丢失 */
    if(typeof _qwKey==="string" && _qwKey){ cfg.qweatherKey=_qwKey; QWEATHER_KEY=_qwKey; }
    else if(typeof c.qweatherKey==="string"){ cfg.qweatherKey=c.qweatherKey; QWEATHER_KEY=c.qweatherKey; }
    _log("[loadCfg] AFTER fill: cfg.qweatherKey="+JSON.stringify(cfg.qweatherKey)+" QWEATHER_KEY.length="+QWEATHER_KEY.length);
  }catch(e){ _log("[loadCfg] EXCEPTION: "+e.message); }
}
function saveCfg(){
  var folder=appFolder();
  if(!folder) return;
  try{
    var fso=fsoObj();
    /* 只写 ASCII（城市编码+经纬度），彻底避开系统代码页的中文编码问题 */
    var f=fso.CreateTextFile(folder+"\\huangli_cfg.json",true);
    var win=(cfg.winW>0 && cfg.winH>0)?(',"winW":'+cfg.winW+',"winH":'+cfg.winH+',"winX":'+cfg.winX+',"winY":'+cfg.winY):"";
    win+=',"geoDone":'+(cfg.geoDone===1?1:0)+',"manualCity":'+(cfg.manualCity===1?1:0);
    if(cfg.qweatherKey) win+=',"qweatherKey":"'+cfg.qweatherKey+'"';
    f.Write('{"city":"'+ascEscape(cfg.city)+'","code":"'+cfg.code+'","lat":'+cfg.lat+',"lng":'+cfg.lng+',"weekStart":'+(cfg.weekStart===0?0:1)+',"showSchool":'+(cfg.showSchool===1?1:0)+win+'}\r\n');
    f.Close();
  }catch(e){}
}

/* ============================================================
   节日 / 节气 大图海报
   ============================================================ */
function posterGrad(name){
  if(/雪|寒|冬|霜/.test(name)) return ["#16305c","#93b7dd"];
  if(/秋|露|分|处暑/.test(name)) return ["#7d4310","#e2b25c"];
  if(/春|花|清|植|七|情/.test(name)) return ["#7a1f43","#e8a3b6"];
  if(/夏|暑|火|龙|端|劳/.test(name)) return ["#7d1d14","#e07c3c"];
  if(/雪/.test(name)) return ["#16305c","#93b7dd"];
  return ["#8e1b12","#e0b155"];
}
function posterSafe(name){ return String(name).replace(/[\\\/:*?"<>|]/g,""); }
/* 配图来源解析：依次尝试 jpg / jpeg / png / gif / bmp */
var POSTER_EXT=["jpg","jpeg","png","gif","bmp"];
function posterImgDir(){ var f=appFolder(); return f? f+"\\images" : ""; }
function posterRelOf(name,ext){
  var d=posterImgDir();
  if(!d) return "";
  return "images/"+posterSafe(name)+"."+ext;
}
function posterAbsOf(name,ext){
  var d=posterImgDir();
  if(!d) return "";
  return d+"\\"+posterSafe(name)+"."+ext;
}
/* 找出该节日实际存在的本地图片扩展名；没有则返回空 */
function posterLocalExt(name){
  var i, p;
  try{ var fso=fsoObj(); if(!fso) return ""; }catch(e){ return ""; }
  for(i=0;i<POSTER_EXT.length;i++){
    p=posterAbsOf(name,POSTER_EXT[i]);
    if(p && fso.FileExists(p)) return POSTER_EXT[i];
  }
  return "";
}
function posterRel(name){ return "images/"+posterSafe(name)+".jpg"; }
function posterAbs(name){
  var folder=appFolder();
  if(!folder) return "";
  return folder+"\\images\\"+posterSafe(name)+".jpg";
}
function posterHave(name){ return !!posterLocalExt(name); }
/* pic 字段的含义：
   空        -> 用节日名搜索（默认）
   http 开头 -> 直接当图片网址使用，不搜索
   其它文字  -> 先当本地图片文件名(同名.图片)找，找不到就用它当搜索关键词 */
function posterPicKind(pic){
  var p=String(pic||"").replace(/^\s+|\s+$/g,"");
  if(!p) return {kind:"auto",val:""};
  if(/^https?:\/\//i.test(p)) return {kind:"url",val:p};
  return {kind:"kw",val:p};
}
function xhrGet(url,onDone,isImg){
  var xhr=null, finished=false;
  try{ xhr=regXhr(new ActiveXObject("MSXML2.ServerXMLHTTP.6.0")); }catch(e){ xhr=null; }
  if(!xhr){ onDone(false,null); return; }
  function finish(ok,data){ if(finished) return; finished=true; try{ onDone(ok,data); }catch(e2){} }
  try{
    try{ xhr.setTimeouts(40000,10000,10000,30000); }catch(e6){}
    xhr.open("GET",url,true);
    try{ xhr.setRequestHeader("User-Agent","Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1)"); }catch(e2){}
    if(isImg){
      try{ xhr.setRequestHeader("Accept","image/jpeg,image/png,*/*"); }catch(e7){}
      try{ xhr.setRequestHeader("Referer", /bing\.com/i.test(url)?"http://cn.bing.com/":"http://image.baidu.com/"); }catch(e8){}
    }
    xhr.onreadystatechange=function(){
      if(xhr.readyState==4){
        if(xhr.status==200){
          var body=null, text=null;
          try{ body=xhr.responseBody; }catch(e9){}
          try{ text=xhr.responseText; }catch(e10){}
          finish(true,{text:text, body:body});
        }else{ finish(false,null); }
      }
    };
    xhr.send(null);
  }catch(e){ finish(false,null); }
}
function isImgUrl(u){
  if(/\.(jpg|jpeg|png|gif|bmp|webp)(\?|$)/i.test(u)) return true;
  if(/\/it\/u=/.test(u)) return true;
  if(/\/thumb|\/bdimg|\/pic|\/image/i.test(u)) return true;
  return false;
}
function baiduImages(name,onList){
  var url="http://image.baidu.com/search/acjson?tn=resultjson_com&ipn=rj&ct=201326592&word="
        +encodeURIComponent(name)+"&pn=0&rn=12";
  xhrGet(url,function(ok,data){
    if(!ok||!data||!data.text){ onList([]); return; }
    var t=data.text, pairs=[], re=/"(objURL|middleURL|thumbURL|fromURLMiddle)"\s*:\s*"(https?:\/\/[^"]+)"/g, m;
    while((m=re.exec(t))){ pairs.push({k:m[1],u:m[2]}); }
    var order=["middleURL","objURL","fromURLMiddle","thumbURL"], out=[], oi, p;
    for(oi=0;oi<order.length;oi++){
      for(p=0;p<pairs.length;p++){
        if(pairs[p].k!==order[oi]) continue;
        var u=pairs[p].u;
        if(!isImgUrl(u)) continue;
        if(/logo|icon|qrcode/i.test(u)) continue;
        if(out.join("|").indexOf(u)>=0) continue;
        out.push(u);
        if(out.length>=8) break;
      }
      if(out.length>=8) break;
    }
    onList(out);
  });
}
function bingImages(name,onList){
  var url="http://cn.bing.com/search?q="+encodeURIComponent(name)+"&form=HDRSC2&first=1";
  xhrGet(url,function(ok,data){
    if(!ok||!data||!data.text){ onList([]); return; }
    var t=data.text, out=[], re=/"murl"\s*:\s*"(https?:\/\/[^"]+\.(?:jpg|jpeg|png))"/gi, m;
    while((m=re.exec(t)) && out.length<8){
      if(out.join("|").indexOf(m[1])>=0) continue;
      out.push(m[1]);
    }
    onList(out);
  });
}
var posterUrlMap=null;
function posterCacheFile(){ var f=appFolder(); return f? f+"\\images\\poster_urls.txt" : ""; }
function loadPosterUrls(){
  posterUrlMap={};
  var p=posterCacheFile();
  if(!p) return;
  try{
    var fso=fsoObj();
    if(fso.FileExists(p)){
      var f=fso.OpenTextFile(p,1), s=f.ReadAll(); f.Close();
      var lines=s.split("\n"), i, k;
      for(i=0;i<lines.length;i++){
        k=lines[i].split("\t");
        if(k.length>1){
          var nm=k[0].replace(/^\s+|\s+$/g,""), ur=k[1].replace(/^\s+|\s+$/g,"");
          if(nm&&ur) posterUrlMap[nm]=ur;
        }
      }
    }
  }catch(e){}
}
function savePosterUrl(name,url){
  if(!posterUrlMap) loadPosterUrls();
  if(posterUrlMap[name]) return;
  posterUrlMap[name]=url;
  var p=posterCacheFile();
  if(!p) return;
  try{
    var fso=fsoObj(), dir=appFolder()+"\\images";
    if(!fso.FolderExists(dir)) fso.CreateFolder(dir);
    var f=fso.CreateTextFile(p,true);
    f.Write(name+"\t"+url+"\r\n");
    f.Close();
  }catch(e){}
}
function posterSetSrc(url,name){
  var img=document.getElementById("posterImg");
  if(!img) return;
  img.style.display="block";
  try{ img.setAttribute("data-name",name||""); }catch(e){}
  img.src=url;
}
/* 异步回调可能晚于用户切换：名字已变就丢弃结果，避免旧图覆盖新图 */
function posterIsCurrent(name){
  return posterKey===name;
}
/* 切换节日时立刻抹掉上一张图，灰底占位，不让旧图滞留 */
function posterClearIfChanged(name){
  var img=document.getElementById("posterImg");
  if(!img) return;
  var cur="";
  try{ cur=img.getAttribute("data-name")||""; }catch(e){}
  if(cur===name) return;
  try{ img.onerror=null; img.onload=null; }catch(e1){}
  /* removeAttribute 与 src="" 都做一遍，确保旧图真的从渲染中撤掉 */
  try{ img.removeAttribute("src"); }catch(e2){}
  try{ img.src=""; }catch(e3){}
  img.style.display="none";
  try{ img.setAttribute("data-name",name||""); }catch(e3){}
}
function posterEnsureImage(name,pic){
  if(!name) return;
  posterClearIfChanged(name);
  /* 1) 本地图片优先：节日名 或 pic 指定的文件名 */
  var ext=posterLocalExt(name);
  if(ext){ posterSetSrc(posterRelOf(name,ext),name); return; }
  var pk=posterPicKind(pic);
  if(pk.kind==="kw" && pk.val){
    var e2=posterLocalExt(pk.val);
    if(e2){ posterSetSrc(posterRelOf(pk.val,e2),name); return; }
  }
  /* 2) pic 直接给了图片网址 -> 不搜索 */
  if(pk.kind==="url"){ posterSetSrc(pk.val,name); return; }
  /* 3) 已缓存的搜索结果 */
  if(!posterUrlMap) loadPosterUrls();
  var cacheKey=posterSafe(pk.kind==="kw"?pk.val:name);
  if(posterUrlMap[cacheKey]){ posterSetSrc(posterUrlMap[cacheKey],name); return; }
  if(posterBusy) return;            /* 正在下载其它节日，本次放弃 */
  /* 4) 联网搜索，关键词优先用 pic */
  var kw=(pk.kind==="kw"&&pk.val)?pk.val:name;
  posterBusy=1;
  defer(function(){
    baiduImages(kw,function(list){
      posterBusy=0;
      if(!posterIsCurrent(name)) return;
      if(list.length){ posterPick(name,cacheKey,list,0); return; }
      bingImages(kw,function(l2){
        posterBusy=0;
        if(posterIsCurrent(name) && l2.length) posterPick(name,cacheKey,l2,0);
      });
    });
  }, 500);
}
function posterPick(name,cacheKey,list,i){
  if(i>=list.length) return;
  if(!posterIsCurrent(name)) return;
  var img=document.getElementById("posterImg");
  if(!img) return;
  var url=list[i];
  img.onerror=function(){ if(posterIsCurrent(name)) posterPick(name,cacheKey,list,i+1); };
  img.onload=function(){ img.onerror=null; };
  img.style.display="block";
  try{ img.setAttribute("data-name",name); }catch(e){}
  img.src=url;
  if(i===0) savePosterUrl(cacheKey,url);
}
function updatePoster(y,m,d,lunar){
  var p=document.getElementById("poster");
  if(!p) return;
  if(inMonthView){ p.style.display="none"; return; }
  if(posterKey && !posterDetail){
    var g=posterGrad(posterKey);
    try{
      document.getElementById("pgStop1").setAttribute("stop-color",g[0]);
      document.getElementById("pgStop2").setAttribute("stop-color",g[1]);
    }catch(e){}
    document.getElementById("posterName").innerHTML=posterKey;
    document.getElementById("posterDate").innerHTML=y+"年"+m+"月"+d+"日 · 农历"
      +(lunar.isLeap?"闰":"")+monthName(lunar.month)+cDay(lunar.day);
    p.style.display="block";
    document.getElementById("dayView").style.display="none";
    posterEnsureImage(posterKey,posterPicOf(posterKey));
  }else{
    p.style.display="none";
    document.getElementById("dayView").style.display="table";
    posterClearIfChanged("");   /* 非节日日期：抹掉残留海报，避免下次进入时闪现旧图 */
  }
}
function bindPoster(){
  document.getElementById("poster").onclick=function(){
    posterDetail=true;
    var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
    updatePoster(y,m,d,toLunar(y,m,d));
  };
  document.getElementById("festLine").onclick=function(){
    var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
    var lu=toLunar(y,m,d);
    /* 弹窗：当天有自定义节日时再次滚动显示 */
    var mf=myFind(y,m,d,lu), i, wt=[];
    for(i=0;i<mf.length;i++){ if(mf[i].text) wt.push(mf[i].name+"　"+mf[i].text); }
    if(wt.length){ showMarquee(escHtml(wt.join("　　")), renderedYMD+"|"+mf[0].name); }
    /* 只要有海报就显示——banner 只有在海报关闭后才可见（posterDetail=true），
       所以这里无条件把 posterDetail 复位为 false 再调 updatePoster 即可 */
    if(posterKey){
      posterDetail=false;
      updatePoster(y,m,d,lu);
    }
  };
}

function renderDay(){
  var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
  renderedYMD=y*10000+m*100+d;
  var lunar=toLunar(y,m,d);
  var p=pillars(y,m,d);
  var term=termIdxOfDay(y,m,d);
  var f=festivals(y,m,d,lunar,term);
  var dow=cur.getDay();
  var dayClass="dayNormal";
  if(f.length>0) dayClass="dayFest";
  else if(dow==0||dow==6) dayClass="dayWeekend";
  document.getElementById("sYearMonth").innerHTML=y+"年"+m+"月　星期"+"日一二三四五六".charAt(dow);
  var sd=document.getElementById("sDay");
  sd.className="bigday "+dayClass;
  sd.innerHTML=d;
  document.getElementById("lunarLine").innerHTML="农历 "+(lunar.isLeap?"闰":"")+monthName(lunar.month)+cDay(lunar.day);
  document.getElementById("gzLine").innerHTML=p.yGan+p.yZhi+"("+p.yAnimal+")年　"+p.mGan+p.mZhi+"月　"+p.dGan+p.dZhi+"日";
  var banner="&nbsp;";
  var newKey = posterPickName(f);
  /* 只有节日真的换了才复位 posterDetail，
     否则后台天气回来触发 renderDay 会让海报自己乱跳出来 */
  if(newKey !== posterKey){ posterDetail = false; }
  posterKey = newKey;
  if(f.length){
    banner="今日 "+f.join("　");
    if(posterKey) banner+="<span class='more'>▸ 查看大图</span>";
  }
  document.getElementById("festLine").className=(f.length&&posterKey)?"banner has":"banner";
  /* 没有节日时不保留空行，否则会白占约 23px，让「干支↔宜忌」之间出现空洞 */
  document.getElementById("festLine").style.display=(f.length)?"block":"none";
  document.getElementById("festLine").innerHTML=banner;
  var off=(p.dBranchIdx-p.mBranchIdx+12)%12;
  document.getElementById("yiList").innerHTML=OfficerYi[off].join("　");
  document.getElementById("jiList").innerHTML=OfficerJi[off].join("　");
  var chongB=(p.dBranchIdx+6)%12;
  document.getElementById("chongLine").innerHTML="<b>冲"+Animals[chongB]+"</b>("+Zhi[chongB]+")　"+shaOf(p.dBranchIdx)+"　·　值神："+Officer[off]+"日";
  var mp=moonPhase(lunar.day);
  document.getElementById("moonLine").innerHTML=mp[0]+"月相 "+mp[1];
  renderWeatherLine(y,m,d);
  var sv=sunTime(y,m,d,cfg.lat,cfg.lng,true), ss=sunTime(y,m,d,cfg.lat,cfg.lng,false);
  var sunEl=document.getElementById("sunLine");
  sunEl.innerHTML=ICON_SRISE+"日出 "+sv+"　"+ICON_SSET+"日落 "+ss;
  sunEl.title="按城市坐标 "+cfg.lat.toFixed(2)+"°N, "+cfg.lng.toFixed(2)+"°E 天文计算（NOAA 算法），与官方数据相差不超过 1~2 分钟；不同网站因取用观测点不同可能有几分钟出入。";
  updatePoster(y,m,d,lunar);
  /* 自定义节日滚动大字（每天只弹一次；点击可提前关闭） */
  var mf=myFind(y,m,d,lunar);
  if(mf.length){
    var withText=[], i;
    for(i=0;i<mf.length;i++){ if(mf[i].text) withText.push(mf[i].name+"　"+mf[i].text); }
    var mk=renderedYMD+"|"+mf[0].name;
    if(withText.length && toastKey!==mk){
      defer(function(){ showMarquee(escHtml(withText.join("　　")), mk); }, 260);
    }
  }
}
function escHtml(s){
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}
/* 调试日志：追加写 qw_debug.log，超过 256KB 截断重写，避免无限增长 */
function _log(s){
  try{
    var folder=appFolder(); if(!folder) return;
    var fso=fsoObj(); if(!fso) return;
    var p=folder+"\\qw_debug.log";
    if(fso.FileExists(p) && fso.GetFile(p).Size>262144) fso.DeleteFile(p);
    var t=new Date();
    var ts=t.getFullYear()+"-"+("0"+(t.getMonth()+1)).slice(-2)+"-"+("0"+t.getDate()).slice(-2)
      +" "+("0"+t.getHours()).slice(-2)+":"+("0"+t.getMinutes()).slice(-2)+":"+("0"+t.getSeconds()).slice(-2);
    var f=fso.OpenTextFile(p,8,true); /* 8=ForAppending */
    f.Write("["+ts+"] "+s+"\r\n");
    f.Close();
  }catch(e){}
}

function renderWeatherLine(y,m,d){
  var el=document.getElementById("weatherLine");
  var idx=currentForecastIndex();
  var fc=(idx>=0&&lastWeather&&lastWeather.forecast)?lastWeather.forecast[idx]:null;
  /* 只要显示的是"今天"才允许用实况数据。
     sojson 一次返回 15 天预报，而 wttr.in 的 current_condition 只是此刻的实况；
     翻到明天/后天时若仍拿实况温度、湿度、风速、AQI 来配那一天的预报，
     就会出现"明天的页面显示今天的实况温度"这类串日错误。 */
  var today=(function(){
    var n=new Date();
    return (n.getFullYear()==y && (n.getMonth()+1)==m && n.getDate()==d);
  })();
  /* 实况：天气网官方(主站 hour3data)优先，wttr.in 兜底 */
  var lv=today?officialLiveMerged(live):null;
  /* 记住最近一次成功取得的官方天气类型。
     官方源(sojson)偶发超时/限流时，若回退到 wttr.in 自有测站的天气代码，
     会把"Patchy light rain(293)"这类局部阵雨显示成全市"小雨"，与市区实况不符。
     因此官方类型一经取得便一直沿用，不因单次请求失败而退化。 */
  if(fc&&fc.type) lastOfficialType=fc.type;
  var cmaType=lastOfficialType;
  if(cmaType||lv){
    /* 今日主类型/高低温：天气网官方(weather.com.cn weather_index)优先，sojson 兜底。
       官方源与官网/APP 同口径（如"晴转多云"），sojson 的当天类型偶有"小雨/多云"口径差。
       翻到明天/后天时同样取官方对应日期的预报类型。 */
    var off=(idx===0)?officialWx:null;
    var offToday=off&&off.today?off.today:null;
    var offFc0=(off&&off.fc&&off.fc.length)?off.fc[0]:null;
    var offFcIdx=(idx>0&&officialWx&&officialWx.fc&&idx<officialWx.fc.length)?officialWx.fc[idx]:null;
    /* 官方今日类型：主站页面的 fc[0].type（weather 字段兼容历史结构） */
    var mainType=offFcIdx?(offFcIdx.type||cmaType):(offToday?(offToday.weather||offToday.type||cmaType):cmaType);
    /* 天气状况以官方源为准：wttr.in 用的是自有测站，偶发"附近有雨"就报毛毛雨，
       与国内官方口径不符。数值(温度/体感/风/气压/能见度)取官方实况，wttr 兜底。 */
    var wrType=(lv&&lv.type)?lv.type:"";
    var type=mainType||wrType;
    var iconT=type||"阴";
    /* 温度来历：有实况用实况温度，否则退回当日官方/气象局高低温 */
    var main="";
    if(lv&&lv.temp!=="") main=lv.temp+"°"+((lv.feels!=="")?(" 体感"+lv.feels+"°"):"");
    else if(offFcIdx&&offFcIdx.high) main=offFcIdx.high+"~"+offFcIdx.low+"°";
    else if(offFc0&&offFc0.high) main=offFc0.high+"~"+offFc0.low+"°";
    else if(offToday&&offToday.temp) main=offToday.temp.replace("℃","")+"~"+offToday.tempn.replace("℃","")+"°";
    else if(fc) main=fc.low+"~"+fc.high+"°";
    /* 紫外线：小时级优先（wttr 当前小时 uvIndex，官方无小时级数据）；
       夜间自动为 0 显示"弱"；wttr 不可用时回落官方当日等级 + 昼夜区分。
       官方 uv.level 是数值指数(字符串"3")，uv.category 是等级名("中等")。 */
    if(today && lv){
      var uvTxt="";
      if(lv.uvHour && lv.uvHour.idx!==null && lv.uvHour.idx>=0){
        var uvLvl=uvLevel(lv.uvHour.idx);
        uvTxt=" 紫外线"+(lv.uvHour.idx>0?(lv.uvHour.idx+" "+uvLvl):"弱");
      }else if(lv.uv && lv.uv.level){
        uvTxt=" 紫外线"+(isDaytime()?(lv.uv.level+(lv.uv.category?(" "+lv.uv.category):"")):"弱");
      }
      if(uvTxt) main+=uvTxt;
    }
    var tip=[];
    if(offFcIdx&&offFcIdx.high) tip.push("天气网官方 "+offFcIdx.type+" "+offFcIdx.high+"~"+offFcIdx.low+"°");
    else if(offToday) tip.push("天气网官方 "+offToday.weather+(offFc0&&offFc0.high?(" "+offFc0.high+"~"+offFc0.low+"°"):""));
    else if(lastOfficialType) tip.push("气象局 "+cmaType+(fc?(" "+fc.low+"~"+fc.high+"°"):""));
    else if(wrType) tip.push("天气来自 wttr.in 测站（官方源暂不可用）："+wrType);
    if(lv){ tip.push("实况 "+lv.temp+"°"); if(lv.pres) tip.push("气压 "+lv.pres+"hPa"); if(lv.vis) tip.push("能见度 "+lv.vis+"km"); if(lv.wind) tip.push(lv.wind+" "+(lv.windLv||(lv.windKmh+"km/h"))); }
    if(today && lv){
      if(lv.uvHour && lv.uvHour.idx!==null && lv.uvHour.idx>=0){
        var uvLvl2=uvLevel(lv.uvHour.idx);
        if(lv.uvHour.idx>0) tip.push("当前小时紫外线指数 "+lv.uvHour.idx+"（"+uvLvl2+"，wttr 小时预报）"+(lv.uv&&lv.uv.level?("；今日白天官方指数："+lv.uv.level+(lv.uv.category?("（"+lv.uv.category+"）"):"")+(lv.uv.desc?("："+lv.uv.desc):"")):""));
        else tip.push("当前为夜间，紫外线弱（wttr 小时值 0）"+(lv.uv&&lv.uv.level?("；今日白天官方指数："+lv.uv.level+(lv.uv.category?("（"+lv.uv.category+"）"):"")):""));
      }else if(lv.uv && lv.uv.level){
        tip.push(isDaytime()?("紫外线指数 "+lv.uv.level+(lv.uv.desc?("："+lv.uv.desc):"")):("当前为夜间，紫外线弱；今日白天官方等级："+lv.uv.level+(lv.uv.desc?("（"+lv.uv.desc+"）"):"")));
      }
    }
    /* 仅当官方实况不可用（lv 确实来自 wttr.in）时，才提示与气象局口径的差异 */
    if(!(officialWx&&officialWx.live) && !officialLive && cmaType&&wrType&&cmaType!==wrType) tip.push("wttr.in 测站为"+wrType+"（"+(lv&&lv.desc?lv.desc:"")+"），与气象局口径可能有差异");
    var tpTxt=typhoonText();
    if(tpTxt) tip.push("⚠ 台风： "+tpTxt+(TYPHOON_AT?"（"+TYPHOON_AT+" 更新）":""));
    if(liveAt) tip.push("更新 "+liveAt);
    /* 台风预警单独走 #tyLine，天气实况永远保留在本行，
       不再用台风信息覆盖掉"小雪 / 29° / 体感"等天气内容 */
    var wtxt=weatherIcon(iconT)+cfg.city+" "+type+"　"+main;
    el.innerHTML=wtxt;
    el.title=tip.join(" · ");
    if(idx>=0) renderForecast5(idx);
    renderAirLine(today);
    renderTyphoonLine();
    renderAlerts();
    return;
  }
  if(weatherFailed){
    el.innerHTML=weatherIcon("☁")+cfg.city+" 天气获取失败（请检查网络）";
  }else{
    el.innerHTML=weatherIcon("☁")+cfg.city+" 天气获取中…";
  }
  var el5=document.getElementById("fc5");
  if(el5) el5.innerHTML="";
  var el6=document.getElementById("airLine");
  if(el6) el6.innerHTML="&nbsp;";
}
function weekLabelOf(ymd){
  var p=String(ymd).split("-");
  if(p.length<3) return "";
  var w=new Date(parseInt(p[0],10), parseInt(p[1],10)-1, parseInt(p[2],10)).getDay();
  return "周"+"日一二三四五六".charAt(w);
}
/* 五日预报的日期标签。
   必须按"该日期与真实今天相差几天"来生成，不能按它在数组中的位置：
   renderForecast5(idx) 的 idx 来自当前浏览的日期，翻页后 idx 不再是 0，
   若按位置写死 i==0→今天，翻到明天时就会把"明天"标成"今天"。 */
function dayLabelOf(ymd){
  var p=String(ymd).split("-");
  if(p.length<3) return "";
  var d=new Date(parseInt(p[0],10),parseInt(p[1],10)-1,parseInt(p[2],10));
  if(isNaN(d.getTime())) return "";
  var n=new Date();
  var t0=new Date(n.getFullYear(),n.getMonth(),n.getDate());
  /* 用 Math.round 抵消夏令时/时区造成的不足一天的误差 */
  var diff=Math.round((d-t0)/86400000);
  if(diff===0) return "今天";
  if(diff===1) return "明天";
  if(diff===2) return "后天";
  if(diff===-1) return "昨天";
  return "周"+"日一二三四五六".charAt(d.getDay());
}
function renderForecast5(idx){
  var el=document.getElementById("fc5");
  if(!el) return;
  var html="", i;
  /* 官方 7 天预报（weather_index 的 fc）优先：与天气网官网/APP 完全同口径 */
  if(officialWx && officialWx.fc && officialWx.fc.length && idx>=0 && idx<officialWx.fc.length){
    var n=officialWx.fc.length-idx; if(n>5) n=5;
    if(n<=0){ el.innerHTML=""; return; }
    var base=new Date();
    for(i=0;i<n;i++){
      var f=officialWx.fc[idx+i];
      /* 和风来源直接有 ymd；天气网来源只有 "M/D"，走 officialYmd 换算 */
      var ymd=f.ymd||officialYmd(base, f.md);
      var lbl=dayLabelOf(ymd);
      var ic=weatherIcon(f.type||f.day||"阴");
      /* 五日 AQI：和风 air daily 只给 3 天，剩余天数按 ymd 去 lastWeather.forecast 取，
         两者都是同一批组装的数据，aqi>=0 才显示 */
      var fAqi=-1;
      if(lastWeather&&lastWeather.forecast){
        for(var pi=0;pi<lastWeather.forecast.length;pi++){
          if(lastWeather.forecast[pi].ymd===ymd && lastWeather.forecast[pi].aqi>=0){ fAqi=lastWeather.forecast[pi].aqi; break; }
        }
      }
      var aAqi=aqiInfo(fAqi);
      var aqHtml=(aAqi)?"<span class='aqism' style='color:"+aAqi.c+";' title='当日预报AQI "+fAqi+" "+aAqi.n+"（非实时）'>"+fAqi+"</span>":"";
      html+="<div class='cell'><div class='d'>"+lbl+aqHtml+"</div><div class='ic'>"+ic+"</div><div class='t'>"+f.low+"~"+f.high+"°</div></div>";
    }
    el.innerHTML=html;
    return;
  }
  /* 官方不可用时回退 sojson 15 天预报 */
  if(!lastWeather||!lastWeather.forecast||idx<0||idx>=lastWeather.forecast.length){
    el.innerHTML=""; return;
  }
  var fc=lastWeather.forecast;
  var n=fc.length-idx; if(n>5) n=5;
  if(n<=0){ el.innerHTML=""; return; }
  for(i=0;i<n;i++){
    var f=fc[idx+i];
    if(!f) break;
    var lbl=dayLabelOf(f.ymd);
    var a=aqiInfo(f.aqi);
    var aqHtml=(a)?"<span class='aqism' style='color:"+a.c+";' title='当日预报AQI "+f.aqi+" "+a.n+"（非实时）'>"+f.aqi+"</span>":"";
    html+="<div class='cell'>"
        +"<div class='d'>"+lbl+aqHtml+"</div>"
        +"<div class='ic'>"+weatherIcon(f.type)+"</div>"
        +"<div class='t'>"+f.low+"~"+f.high+"°</div>"
        +"</div>";
  }
  el.innerHTML=html;
}
/* 官方 fc 的月/日（"10/17"，无年份）→ YYYY-MM-DD；跨年（如 12月→1月）自动加一年 */
function officialYmd(base, mdStr){
  var p=String(mdStr||"").split("/");
  if(p.length<2) return "";
  var mo=parseInt(p[0],10), da=parseInt(p[1],10);
  if(isNaN(mo)||isNaN(da)||mo<1||mo>12||da<1||da>31) return "";
  var y=base.getFullYear(), cm=base.getMonth()+1;
  if(mo<cm) y++;
  return y+"-"+("0"+mo).slice(-2)+"-"+("0"+da).slice(-2);
}

function defer(fn, ms){ try{ setTimeout(fn, ms||300); }catch(e){ try{ fn(); }catch(e2){} } }
function numOnly(s){ var m=/(-?[0-9]+(?:\.[0-9]+)?)/.exec(String(s)); return m?m[1]:""; }
function parseWeatherText(t){
  var res={wendu:"",shidu:"",pm25:"",pm10:"",quality:"",obsTime:"",aqi:-1,forecast:[]}, m, i;
  m=/"time"\s*:\s*"([^"]*)"/.exec(t);   if(m) res.obsTime=m[1];
  /* sojson 的 data 下并不存在实时 AQI。
     响应里所有 "aqi" 都属于 forecast[].aqi（当日预报值）或 yesterday.aqi；
     旧的 "sunset","aqi" 正则会命中 forecast[0].aqi，即把"今日预报 AQI"
     冒充成实时空气质量显示，同时压制了按 HJ633 用 PM2.5/PM10 换算的正确路径。
     因此这里不取，res.aqi 恒为 -1，实时空气质量统一走 calcRealtimeAQI()。 */
  m=/"wendu"\s*:\s*"([^"]*)"/.exec(t);   if(m) res.wendu=m[1];
  m=/"shidu"\s*:\s*"([^"]*)"/.exec(t);   if(m) res.shidu=m[1];
  m=/"pm25"\s*:\s*(-?[0-9.]+)/.exec(t);  if(m) res.pm25=m[1];
  m=/"pm10"\s*:\s*(-?[0-9.]+)/.exec(t);  if(m) res.pm10=m[1];
  m=/"quality"\s*:\s*"([^"]*)"/.exec(t); if(m) res.quality=m[1];
  var fm=/"forecast"\s*:\s*\[([\s\S]*?)\]\s*,\s*"yesterday"/.exec(t);
  if(!fm) fm=/"forecast"\s*:\s*\[([\s\S]*?)\]/.exec(t);
  if(fm){
    var chunks=fm[1].split("},{");
    for(i=0;i<chunks.length;i++){
      var c=chunks[i];
      var y=/"ymd"\s*:\s*"([^"]*)"/.exec(c);
      if(!y) continue;
      var ty=/"type"\s*:\s*"([^"]*)"/.exec(c);
      var lo=/"low"\s*:\s*"([^"]*)"/.exec(c);
      var hi=/"high"\s*:\s*"([^"]*)"/.exec(c);
      var aq=/"aqi"\s*:\s*(-?[0-9]+)/.exec(c);
      if(ty&&lo&&hi){
        res.forecast.push({ymd:y[1], type:ty[1], low:numOnly(lo[1]), high:numOnly(hi[1]),
                           aqi:aq?parseInt(aq[1],10):-1});
      }
    }
  }
  return res.forecast.length?res:null;
}
/* 国标 HJ 633-2012：IAQI 与污染物浓度分段对应，格式 [浓度上限, IAQI] */
var PM25_BP=[[0,0],[35,50],[75,100],[115,150],[150,200],[250,300],[350,400],[500,500]];
var PM10_BP =[[0,0],[50,50],[150,100],[250,150],[350,200],[420,300],[500,400],[600,500]];
function iaqiOf(c, bp){
  c=parseFloat(c);
  if(isNaN(c)||c<0) return -1;
  if(c>bp[bp.length-1][0]) c=bp[bp.length-1][0];
  for(var i=1;i<bp.length;i++){
    if(c<=bp[i][0]){
      return Math.round(bp[i-1][1]+(c-bp[i-1][0])/(bp[i][0]-bp[i-1][0])*(bp[i][1]-bp[i-1][1]));
    }
  }
  return bp[bp.length-1][1];
}
/* 实时 AQI：取 PM2.5 与 PM10 的较大 IAQI（国标取最大者） */
function calcRealtimeAQI(){
  if(!lastWeather) return -1;
  var a=iaqiOf(lastWeather.pm25,PM25_BP), b=iaqiOf(lastWeather.pm10,PM10_BP);
  if(a>b) return a;
  if(b>a) return b;
  return a;
}
/* 实况合并：天气网官方优先（weather1d 的 observe24h_data 提供温度/湿度/风向/风力/AQI，
   weather 页 hour3data 提供温度/天气/风向/风力），wttr.in 兜底体感/气压/能见度 */
function officialLiveMerged(wt){
  var o=officialWx&&officialWx.live?officialWx.live:null;
  var ol=officialLive?officialLive:null;
  var t=(ol&&ol.temp)||(o&&o.temp)||(wt?wt.temp:"");
  var ty=(o&&o.type)||(ol&&ol.type)||(wt?wt.type:"");
  var wd=(ol&&ol.wind)||(o&&o.wind)||(wt?wt.wind:"");
  var wl=(ol&&ol.windLv)||(o&&o.windLv)||"";
  return {
    temp:t, feels:(ol&&ol.feels)||(wt?wt.feels:""), hum:(ol&&ol.hum)||(wt?wt.hum:""),
    wind:wd, windKmh:(ol&&ol.windKmh)||(wt?wt.windKmh:""), windLv:wl,
    /* 气压/能见度优先取和风 now（ol），wttr 仅兜底 */
    pres:(ol&&ol.pres)||(wt?wt.pres:""), vis:(ol&&ol.vis)||(wt?wt.vis:""),
    type:ty, desc:wt?wt.desc:"",
    aqi:(ol&&ol.aqi>=0)?ol.aqi:((wt&&wt.aqi>=0)?wt.aqi:-1),
    uv:(ol&&ol.uv)?ol.uv:null,
    uvHour:wt?wt.uvHour:null
  };
}
function aqiInfo(v){
  if(v==null||isNaN(v)||v<0) return null;
  if(v<=50)  return {n:"优",c:"#1b5e20",bg:"#e8f5e9"};
  if(v<=100) return {n:"良",c:"#827717",bg:"#f9fbe7"};
  if(v<=150) return {n:"轻度污染",c:"#e65100",bg:"#fff3e0"};
  if(v<=200) return {n:"中度污染",c:"#c62828",bg:"#ffebee"};
  if(v<=300) return {n:"重度污染",c:"#6a1b9a",bg:"#f3e5f5"};
  return {n:"严重污染",c:"#7b1fa2",bg:"#ede7f6"};
}
function currentForecastIndex(){
  if(!lastWeather||!lastWeather.forecast) return -1;
  var y=cur.getFullYear(), m=cur.getMonth()+1, d=cur.getDate();
  var ds=y+"-"+(m<10?"0"+m:m)+"-"+(d<10?"0"+d:d);
  for(var i=0;i<lastWeather.forecast.length;i++){
    if(lastWeather.forecast[i].ymd==ds) return i;
  }
  return -1;
}
function renderAirLine(showLive){
  var el=document.getElementById("airLine");
  if(!el) return;
  var parts=[], tip=[];
  /* showLive=false 表示正在查看非今天的日期，
     此时不能用此刻的实况湿度/风/气压/AQI 去描述那一天，只能给出污染物等级。 */
  var lv=showLive?officialLiveMerged(live):null;
  if(lv){
    if(lv.hum!=="") parts.push("湿度 <b>"+lv.hum+"%</b>");
    if(lv.wind) parts.push(lv.wind+"风 "+(lv.windLv||((lv.windKmh||"")+"km/h")));
    /* 气压：中国气象局接口不提供，官方实况(weather_index)有则用之，否则取 wttr.in 实况（悬停里已注明来源） */
    if(lv.pres) parts.push("气压 <b>"+lv.pres+"</b>");
  }else if(lastWeather && lastWeather.shidu){
    parts.push("湿度 <b>"+lastWeather.shidu+"</b>");
  }
/* 空气质量：查看"今天"时给实时值。
   优先级：和风实时 AQI（坐标直查，区县精度，6 因子完整）→
           天气网官方 weather1d 实况 AQI（中央气象台，市级）→
           国标 HJ 633 用 PM2.5/PM10 换算（仅剩两项因子）。
   查看其它日期时只能给当日预报值（sojson 提供）。 */
if(showLive){
  var rt=-1, rtSrc="";
  if(lastWeather && lastWeather.aqi>=0){ rt=lastWeather.aqi; rtSrc="和风实时 AQI"; }
  else if(lv&&lv.aqi>=0){ rt=lv.aqi; rtSrc="天气网官方实时 AQI（中央气象台）"; }
  else{ rt=calcRealtimeAQI(); rtSrc="国标 HJ 633-2012 按 PM2.5/PM10 浓度换算"; }
  if(rt>=0){
    var a=aqiInfo(rt);
    if(a) parts.push("<span class='aqi' style='color:"+a.c+";background:"+a.bg+"'>空气 "+rt+" "+a.n+"</span>");
    tip.push("AQI 为 "+rtSrc+"；下方预报中数字为当日预报 AQI，与实时值可能不同");
    if(lastWeather.pm25) tip.push("PM2.5 "+lastWeather.pm25+" μg/m³");
    if(lastWeather.pm10) tip.push("PM10 "+lastWeather.pm10+" μg/m³");
    if(lastWeather.quality) tip.push("空气等级 "+lastWeather.quality);
    if(lastWeather.obsTime) tip.push("污染物观测 "+lastWeather.obsTime);
  }else{
    var idxR=currentForecastIndex();
    if(lastWeather&&lastWeather.forecast&&idxR>=0){
      var fR=lastWeather.forecast[idxR], aR=aqiInfo(fR.aqi);
      if(aR) parts.push("<span class='aqi' style='color:"+aR.c+";background:"+aR.bg+"'>日AQI "+fR.aqi+" "+aR.n+"</span>");
      tip.push("AQI 为当日预报值（非实时）");
    }
  }
}else{
  var idxD=currentForecastIndex();
  if(lastWeather&&lastWeather.forecast&&idxD>=0){
    var fD=lastWeather.forecast[idxD], aD=aqiInfo(fD.aqi);
    if(aD) parts.push("<span class='aqi' style='color:"+aD.c+";background:"+aD.bg+"'>日AQI "+fD.aqi+" "+aD.n+"</span>");
    tip.push("AQI 为当日预报值（非实时）");
  }
}
  if(lv&&lv.pres) tip.push("气压 "+lv.pres+" hPa");
  if(lv&&lv.vis) tip.push("能见度 "+lv.vis+" km");
  if(liveAt) tip.push("天气更新 "+liveAt);
  el.innerHTML=parts.length?parts.join("　"):"&nbsp;";
  el.title=tip.join(" · ");
}

function weatherRetryLater(){
  if(weatherRetry>=2) return;
  weatherRetry++;
  defer(function(){ fetchWeather(true); }, 2500);
}
/* 天气网官方天气代码 → 中文类型（weather.com.cn 的 fa/fb 代码表） */
var WCODE={"00":"晴","01":"多云","02":"阴","03":"阵雨","04":"雷阵雨","05":"雷阵雨伴冰雹","06":"雨夹雪","07":"小雨","08":"中雨","09":"大雨","10":"暴雨","11":"大暴雨","12":"特大暴雨","13":"阵雪","14":"小雪","15":"中雪","16":"大雪","17":"暴雪","18":"雾","19":"冻雨","20":"沙尘暴","21":"小到中雨","22":"中到大雨","23":"大到暴雨","24":"暴雨到大暴雨","25":"大暴雨到特大暴雨","26":"小到中雪","27":"中到大雪","28":"大到暴雪","29":"浮尘","30":"扬沙","31":"强沙尘暴","32":"霾","49":"强浓雾","53":"霾","99":"无"};
function wxCodeName(c){ return WCODE[String(c)]||""; }
/* 从返回文本中按名字取出 var name ={...}; 的 JSON 对象（正确处理字符串内的花括号） */
function jsonObjAt(t,start){
  var depth=0, inStr=false, esc=false, i;
  for(i=start;i<t.length;i++){
    var c=t.charAt(i);
    if(inStr){
      if(esc){ esc=false; }
      else if(c==="\\"){ esc=true; }
      else if(c==='"'){ inStr=false; }
    }else{
      if(c==='"'){ inStr=true; }
      else if(c==="{"){ depth++; }
      else if(c==="}"){ depth--; if(depth===0) return t.slice(start,i+1); }
    }
  }
  return null;
}
function grabOfficialObj(t,name){
  var i=String(t).indexOf("var "+name+" =");
  if(i<0) return null;
  var s=String(t).indexOf("{",i);
  if(s<0) return null;
  var j=jsonObjAt(String(t),s);
  if(!j) return null;
  try{ return JSON.parse(j); }catch(e){ return null; }
}
/* 解析 d1.weather.com.cn/weather_index 的返回（官方 7 天预报接口）：
   var cityDZ ={"weatherinfo":{...今日类型...}};
   var dataSK ={...实况: temp/weather/WD/WS/wse/SD/qy/njd/aqi...};
   var fc ={"f":[{fa白天码,fb夜间码,fc高温,fd低温,fi月/日,fj星期}...]};
   与 weather.com.cn 官网/APP 完全同源同口径。失败返回 null（上层回退 sojson/wttr）。 */
function parseOfficialWx(t){
  var dz=grabOfficialObj(t,"cityDZ"), sk=grabOfficialObj(t,"dataSK"), fc=grabOfficialObj(t,"fc");
  var wi=(dz&&dz.weatherinfo)?dz.weatherinfo:null;
  if(!wi && !sk && !fc) return null;
  var live=null;
  if(sk){
    var wd=String(sk.WD||"").replace(/\u98ce$/,"");   /* "东南风"→"东南" */
    live={
      temp:sk.temp||"", feels:"", hum:String(sk.SD||"").replace(/%/g,""),
      wind:wd, windKmh:(sk.wse||"").replace(/km\/h/g,"").replace(/\s/g,""),
      pres:sk.qy||"", vis:String(sk.njd||"").replace(/km/gi,""),
      type:String(sk.weather||""), desc:"", aqi:parseInt(sk.aqi,10)
    };
  }
  var list=null;
  if(fc && fc.f && fc.f.length){
    list=[];
    for(var i=0;i<fc.f.length;i++){
      var x=fc.f[i];
      var dn=wxCodeName(x.fa), nn=wxCodeName(x.fb);
      var tn="";
      if(dn&&nn&&dn!==nn) tn=dn+"\u8f6c"+nn;      /* 晴转多云 */
      else if(dn) tn=dn;
      else if(nn) tn=nn;
      list.push({high:x.fc||"", low:x.fd||"", type:tn, day:dn||nn});
    }
  }
  return {
    live:live,
    today:(wi&&wi.weather)?{weather:wi.weather,temp:wi.temp||"",tempn:wi.tempn||""}:null,
    fc:list
  };
}
/* 主站页面解析（https://www.weather.com.cn/weather/{code}.shtml，无需 Referer）：
   7 天预报 li.sky（顺序即日期）+ 实况 hour3data["1d"]（取最接近当前小时的条目）。
   返回结构与 parseOfficialWx 一致：{live,today,fc}。 */
function parseOfficialPage(t){
  if(!t || typeof t!=="string") return null;
  var r={live:null, today:null, fc:[]};
  var now=new Date(), baseY=now.getFullYear(), baseM=now.getMonth()+1, baseD=now.getDate();
  var re=/<li class="sky skyid[^"]*">[\s\S]*?<h1>\d+日（[^）]*）<\/h1>[\s\S]*?<big class="png40 (d\d+)"><\/big>[\s\S]*?<big class="png40 (n\d+)"><\/big>[\s\S]*?<p title="([^"]*)" class="wea">([^<]*)<\/p>[\s\S]*?<p class="tem">\s*<span>(\d+)<\/span>\/<i>(\d+)℃<\/i>/g;
  var m;
  while((m=re.exec(t))!==null){
    var dd=new Date(baseY, baseM-1, baseD + r.fc.length);
    var md=(dd.getMonth()+1)+"/"+dd.getDate();
    r.fc.push({md:md, type:m[4], day:m[3], night:m[4], high:m[5], low:m[6], dayCode:m[1], nightCode:m[2]});
  }
  if(!r.fc.length) return null;
  r.today={weather:r.fc[0].type, type:r.fc[0].type, high:r.fc[0].high, low:r.fc[0].low, md:r.fc[0].md};
  var arrRe=/"1d":\[([\s\S]*?)\]/m.exec(t);
  if(arrRe){
    var items=arrRe[1].match(/"([^"]*)"/g)||[];
    var curH=now.getHours(), best=null, bestGap=999, i, p;
    for(i=0;i<items.length;i++){
      var s=String(items[i]).replace(/^"|"$/g,"");
      p=s.split(",");
      if(p.length<3) continue;
      var tmh=/\u65e5(\d+)\u65f6/.exec(p[0]);
      if(!tmh) continue;
      var h=parseInt(tmh[1],10), gap=Math.abs(h-curH);
      if(gap<bestGap){ bestGap=gap; best={code:p[1], type:p[2], temp:String(p[3]).replace("\u2103",""), wind:p[4], windLv:p[5]}; }
    }
    if(best) r.live={temp:best.temp, feels:"", hum:"", wind:best.wind, windKmh:"", windLv:best.windLv, pres:"", vis:"", type:best.type, desc:"", aqi:-1};
  }
  return r;
}
/* 拉取天气网官方 7 天预报（主站页面 https，无需 Referer；实测 ServerXMLHTTP 可用） */
function fetchOfficialWx(){
  if(!cfg.code) return;
  var url="https://www.weather.com.cn/weather/"+cfg.code+".shtml?_="+new Date().getTime();
  var xhr=null;
  try{ xhr=regXhr(new ActiveXObject("MSXML2.ServerXMLHTTP.6.0")); }catch(e){
    try{ xhr=regXhr(new ActiveXObject("Msxml2.XMLHTTP.6.0")); }catch(e2){
      try{ xhr=regXhr(new XMLHttpRequest()); }catch(e3){ xhr=null; }
    }
  }
  if(!xhr) return;
  try{
    try{ xhr.setTimeouts(20000,20000,20000,20000); }catch(e5){}
    xhr.open("GET",url,true);
    try{ xhr.setRequestHeader("User-Agent","Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"); }catch(e4){}
    xhr.onreadystatechange=function(){
      if(xhr.readyState==4 && xhr.status==200){
        try{
          var w=parseOfficialPage(xhr.responseText);
          if(w) officialWx=w;
        }catch(ex){}
        if(!inMonthView) renderWeatherLine(cur.getFullYear(),cur.getMonth()+1,cur.getDate());
      }
    };
    xhr.send(null);
  }catch(e){}
}
/* 解析 weather1d 页面的实况（observe24h_data）：温度/湿度/风向/风力/AQI。
   数组顺序由新到旧（od21=小时, od22=温度, od24=风向, od25=风力, od27=湿度, od28=AQI）。 */
function parseOfficialLive(t){
  if(!t||typeof t!=="string") return null;
  var m=/var observe24h_data\s*=\s*(\{[\s\S]*?\});/m.exec(t);
  if(!m) return null;
  var d=null;
  try{ d=(new Function("return "+m[1]+";"))(); }catch(e){ return null; }
  var od=d&&d.od, arr=od&&od.od2;
  if(!arr||!arr.length) return null;
  var now=new Date(), curH=now.getHours(), best=null, bestGap=999;
  for(var i=0;i<arr.length;i++){
    var x=arr[i], h=parseInt(x.od21,10);
    if(isNaN(h)) continue;
    var gap=Math.abs(h-curH);
    if(gap<bestGap){ bestGap=gap; best=x; }
  }
  if(!best) return null;
  /* AQI：最新条目可能为空，向历史（数组由新到旧）回退找最近非空值 */
  var aqi=-1;
  for(var k=0;k<arr.length && k<10;k++){
    var v=parseInt(arr[k].od28,10);
    if(!isNaN(v)&&v>=0){ aqi=v; break; }
  }
  var wd=String(best.od24||"").replace(/\u98ce$/,"");
  /* 紫外线指数：生活指数区 li（<span>等级</span><em>紫外线指数</em><p>建议</p>） */
  var uv=null, uvRe=/<li class="li1[^"]*">\s*<i><\/i>\s*<span>([^<]*)<\/span>\s*<em>\u7d2b\u5916\u7ebf\u6307\u6570<\/em>\s*<p>([^<]*)<\/p>/m.exec(t);
  if(uvRe) uv={level:uvRe[1], desc:uvRe[2]};
  return {temp:best.od22||"", hum:best.od27||"", wind:wd, windLv:(best.od25?best.od25+"\u7ea7":""), aqi:aqi, type:"", uv:uv};
}
/* 拉取天气网"今天"页实况（weather1d，无需 Referer）：湿度/AQI/实时温度 */
function fetchOfficialLive(){
  if(!cfg.code) return;
  var url="https://www.weather.com.cn/weather1d/"+cfg.code+".shtml?_="+new Date().getTime();
  var xhr=null;
  try{ xhr=regXhr(new ActiveXObject("MSXML2.ServerXMLHTTP.6.0")); }catch(e){
    try{ xhr=regXhr(new ActiveXObject("Msxml2.XMLHTTP.6.0")); }catch(e2){
      try{ xhr=regXhr(new XMLHttpRequest()); }catch(e3){ xhr=null; }
    }
  }
  if(!xhr) return;
  try{
    try{ xhr.setTimeouts(20000,20000,20000,20000); }catch(e5){}
    xhr.open("GET",url,true);
    try{ xhr.setRequestHeader("User-Agent","Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"); }catch(e4){}
    xhr.onreadystatechange=function(){
      if(xhr.readyState==4 && xhr.status==200){
        try{
          var w=parseOfficialLive(xhr.responseText);
          if(w) officialLive=w;
        }catch(ex){}
        if(!inMonthView) renderWeatherLine(cur.getFullYear(),cur.getMonth()+1,cur.getDate());
      }
    };
    xhr.send(null);
  }catch(e){}
}
/* ============================================================
   和风天气（QWeather）：坐标直查，覆盖实况/7天预报/空气质量/紫外线
   免费版 1000 次/天，数据来自中央气象台，与 weather.com.cn 同源。
   ============================================================ */
function fetchQWeather(){
  /* [DEBUG] 和风入口日志：定位到底有没有调到和风 */
  _log("[QWeather] fetchQWeather called, key="+QWEATHER_KEY.length+" chars, lat="+cfg.lat+", lng="+cfg.lng);
  _log("[QWeather] env: typeof JSON="+(typeof JSON)+", JSON.parse="+(typeof JSON!=="undefined"?typeof JSON.parse:"n/a"));
  if(!cfg.lat || !cfg.lng || !QWEATHER_KEY){ _log("[QWeather] SKIP — key/坐标缺失"); return; }
  var loc=cfg.lng+","+cfg.lat;
  /* JSON 解析兼容层：HTA 默认 IE7 文档模式时没有 window.JSON，
     此时回退到 eval（数据来自可信天气接口，仅做字面量求值） */
  function _jp(t){
    if(!t) return null;
    t=String(t).replace(/^\uFEFF/,"").replace(/^\s+|\s+$/g,"");
    if(!t) return null;
    try{ if(typeof JSON!=="undefined" && JSON.parse) return JSON.parse(t); }catch(e){}
    try{ return eval("("+t+")"); }catch(e){ return null; }
  }
  /* 7 个并行请求：now + 7d + air/current + air/daily + uv + alert + storm-list */
  var result={now:null, fc:null, air:null, airDaily:null, uv:null, alert:null, stormList:null}, completed=0;
  var _cb="&_cb="+Math.floor(Math.random()*1e9);
  function newXhr(){
    /* 和风响应带 Content-Encoding: gzip。ServerXMLHTTP 走 WinHTTP 栈不会自动解压，
       会拿到 gzip 二进制导致 JSON 解析失败；Msxml2.XMLHTTP 走 WinINet 栈，自动解压。 */
    try{ return regXhr(new ActiveXObject("Msxml2.XMLHTTP.6.0")); }catch(e){
      try{ return regXhr(new ActiveXObject("MSXML2.ServerXMLHTTP.6.0")); }catch(e2){
        try{ return regXhr(new XMLHttpRequest()); }catch(e3){ return null; }
      }
    }
  }
  function checkDone(){
    if(completed<7){ _log("[QWeather] checkDone "+completed+"/7 waiting"); return; }
    _log("[QWeather] checkDone all 7 done, now="+!!result.now+" fc="+!!result.fc+" air="+!!result.air+" airDaily="+!!result.airDaily+" alert="+!!result.alert+" uv="+!!result.uv+" stormList="+!!result.stormList);
    if(!result.now || !result.fc){
      /* 和风失败 → 触发 backup 链路（weather.com.cn + wttr.in + typhoon.nmc.cn） */
      _log("[QWeather] FAIL now/fc null, triggering backup");
      if(QWEATHER_KEY && (!result.now || !result.fc)){
        weatherFailed=true;
        fetchOfficialWx();
        fetchOfficialLive();
        fetchLive();
        fetchTyphoon();
      }
      return;
    }
    var now=result.now;
    /* 和风 daily AQI 按日期建索引，forecast 优先取之；
       天数不够时 fallback 到 lastWeather（sojson）已有值。
       注意 forecastStartTime 是 UTC，需转本地日期再匹配 7d 的 fxDate */
    function utcDateToLocal(utc){
      if(!utc) return "";
      try{
        var d=new Date(utc);
        if(isNaN(d.getTime())) return "";
        var y=d.getFullYear(), m=("0"+(d.getMonth()+1)).slice(-2), dd=("0"+d.getDate()).slice(-2);
        return y+"-"+m+"-"+dd;
      }catch(e){ return utc.slice(0,10); }
    }
    var aqiByDate={};
    if(result.airDaily && result.airDaily.days){
      for(var ai=0;ai<result.airDaily.days.length;ai++){
        var ad=result.airDaily.days[ai];
        if(ad.indexes){
          for(var aij=0;aij<ad.indexes.length;aij++){
            /* 和风 daily AQI 的 index code 可能是 qaqi/caqi（国际版）或 cn-mee（中国版，中央气象台 AQI） */
            var ic=ad.indexes[aij].code||"";
            if(ic==="qaqi"||ic==="caqi"||ic==="cn-mee"){
              aqiByDate[utcDateToLocal(ad.forecastStartTime)]=ad.indexes[aij].aqi;
              break;
            }
          }
        }
      }
    }
    var forecast=[];
    /* 今天的 AQI 优先用实时实测值（result.air.aqi），与 airLine 保持一致；
       未来几天才用 airquality/daily 的预报预测值。 */
    var curAqi=(result.air&&result.air.aqi!=null)?parseInt(result.air.aqi,10):-1;
    for(var i=0;i<result.fc.length;i++){
      var f=result.fc[i];
      var aqi=-1;
      if(i===0 && curAqi>=0){
        aqi=curAqi;                        /* 今天：实时实测 AQI */
      }else if(aqiByDate[f.fxDate]!=null){
        aqi=aqiByDate[f.fxDate];           /* 未来：和风 daily 预报 AQI */
      }else if(lastWeather&&lastWeather.forecast){
        for(var pi=0;pi<lastWeather.forecast.length;pi++){
          if(lastWeather.forecast[pi].ymd===f.fxDate && lastWeather.forecast[pi].aqi>=0){
            aqi=lastWeather.forecast[pi].aqi; break;
          }
        }
      }
      forecast.push({ymd:f.fxDate, type:f.textDay, low:f.tempMin, high:f.tempMax, aqi:aqi});
    }
    lastWeather={
      wendu: now.temp,
      shidu: now.humidity+"%",
      pm25: (result.air&&result.air.pm25!=null)?String(result.air.pm25):"",
      pm10: (result.air&&result.air.pm10!=null)?String(result.air.pm10):"",
      quality: (result.air&&result.air.category)?result.air.category:"",
      obsTime: now.obsTime,
      aqi: (result.air&&result.air.aqi!=null)?parseInt(result.air.aqi,10):-1,
      forecast: forecast
    };
    /* 组装 officialWx（weather.com.cn 主站页兼容格式） */
    var todayFc=result.fc[0];
    officialWx={
      today: {
        weather: now.text,
        temp: (todayFc?todayFc.tempMax:"")+"℃",
        tempn: (todayFc?todayFc.tempMin:"")+"℃"
      },
      fc: [],
      live: {
        temp: now.temp,
        hum: now.humidity,
        wind: now.windDir,
        windScale: now.windScale+"级"
      }
    };
    for(var j=0;j<result.fc.length;j++){
      officialWx.fc.push({
        ymd: result.fc[j].fxDate,   /* 和风 7d 直接给 YYYY-MM-DD，供五日预报日期标签使用 */
        type: result.fc[j].textDay,
        high: result.fc[j].tempMax,
        low: result.fc[j].tempMin
      });
    }
    /* 组装 officialLive（weather1d 页兼容格式）。
       和风 indices(type=5) 返回 level=数值指数(如"3")、category=等级名(如"中等")、text=提示。
       之前把 level 写成 category 导致界面只显示"中等"而无数值，现已纠正。 */
    var uvData=null;
    if(result.uv && result.uv.length){
      uvData={level: result.uv[0].level, category: result.uv[0].category, desc: result.uv[0].text};
    }
    officialLive={
      temp: now.temp,
      hum: now.humidity,
      wind: now.windDir,
      windLv: now.windScale+"级",
      windKmh: now.windSpeed,
      /* 体感/气压/能见度：和风 now 直接提供，不再依赖 wttr.in */
      feels: now.feelsLike,
      pres: now.pressure,
      vis: now.vis,
      aqi: (result.air&&result.air.aqi!=null)?parseInt(result.air.aqi,10):-1,
      type: now.text,
      uv: uvData
    };
    weatherFailed=false; weatherRetry=0;
    /* 和风实时预警（高温/暴雨/大风/雷电/寒潮/沙尘暴/大雾/霾/台风…） */
    LAST_ALERTS=result.alert&&result.alert.alerts?result.alert.alerts:[];
    LAST_ALERTS_AT=nowClock();
    /* 台风：三级来源优先级
       1) 和风 weatheralert 本地台风预警 → src:"alert"（红色警示风 ⚠）
       2) 和风 tropical-cyclone storm-list（活跃台风）→ src:"storm"（蓝色信息风 🌀）
       3) typhoon.nmc.cn → src:"nmc"（蓝色信息风 🌀，和风无活跃台风时兜底） */
    var alertTyphoons=[];
    for(var ti=0;ti<LAST_ALERTS.length;ti++){
      if(LAST_ALERTS[ti].eventType && (LAST_ALERTS[ti].eventType.code==="1001" || LAST_ALERTS[ti].eventType.name==="台风")){
        var a=LAST_ALERTS[ti];
        alertTyphoons.push({
          id:a.id,
          cn:a.headline?a.headline.replace(/预警信号/,"").replace(/.*?(台风|热带风暴|强热带风暴|强台风|超强台风|热带低压)/,"$1"):"台风",
          level:a.severity||"",
          desc:a.description||a.headline||"",
          src:"alert"
        });
      }
    }
    var stormTyphoons=[];  /* 和风 tropical-cyclone storm-list */
    if(result.stormList && result.stormList.storm){
      var stormArr=result.stormList.storm;
      for(var si=0;si<stormArr.length;si++){
        if(stormArr[si].isActive==="1"){
          stormTyphoons.push({
            id:stormArr[si].id,         /* 格式 "NP_2630" */
            cn:stormArr[si].name||"台风",
            basin:stormArr[si].basin||"NP",
            year:stormArr[si].year||"",
            src:"storm"
          });
        }
      }
    }
    if(alertTyphoons.length){
      TYPHOONS=alertTyphoons; TYPHOON_AT=LAST_ALERTS_AT;
    }else if(stormTyphoons.length){
      /* 和风 storm-list 有活跃台风：先渲染一版（仅名称），再逐个补 storm-track 实况 */
      TYPHOONS=stormTyphoons; TYPHOON_AT=LAST_ALERTS_AT;
      whenIdle(function(){ renderTyphoonLine(); });
      for(var sdi=0;sdi<stormTyphoons.length;sdi++){
        (function(idx){
          var st=stormTyphoons[idx];
          if(!st||!st.id) return;
          var trackUrl="https://"+QWEATHER_HOST+"/v7/tropical/storm-track?stormid="+st.id+"&key="+QWEATHER_KEY+_cb;
          var sx=newXhr(); if(!sx) return;
          try{ sx.open("GET",trackUrl,true);
            sx.onreadystatechange=function(){
              if(sx.readyState==4 && sx.status==200){
                try{
                  var sd=_jp(sx.responseText);
                  if(sd && sd.code==="200" && sd.now){
                    var cur=TYPHOONS[idx]; if(!cur) return;
                    cur.intensity=TYPHOON_STATUS[sd.now.type]||sd.now.type;
                    cur.wind=parseInt(sd.now.windSpeed,10);
                    cur.pressure=parseInt(sd.now.pressure,10);
                    cur.lat=parseFloat(sd.now.lat);
                    cur.lon=parseFloat(sd.now.lon);
                    cur.moveDir=TYPHOON_DIR[sd.now.moveDir]||sd.now.moveDir;
                    cur.moveSpeed=parseInt(sd.now.moveSpeed,10);
                    cur.time=sd.now.pubTime||"";
                    cur.windRadius64=sd.now.windRadius64;  /* 64节风圈半径（km） */
                    TYPHOON_AT=nowClock();
                    whenIdle(function(){ renderTyphoonLine(); });
                  }
                }catch(e){}
              }
            }; sx.send(null);
          }catch(e){}
        })(sdi);
      }
    }else{
      /* 和风 storm-list 也没有活跃台风 → 兜底 typhoon.nmc.cn */
      try{ fetchTyphoon(); }catch(e){}
    }
    _log("[Render] lastWeather.aqi="+(lastWeather?lastWeather.aqi:"null")+" quality="+(lastWeather?lastWeather.quality:"")+" pm25="+(lastWeather?lastWeather.pm25:"")+" pm10="+(lastWeather?lastWeather.pm10:""));
    if(!inMonthView){ renderWeatherLine(cur.getFullYear(),cur.getMonth()+1,cur.getDate()); renderAlerts(); }
  }
  function qwGet(path, cb){
    var xhr=newXhr();
    if(!xhr){ completed++; checkDone(); return; }
    try{
      try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e){}
      /* path 可能已带查询串（如 indices/1d?type=5），不能直接再拼 "?"，
         否则会变成 ...?type=5?location=... 导致 location 丢失（HTTP 400） */
      var sep=(path.indexOf("?")>=0)?"&":"?";
      xhr.open("GET","https://"+QWEATHER_HOST+"/v7/"+path+sep+"location="+loc+"&key="+QWEATHER_KEY+_cb,true);
      xhr.onreadystatechange=function(){
        if(xhr.readyState==4){
          try{ _log("[QWeather] /v7/"+path+" HD="+String(xhr.getAllResponseHeaders||"")+""); }catch(e){}
          _log("[QWeather] /v7/"+path+" HTTP="+xhr.status+" len="+String(xhr.responseText||"").length+" resp="+String(xhr.responseText||"").substring(0,200));
          if(xhr.status==200){
            try{
              var d=_jp(xhr.responseText);
              _log("[QWeather] /v7/"+path+" → code="+(d?d.code:"null")+" (now="+!!(d&&d.now)+" daily="+!!(d&&d.daily)+")");
              if(d&&d.code==="200") cb(d);
            }catch(e){ _log("[QWeather] /v7/"+path+" JSON parse error: "+e.message); }
          }
          completed++; checkDone();
        }
      };
      xhr.send(null);
    }catch(e){ completed++; checkDone(); }
  }
  /* 新版空气质量接口：/airquality/v1/current/{lat}/{lng} */
  function qwAir(cb){
    var xhr=newXhr();
    if(!xhr){ completed++; checkDone(); return; }
    try{
      try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e){}
      xhr.open("GET","https://"+QWEATHER_HOST+"/airquality/v1/current/"+cfg.lat+"/"+cfg.lng+"?key="+QWEATHER_KEY+_cb,true);
      xhr.onreadystatechange=function(){
        if(xhr.readyState==4){
          _log("[QWeather] /airquality/v1/current HTTP="+xhr.status+" resp="+String(xhr.responseText||"").substring(0,200));
          if(xhr.status==200){
            try{
              var d=_jp(xhr.responseText);
              _log("[QWeather] /airquality/v1/current → indexes="+(d&&d.indexes?d.indexes.length:0));
              if(d&&d.indexes&&d.indexes.length){
                var idx=d.indexes[0], p25=null, p10=null;
                if(d.pollutants){
                  for(var i=0;i<d.pollutants.length;i++){
                    if(d.pollutants[i].code==="pm2p5") p25=d.pollutants[i].concentration.value;
                    if(d.pollutants[i].code==="pm10")  p10=d.pollutants[i].concentration.value;
                  }
                }
                cb({aqi:idx.aqi, category:idx.category, pm25:p25, pm10:p10});
              }
            }catch(e){ _log("[QWeather] /airquality/v1/current JSON error"); }
          }else{ _log("[QWeather] /airquality/v1/current HTTP "+xhr.status); }
          completed++; checkDone();
        }
      };
      xhr.send(null);
    }catch(e){ completed++; checkDone(); }
  }
  /* 和风 daily AQI 预报：/airquality/v1/daily/{lat}/{lng} */
  function qwAirDaily(cb){
    var xhr=newXhr();
    if(!xhr){ completed++; checkDone(); return; }
    try{
      try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e){}
      xhr.open("GET","https://"+QWEATHER_HOST+"/airquality/v1/daily/"+cfg.lat+"/"+cfg.lng+"?key="+QWEATHER_KEY+_cb,true);
      xhr.onreadystatechange=function(){
        if(xhr.readyState==4){
          _log("[QWeather] /airquality/v1/daily HTTP="+xhr.status+" resp="+String(xhr.responseText||"").substring(0,200));
          if(xhr.status==200){
            try{
              var d=_jp(xhr.responseText);
              _log("[QWeather] /airquality/v1/daily → days="+(d&&d.days?d.days.length:0));
              if(d&&d.days){ cb(d); }
            }catch(e){ _log("[QWeather] /airquality/v1/daily JSON error"); }
          }else{ _log("[QWeather] /airquality/v1/daily HTTP "+xhr.status); }
          completed++; checkDone();
        }
      };
      xhr.send(null);
    }catch(e){ completed++; checkDone(); }
  }
  /* 和风实时气象预警：/weatheralert/v1/current/{lat}/{lng}
     覆盖高温/暴雨/大风/雷电/寒潮/沙尘暴/大雾/霾/台风等数百种事件 */
  function qwAlert(cb){
    var xhr=newXhr();
    if(!xhr){ completed++; checkDone(); return; }
    try{
      try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e){}
      xhr.open("GET","https://"+QWEATHER_HOST+"/weatheralert/v1/current/"+cfg.lat+"/"+cfg.lng+"?key="+QWEATHER_KEY+_cb,true);
      xhr.onreadystatechange=function(){
        if(xhr.readyState==4){
          _log("[QWeather] /weatheralert HTTP="+xhr.status+" resp="+String(xhr.responseText||"").substring(0,200));
          if(xhr.status==200){
            try{
              var d=_jp(xhr.responseText);
              _log("[QWeather] /weatheralert/v1/current → alerts="+(d&&d.alerts?d.alerts.length:0)+" zeroResult="+(d&&d.metadata&&d.metadata.zeroResult));
              if(d&&d.alerts){ cb(d); }
              else if(d){ cb(d); }   /* zeroResult=true 时无 alerts 字段 */
            }catch(e){ _log("[QWeather] /weatheralert JSON error"); }
          }else{ _log("[QWeather] /weatheralert HTTP "+xhr.status); }
          completed++; checkDone();
        }
      };
      xhr.send(null);
    }catch(e){ completed++; checkDone(); }
  }
  /* 和风热带气旋（台风）列表：/v7/tropical/storm-list?basin=NP&year=YYYY
     需要活跃台风的 stormid（如 NP_2630）才能继续调 storm-track 取实况位置/强度/风速/气压/风圈。 */
  function qwStormList(cb){
    var xhr=newXhr();
    if(!xhr){ completed++; checkDone(); return; }
    try{
      try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e){}
      var yyyy=new Date().getFullYear();
      xhr.open("GET","https://"+QWEATHER_HOST+"/v7/tropical/storm-list?basin=NP&year="+yyyy+"&key="+QWEATHER_KEY+_cb,true);
      xhr.onreadystatechange=function(){
        if(xhr.readyState==4){
          if(xhr.status==200){
            try{
              var d=_jp(xhr.responseText);
              _log("[QWeather] /v7/tropical/storm-list → code="+(d&&d.code)+" storm="+(d&&d.storm?d.storm.length:0));
              cb(d);
            }catch(e){ _log("[QWeather] /v7/tropical/storm-list JSON error"); cb(null); }
          }else{ _log("[QWeather] /v7/tropical/storm-list HTTP "+xhr.status); cb(null); }
          completed++; checkDone();
        }
      };
      xhr.send(null);
    }catch(e){ completed++; checkDone(); cb(null); }
  }
  qwGet("weather/now",  function(d){ result.now=d.now; });
  qwGet("weather/7d",   function(d){ result.fc=d.daily; });
  qwAir(                function(a){ result.air=a; });
  qwAirDaily(           function(a){ result.airDaily=a; });
  qwGet("indices/1d?type=5", function(d){ result.uv=d.daily; });
  qwAlert(              function(a){ result.alert=a; });
  qwStormList(          function(s){ result.stormList=s; });
}
function fetchWeather(force){
  var now=new Date().getTime();
  if(!force && now-lastFetchTs<30*60*1000) return;
  lastFetchTs=now;
  /* 优先级：和风（坐标直查，中央气象台，区县精度）为单一主源，
     覆盖 now/7d/air/current/air/daily/uv/alert/storm-list 共 7 个接口；
     tropical-cyclone storm-track 按需补充实况。
     weather.com.cn / wttr.in / typhoon.nmc.cn 全部降级为 backup；
     sojson 仅用于补 forecast AQI 天数缺口。 */
  var hasQw=!!QWEATHER_KEY;
  fetchQWeather();
  if(!hasQw){
    /* 和风无 key → 启用 weather.com.cn + wttr.in 全链路 */
    fetchOfficialWx();
    fetchOfficialLive();
  }
  /* sojson：始终调用，但仅用于补 forecast AQI 天数缺口
     （和风 daily 只有 3 天，sojson 给 5 天），其余字段以和风为准 */
  var sojsonCode="";
  if(cityMap[cfg.city]){
    sojsonCode=cityMap[cfg.city].baseCode||cityMap[cfg.city].code;
  }else{
    var _bc=baseCityOf(cfg.city);
    if(_bc && cityMap[_bc]) sojsonCode=cityMap[_bc].code;
  }
  if(!sojsonCode) sojsonCode=cfg.code;
  var url="http://t.weather.sojson.com/api/weather/city/"+sojsonCode;
  var xhr=null;
  try{ xhr=regXhr(new ActiveXObject("MSXML2.ServerXMLHTTP.6.0")); }catch(e){
    try{ xhr=regXhr(new ActiveXObject("Msxml2.XMLHTTP.6.0")); }catch(e2){
      try{ xhr=regXhr(new XMLHttpRequest()); }catch(e3){ xhr=null; }
    }
  }
  if(!xhr){ weatherFailed=true; weatherRetryLater(); return; }
  try{
    try{ xhr.setTimeouts(15000,15000,15000,15000); }catch(e5){}
    xhr.open("GET",url,true);
    try{ xhr.setRequestHeader("User-Agent","Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"); }catch(e4){}
    xhr.onreadystatechange=function(){
      if(xhr.readyState==4){
        if(xhr.status==200){
          try{
            var w=parseWeatherText(xhr.responseText);
            if(w){
              /* 合并：和风优先，sojson 仅补 forecast AQI 天数缺口
                 （和风 daily 只有 3 天 AQI，sojson 给 5 天）。
                 其余字段（aqi/pm25/pm10/quality/wendu/shidu）以和风为准，
                 因为和风是坐标直查区县精度，比 sojson 市级更准。 */
              if(lastWeather){
                w.aqi=lastWeather.aqi;
                w.pm25=lastWeather.pm25;
                w.pm10=lastWeather.pm10;
                w.quality=lastWeather.quality;
                w.obsTime=lastWeather.obsTime;
                w.wendu=lastWeather.wendu;
                w.shidu=lastWeather.shidu;
                /* sojson forecast 只补 lastWeather forecast 里 aqi==-1 的天数 */
                if(lastWeather.forecast&&w.forecast){
                  for(var si=0;si<w.forecast.length;si++){
                    for(var li=0;li<lastWeather.forecast.length;li++){
                      if(w.forecast[si].ymd===lastWeather.forecast[li].ymd){
                        if(lastWeather.forecast[li].aqi===-1 && w.forecast[si].aqi>=0){
                          lastWeather.forecast[li].aqi=w.forecast[si].aqi;
                        }
                        break;
                      }
                    }
                  }
                }
              }else{
                lastWeather=w;
              }
              weatherFailed=false; weatherRetry=0;
            }
          }catch(ex){ weatherFailed=true; weatherRetryLater(); }
        }else{ weatherFailed=true; weatherRetryLater(); }
        if(!inMonthView) renderWeatherLine(cur.getFullYear(),cur.getMonth()+1,cur.getDate());
      }
    };
    xhr.send(null);
  }catch(e){ weatherFailed=true; weatherRetryLater(); }
}

var WEEK_CN=["日","一","二","三","四","五","六"];
function renderCalHead(ws){
  var tr=document.getElementById("calHead");
  if(!tr) return;
  /* IE 下不能给 tr 赋 innerHTML（抛"该操作的目标对象无效"），必须逐格删建 */
  try{ while(tr.cells.length>0){ tr.deleteCell(0); } }catch(e){}
  var i, dow, th;
  for(i=0;i<7;i++){
    dow=(ws+i)%7;                             /* 0=周日 … 6=周六 */
    th=document.createElement("th");
    th.innerHTML=WEEK_CN[dow];
    if(dow===0 || dow===6){ th.style.color="#c22012"; }
    tr.appendChild(th);
  }
}
function renderMonth(){
  var y=viewY, m=viewM;
  document.getElementById("mTitle").innerHTML=y+"年 "+m+"月"
    +"<span class='sync'>"+(holHasYear(y)?"调休已同步":"调休待公布")+"</span>";
  var first=new Date(y,m-1,1);
  var ws=(cfg.weekStart===0)?0:1;        /* 0=周日开头 1=周一开头 */
  renderCalHead(ws);
  var startCol=(first.getDay()-ws+7)%7;
  var days=solarDays(y,m);
  var t1n=(m-1)*2, t2n=t1n+1;
  var t1d=sTermDay(y,t1n), t2d=sTermDay(y,t2n);
  var n=new Date();
  var isThis=(n.getFullYear()==y && n.getMonth()+1==m);
  var tb=document.getElementById("calBody");
  var r, c, dnum=1;
  /* 注意：本环境下给 tbody 赋 innerHTML 会抛"该操作的目标对象无效"，
     必须用 insertRow/insertCell 构建，单元格内部再用 innerHTML 是正常的。 */
  while(tb.rows.length>0){ tb.deleteRow(0); }
  for(r=0;r<6;r++){
    var tr=tb.insertRow();
    for(c=0;c<7;c++){
      var td=tr.insertCell();
      var idx=r*7+c;
      if(idx<startCol || dnum>days){ td.className="empty"; continue; }
      var dd=dnum;
      var lunar=toLunar(y,m,dd);
      var adj=holDay(y,m,dd);                 /* 国务院调休安排 */
      var cls="", sub="";
      /* 副标题优先级：节气 > 节日 > 调休标记 > 农历 */
      if(dd==t1d){ sub=termNames[t1n]; cls="term"; }
      else if(dd==t2d){ sub=termNames[t2n]; cls="term"; }
      else{
        var f=festivals(y,m,dd,lunar,-1);
        if(f.length){ sub=f[0]; cls="fest"; }
      }
      if(!sub && adj && adj.type=="work"){
        sub="<span class='ban'>班</span>";
      }else if(!sub && adj && adj.type=="off"){
        var nm=adj.name;
        if(nm && !/^初[一二三四五六七八九十]$/.test(nm) && nm!="除夕"){ sub=nm; cls="fest"; }
        else sub="<span class='off'>休</span>";
      }
      if(!sub){
        if(lunar.day==1){ sub=(lunar.isLeap?"闰":"")+monthName(lunar.month); cls="lunar1"; }
        else sub=cDay(lunar.day);
      }
      var isToday=(isThis && dd==n.getDate());
      var sdCls="", tdCls="";
      if(isToday) tdCls="today";
      if(adj && adj.type=="work"){ tdCls=(tdCls?tdCls+" ":"")+"workday"; sdCls=" sdWork"; }
      else if(adj && adj.type=="off"){ tdCls=(tdCls?tdCls+" ":"")+"restday"; sdCls=" sdRest"; }
      else if(!isToday){
        if(cls=="fest"||cls=="term") sdCls=" sdFest";
        else if((ws+c)%7===0 || (ws+c)%7===6) sdCls=" sdWeekend";
      }
      td.className=tdCls;
      td.setAttribute("data-d", dd);
      td.innerHTML="<div class='sd"+sdCls+"'>"+dd+"</div><div class='ld "+cls+"'>"+sub+"</div>";
      dnum++;
    }
    if(dnum>days) break;
  }
}

function showView(month){
  inMonthView=month;
  document.getElementById("dayView").style.display=month?"none":"table";
  document.getElementById("monthView").style.display=month?"block":"none";
  document.getElementById("prevLbl").innerHTML=month?"上一月":"前一天";
  document.getElementById("nextLbl").innerHTML=month?"下一月":"后一天";
  document.getElementById("toggleBtn").innerHTML=month?"返回黄历":"万年历";
  if(month){ viewY=cur.getFullYear(); viewM=cur.getMonth()+1; renderMonth(); }
  else{ renderDay(); }
}

function shiftDay(delta){
  var nd=new Date(cur.getFullYear(),cur.getMonth(),cur.getDate()+delta);
  if(nd<new Date(1900,1,1) || nd>new Date(2100,11,31)) return;
  cur=nd;
  renderDay();
}
function shiftMonth(delta){
  var m=viewM+delta, y=viewY;
  while(m>12){ m-=12; y++; }
  while(m<1){ m+=12; y--; }
  if(y<1900 || y>2100) return;
  viewY=y; viewM=m; renderMonth();
}
function goToday(){ cur=new Date(); if(inMonthView){ viewY=cur.getFullYear(); viewM=cur.getMonth()+1; renderMonth(); } else { renderDay(); } }

/* ---------- 拖动 + 自动隐藏 ---------- */
var dragging=false, offX=0, offY=0;
var mvLast=0, mvX=0, mvY=0;
var dragPending=false, dragSx=0, dragSy=0;
/* ---------- 手势期间推迟界面更新 ----------
   拖动/缩放窗口时，任何一次界面重绘都会重排整个日历。
   若后台任务（天气/台风/调休的异步回调，或 30 秒一次的 tick）
   恰好在拖动过程中完成并触发重绘，就会表现为"顺滑一阵、忽然卡一下"，
   每次重新拖动又表现不同，非常难排查。
   因此手势进行中一律不更新界面，把请求排队，等手势结束后统一执行。 */
var idleTimer=0, idleQueue=[];
function isGesturing(){ return (dragging||dragPending||rzOn); }
function whenIdle(fn){
  if(!isGesturing()){ try{ fn(); }catch(e){} return; }
  idleQueue.push(fn);
  try{
    if(idleTimer) clearTimeout(idleTimer);
    idleTimer=setTimeout(function(){ flushIdle(); },220);
  }catch(e){}
}
function flushIdle(){
  try{ if(idleTimer){ clearTimeout(idleTimer); idleTimer=0; } }catch(e){}
  if(isGesturing()){
    try{ idleTimer=setTimeout(function(){ flushIdle(); },220); }catch(e){}
    return;
  }
  var q=idleQueue; idleQueue=[];
  for(var i=0;i<q.length;i++){ try{ q[i](); }catch(e){} }
}
var navTimer=0, topTimer=0;
var barTopOn=false, barNavOn=false, barArmed=false;
/* 窗口缩放：HTA 是无边框窗口（BORDER="none"/CAPTION="no"），
   系统不提供可拖拽的边框，因此必须在页面里自带缩放手柄。

   实现要点：
   1) 用「按下时的窗口左上角」作锚点，配合鼠标的屏幕绝对坐标算尺寸，
      属于绝对计算而非增量累加，不会因 resizeTo 异步生效而漂移。
      （早前用 resizeBy + 读回 clientWidth 的写法会因读回旧值而产生累积误差，
        表现为窗口越拖越偏、拖不回去。）
   2) 锁定 BASE_W:BASE_H 宽高比，窗口始终恰好贴合内容，
      不会出现大片红边导致"背景与内容脱层"。
   3) mousemove 频率极高，必须节流，否则每帧都触发窗口+zoom 全量重排而卡顿。 */
var rzOn=false, rzSx=0, rzSy=0, rzBaseW=0, rzBaseH=0, rzLast=0, rzZoom=0, rzCap=false;
var RZ_MIN_W=300, RZ_MIN_H=400, RZ_MAX_W=1600, RZ_MAX_H=2400;
function bindResize(){
  var g=document.getElementById("resizeGrip");
  if(!g) return;
  g.onmousedown=function(){
    var e=window.event;
    if(!e) return;
    rzOn=true;
    rzSx=e.screenX; rzSy=e.screenY;
    rzLast=0; rzZoom=0;
    /* 关键：基准必须取「外框」尺寸。
       若用 clientWidth（客户区）作基准而 resizeTo 收的是外框尺寸，
       每次拖动都会比实际少一个边框厚度，表现为窗口每点一次就缩小一圈。 */
    var cw=document.documentElement.clientWidth||BASE_W;
    var ch=document.documentElement.clientHeight||BASE_H;
    var ow=window.outerWidth||0, oh=window.outerHeight||0;
    rzBaseW=(ow>cw)?ow:cw+16;
    rzBaseH=(oh>ch)?oh:ch+39;
    /* 抓住鼠标：窗口缩小后光标仍留在窗口外时，mousemove 仍能送达，
       否则手柄会"抓不住"，一缩小光标就出窗导致拖拽中断。 */
    try{ g.setCapture(true); rzCap=true; }catch(x){}
    try{ e.returnValue=false; e.cancelBubble=true; }catch(x){}
    return false;
  };
}
function resizeRelease(){
  if(rzCap){
    var g=document.getElementById("resizeGrip");
    try{ if(g) g.releaseCapture(); }catch(x){}
    rzCap=false;
  }
}
function resizeMove(e){
  if(!rzOn) return false;
  var now=new Date().getTime();
  if(now-rzLast<50) return false;
  rzLast=now;
  /* 全程使用按下时固定的基准做增量计算，绝不读回实际尺寸，
     因此不存在误差累积；缩放比例变化时也不会丢失参考点。 */
  var w=rzBaseW+(e.screenX-rzSx);
  var h=rzBaseH+(e.screenY-rzSy);
  if(w<RZ_MIN_W) w=RZ_MIN_W; if(w>RZ_MAX_W) w=RZ_MAX_W;
  if(h<RZ_MIN_H) h=RZ_MIN_H; if(h>RZ_MAX_H) h=RZ_MAX_H;
  var ar=BASE_W/BASE_H;
  if(Math.abs(w-rzBaseW) >= Math.abs(h-rzBaseH)) h=Math.round(w/ar);
  else w=Math.round(h*ar);
  if(h<RZ_MIN_H){ h=RZ_MIN_H; w=Math.round(h*ar); }
  if(w<RZ_MIN_W){ w=RZ_MIN_W; h=Math.round(w/ar); }
  try{ window.resizeTo(w,h); }catch(x){}
  if(now-rzZoom>140){ rzZoom=now; layoutStage(); }
  try{ e.returnValue=false; e.cancelBubble=true; }catch(x){}
  return false;
}
function resizeEnd(){
  if(!rzOn) return;
  rzOn=false;
  resizeRelease();
  layoutStage();
  saveWindowSize();
}
/* 顶部浮动栏显隐统一走 showTop()：
   所有对 style.display 的修改都必须经由这里同步标志位，
   否则标志位与真实 DOM 状态会不一致（表现为移出窗口后 title 再也弹不出来）。 */
function showTop(on){
  if(barTopOn==on) return;
  barTopOn=on;
  var ft=document.getElementById("floatTop");
  if(ft) ft.style.display=on?"block":"none";
}
/* #nav 恢复自动隐藏：鼠标移到底部附近时浮现，2.6 秒后自动收起 */
function showNav(on){
  if(barNavOn==on) return;
  barNavOn=on;
  var nv=document.getElementById("nav");
  if(nv) nv.style.display=on?"block":"none";
}
function hideBars(){ showTop(false); showNav(false); }
function clearBarTimers(){
  try{ if(navTimer){ clearTimeout(navTimer); navTimer=0; } }catch(e){}
  try{ if(topTimer){ clearTimeout(topTimer); topTimer=0; } }catch(e){}
  barArmed=false;
}
/* 兜底：即使鼠标不再移动，也强制在若干毫秒后收起，避免停留不消失 */
function armBarTimers(){
  clearBarTimers();
  barArmed=true;
  try{
    navTimer=setTimeout(function(){
      navTimer=0; barArmed=false; showNav(false);
    },2600);
    topTimer=setTimeout(function(){
      topTimer=0; barArmed=false; showTop(false);
    },2600);
  }catch(e){}
}
function updateBars(){
  var e=window.event;
  if(!e) return;
  var y=e.clientY||0;
  var h=document.documentElement.clientHeight||document.body.clientHeight||660;
  showTop(y>0 && y<32);
  showNav(y>0 && y>h-50);
  if(barTopOn||barNavOn){ if(!barArmed) armBarTimers(); } else clearBarTimers();
}
/* ---------- 退出 ----------
   mshta 的宿主进程只有在脚本环境彻底静默后才会结束。
   只要还有 setInterval 在跑、或有未完成的 XMLHttp 请求，
   窗口虽然关了，进程仍会驻留；下次启动时 SINGLEINSTANCE 会误判
   "已有实例在运行"，于是既不新开窗口也不刷新界面，表现为关不掉。
   因此关闭前必须先清干净定时器并中止所有在途请求。 */
var closing=false, tickTimer=0;
var gXhr=[];
function regXhr(x){ if(x) gXhr.push(x); return x; }
function cleanupAll(){
  flushWindowSize();   /* 退出前补写尚未落盘的窗口尺寸 */
  try{ if(tickTimer){ clearInterval(tickTimer); tickTimer=0; } }catch(e){}
  try{ if(mqTimer){ clearInterval(mqTimer); mqTimer=0; } }catch(e){}
  clearBarTimers();
  try{ if(layoutTimer){ clearTimeout(layoutTimer); layoutTimer=0; } }catch(e){}
  for(var i=0;i<gXhr.length;i++){ try{ gXhr[i].abort(); }catch(e){} }
  gXhr.length=0;
}
/* ============================================================
   启动自动定位（续）
   ------------------------------------------------------------
   目的：用户换地方、或别人拿到程序直接用，都不需要手动选城市。
   三级定位，全部免密钥、尽量明文 HTTP 可用，按优先级依次尝试：
   ① Windows 定位服务（WiFi/GPS，通过 PowerShell 调 WinRT Geolocator，
      精度最高可到区县；前提是系统「位置」开关已开启。实测本机
      WiFi 定位返回 22.63°N,114.12°E、精度约 114 米，即龙岗布吉一带）
   ② ipip.net 的 IP 库：返回「省/市/区/运营商」结构文本，国内库较准，
      按城市名匹配 cityMap（实测本机判为「广东 深圳」，ip-api 却误判广州）
   ③ ip-api.com 经纬度：在 cityMap 中按 Haversine 距离取最近城市（兜底）
   每次启动静默定位一次并落盘（用户手动选过城市 manualCity=1 时除外）；
   失败则下次启动自动重试。设置面板可手动「重新定位」。
   ============================================================ */
var GEO_URL_IPAPI="http://ip-api.com/json/?lang=zh-CN";
var GEO_URL_IPIP="http://myip.ipip.net/json";
/* 和风天气 API Key：写入同目录 huangli_cfg.json 的 qweatherKey 字段（已 gitignore，不会入库）。
   留空时 fetchQWeather 会静默跳过和风接口，不影响 weather.com.cn/sojson/wttr 兜底。 */
var QWEATHER_KEY="";
var QWEATHER_HOST="p85khy6vmp.re.qweatherapi.com"; /* 和风控制台分配的专属 API Host（免费版同样有） */
/* Windows 定位辅助脚本（hl_geoloc.ps1，由本程序在定位时生成到同目录再运行）。
   把经纬度与精度写进指定输出文件，纯 ASCII，避免系统代码页的中文乱码；
   内容全部来自程序自身，不含任何外部输入，无注入风险。 */
var GEOLOC_PS1=
"$ErrorActionPreference='Stop'\r\n"+
"function Esc($s){ if($null -eq $s){return ''}; $sb=New-Object System.Text.StringBuilder; foreach($ch in $s.ToString().ToCharArray()){ $cc=[int]$ch; if($cc -lt 128){[void]$sb.Append($ch)}else{[void]$sb.AppendFormat('\\u{0:X4}',$cc)} }; $sb.ToString() }\r\n"+
"try{\r\n"+
"  $fout=$args[0]\r\n"+
"  try{ Start-Process -WindowStyle Hidden -FilePath 'cmd.exe' -ArgumentList '/c',('ping -n 45 127.0.0.1 >nul & taskkill /f /pid '+$PID+' >nul 2>nul') | Out-Null }catch{}\r\n"+
"  [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12\r\n"+
"  function RdVar($buf,$p){\r\n"+
"    [int64]$v=0; [int]$sh=0\r\n"+
"    while($true){ $b=$buf[$p]; $p++; $v=$v -bor (([int64]($b -band 0x7F)) -shl $sh); if(($b -band 0x80) -eq 0){ break }; $sh+=7; if($sh -gt 63){ break } }\r\n"+
"    return @($v,$p)\r\n"+
"  }\r\n"+
"  function TryWloc{\r\n"+
"    try{\r\n"+
"      $b0=((netsh wlan show interfaces | Select-String 'AP BSSID *: *([0-9A-Fa-f:]{17})') | ForEach-Object { $_.Matches[0].Groups[1].Value } | Select-Object -First 1)\r\n"+
"      $cands=New-Object System.Collections.ArrayList\r\n"+
"      if($b0){ [void]$cands.Add($b0.ToLower()) }\r\n"+
"      (netsh wlan show networks mode=bssid | Select-String 'BSSID +[0-9]+ *: *([0-9A-Fa-f:]{17})') | ForEach-Object { $x=$_.Matches[0].Groups[1].Value.ToLower(); if(($cands.Count -lt 6) -and (-not $cands.Contains($x))){ [void]$cands.Add($x) } }\r\n"+
"      if($cands.Count -eq 0){ return $false }\r\n"+
"      $pb=New-Object IO.MemoryStream; $pw=New-Object IO.BinaryWriter($pb)\r\n"+
"      foreach($m in $cands){ $mb=[Text.Encoding]::ASCII.GetBytes($m); $pw.Write([byte]0x12); $pw.Write([byte](2+$mb.Length)); $pw.Write([byte]0x0A); $pw.Write([byte]$mb.Length); $pw.Write($mb) }\r\n"+
"      $pw.Write([byte]0x18); $pw.Write([byte]0x00); $pw.Write([byte]0x20); $pw.Write([byte]0x01); $pw.Flush()\r\n"+
"      $pbb=$pb.ToArray(); if($pbb.Length -gt 250){ return $false }\r\n"+
"      $ms=New-Object IO.MemoryStream; $bw=New-Object IO.BinaryWriter($ms)\r\n"+
"      $bw.Write([byte[]](0,1,0,5)); $bw.Write([Text.Encoding]::ASCII.GetBytes('en_US'))\r\n"+
"      $bw.Write([byte[]](0,0x13)); $bw.Write([Text.Encoding]::ASCII.GetBytes('com.apple.locationd'))\r\n"+
"      $bw.Write([byte[]](0,0x0a)); $bw.Write([Text.Encoding]::ASCII.GetBytes('8.1.12B411'))\r\n"+
"      $bw.Write([byte[]](0,0,0,1,0,0,0)); $bw.Write([byte]$pbb.Length); $bw.Write($pbb); $bw.Flush()\r\n"+
"      $body=$ms.ToArray()\r\n"+
"      $req=[Net.HttpWebRequest]::Create('https://gs-loc.apple.com/clls/wloc')\r\n"+
"      $req.Method='POST'; $req.ContentType='application/x-www-form-urlencoded'; $req.UserAgent='locationd/1753.17 CFNetwork/889.9 Darwin/17.2.0'; $req.Timeout=6000; $req.ReadWriteTimeout=6000; $req.ContentLength=$body.Length\r\n"+
"      $rs=$req.GetRequestStream(); $rs.Write($body,0,$body.Length); $rs.Close()\r\n"+
"      $resp=$req.GetResponse(); $ms2=New-Object IO.MemoryStream; $resp.GetResponseStream().CopyTo($ms2); $resp.Close(); $buf=$ms2.ToArray()\r\n"+
"      if($buf.Length -lt 14){ return $false }\r\n"+
"      $first=$null; $best=$null; $p=10\r\n"+
"      while($p -lt $buf.Length){\r\n"+
"        $tag=$buf[$p]; $p++; $fld=$tag -shr 3; $wir=$tag -band 7\r\n"+
"        if($wir -eq 2){\r\n"+
"          $r=RdVar $buf $p; $len=$r[0]; $p=$r[1]; $end=$p+$len\r\n"+
"          if($fld -eq 2){\r\n"+
"            $q=$p; $db=''; $la=$null; $lo=$null; $ac=0\r\n"+
"            while($q -lt $end){\r\n"+
"              $t2=$buf[$q]; $q++; $f2=$t2 -shr 3; $w2=$t2 -band 7\r\n"+
"              if($w2 -eq 2){ $r=RdVar $buf $q; $l2=$r[0]; $q=$r[1]; $e2=$q+$l2\r\n"+
"                if($f2 -eq 1){ $db=[Text.Encoding]::ASCII.GetString($buf,$q,$l2).ToLower() }\r\n"+
"                elseif($f2 -eq 2){ $rr=$q\r\n"+
"                  while($rr -lt $e2){ $t3=$buf[$rr]; $rr++; $f3=$t3 -shr 3; $w3=$t3 -band 7\r\n"+
"                    if($w3 -eq 0){ $r=RdVar $buf $rr; $vv=$r[0]; $rr=$r[1]; if($f3 -eq 1){ $la=$vv } elseif($f3 -eq 2){ $lo=$vv } elseif($f3 -eq 3){ $ac=$vv } }\r\n"+
"                    elseif($w3 -eq 2){ $r=RdVar $buf $rr; $rr=$r[1]+$r[0] } elseif($w3 -eq 5){ $rr+=4 } else { $rr+=8 } }\r\n"+
"                }\r\n"+
"                $q=$e2\r\n"+
"              } elseif($w2 -eq 0){ $r=RdVar $buf $q; $q=$r[1] } elseif($w2 -eq 5){ $q+=4 } else { $q+=8 }\r\n"+
"            }\r\n"+
"            if(($null -ne $la) -and ($null -ne $lo)){ $aa=[double]$la/1e8; $oo=[double]$lo/1e8\r\n"+
"              if(-not (($aa -eq -180) -and ($oo -eq -180))){\r\n"+
"                $rec=New-Object PSObject; $rec|Add-Member NoteProperty b $db; $rec|Add-Member NoteProperty a $aa; $rec|Add-Member NoteProperty o $oo; $rec|Add-Member NoteProperty c $ac\r\n"+
"                if($null -eq $first){ $first=$rec }\r\n"+
"                if($b0 -and ($db -eq $b0.ToLower())){ $best=$rec }\r\n"+
"              }\r\n"+
"            }\r\n"+
"          }\r\n"+
"          $p=$end\r\n"+
"        } elseif($wir -eq 0){ $r=RdVar $buf $p; $p=$r[1] } elseif($wir -eq 5){ $p+=4 } else { $p+=8 }\r\n"+
"      }\r\n"+
"      if($null -eq $best){ $best=$first }\r\n"+
"      if($null -ne $best){ [IO.File]::WriteAllText($fout,('{0},{1},{2},,,wloc' -f $best.a,$best.o,[int]$best.c)); return $true }\r\n"+
"    }catch{}\r\n"+
"    return $false\r\n"+
"  }\r\n"+
"  if(TryWloc){ exit }\r\n"+
"  Add-Type -AssemblyName System.Runtime.WindowsRuntime | Out-Null\r\n"+
"  $null=[Windows.Devices.Geolocation.Geolocator,Windows.Devices.Geolocation,ContentType=WindowsRuntime]\r\n"+
"  $null=[Windows.Devices.Geolocation.Geoposition,Windows.Devices.Geolocation,ContentType=WindowsRuntime]\r\n"+
"  $m=([System.WindowsRuntimeSystemExtensions].GetMethods()|Where-Object{$_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1'})[0]\r\n"+
"  $l=New-Object Windows.Devices.Geolocation.Geolocator\r\n"+
"  $task=$l.GetGeopositionAsync()\r\n"+
"  $am=$m.MakeGenericMethod([Windows.Devices.Geolocation.Geoposition])\r\n"+
"  $n=$am.Invoke($null,@($task))\r\n"+
"  $st=''\r\n"+
"  $deadline=(Get-Date).AddSeconds(8)\r\n"+
"  while((Get-Date) -lt $deadline){\r\n"+
"    $st=$l.LocationStatus.ToString()\r\n"+
"    if($n.Wait(600)){ break }\r\n"+
"    if($st -eq 'Disabled' -or $st -eq 'NotAvailable'){ break }\r\n"+
"  }\r\n"+
"  if(-not $n.IsCompleted){ [IO.File]::WriteAllText($args[0],('FAIL,status='+$st)); exit }\r\n"+
"  $p=$n.Result\r\n"+
"  $c=$p.Coordinate.Point.Position\r\n"+
"  $out=('{0},{1},{2}' -f $c.Latitude,$c.Longitude,$p.Coordinate.Accuracy)\r\n"+
"  try{\r\n"+
"    [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12\r\n"+
"    $uri='https://photon.komoot.io/reverse?lat='+$c.Latitude+'&lon='+$c.Longitude+'&limit=1'\r\n"+
"    $req=[Net.HttpWebRequest]::Create($uri)\r\n"+
"    $req.Timeout=8000; $req.UserAgent='Mozilla/5.0'\r\n"+
"    $resp=$req.GetResponse()\r\n"+
"    $sr=New-Object IO.StreamReader($resp.GetResponseStream(),[Text.Encoding]::UTF8)\r\n"+
"    $txt=$sr.ReadToEnd(); $sr.Close(); $resp.Close()\r\n"+
"    $g=$txt|ConvertFrom-Json\r\n"+
"    $pr=$g.features[0].properties\r\n"+
"    $out=$out+','+(Esc $pr.city)+','+(Esc $pr.district)\r\n"+
"  }catch{}\r\n"+
"  [IO.File]::WriteAllText($args[0],$out)\r\n"+
"}catch{ try{ [IO.File]::WriteAllText($args[0],('FAIL,err='+$_.Exception.Message)) }catch{} }\r\n";
/* 防"显示桌面"隐藏：本窗口无任务栏按钮（SHOWINTASKBAR=no）、无最小化按钮，
   用户无法主动最小化——若窗口被系统隐藏（Win+D / 任务栏"显示桌面"），自动还原。
   只在窗口尺寸"从正常骤降到极小"（最小化/隐藏的特征）时触发一次，
   不轮询、不反复抢焦点；正常使用与拖动不会触发。 */
function restoreHiddenWin(){
  try{
    var sh=new ActiveXObject("WScript.Shell");
    sh.AppActivate("\u8001\u9ec4\u5386");   /* 还原并激活（标题=老黄历） */
  }catch(e){}
  try{ window.focus(); }catch(e2){}
}
function bindAutoRestore(){
  var last=0, prevH=0;
  function onResizeExt(){
    try{
      var h=window.outerHeight||0;
      /* 只有从正常高度（>200）骤降到极小（<80，含最小化时的 0）才视为被隐藏；
         初始 prevH=0 时只记录不触发；若外层恒为 0/异常，也永不触发 */
      if(prevH>200 && h<80){
        var now=new Date().getTime();
        if(now-last>8000){ last=now; restoreHiddenWin(); }
      }
      prevH=h;
    }catch(e){}
  }
  /* 合并原 onresize：不能覆盖窗口缩放重排（layoutStage） */
  var prevWin=window.onresize;
  try{
    window.onresize=function(){
      if(typeof prevWin==="function"){ try{ prevWin(); }catch(e){} }
      try{ onResizeExt(); }catch(e){}
    };
  }catch(e){}
}
function geoDist(lat1,lng1,lat2,lng2){
  var r=6371, dr=(lat2-lat1)*Math.PI/180, dl=(lng2-lng1)*Math.PI/180;
  var a=Math.sin(dr/2)*Math.sin(dr/2)+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dl/2)*Math.sin(dl/2);
  return 2*r*Math.asin(Math.min(1,Math.sqrt(a)));
}
/* 从 (lat1,lng1) 看 (lat2,lng2) 的初始方位角，归并为 8 方向中文名 */
function bearingDir(lat1,lng1,lat2,lng2){
  var p1=lat1*Math.PI/180, p2=lat2*Math.PI/180, dl=(lng2-lng1)*Math.PI/180;
  var y=Math.sin(dl)*Math.cos(p2);
  var x=Math.cos(p1)*Math.sin(p2)-Math.sin(p1)*Math.cos(p2)*Math.cos(dl);
  var b=(Math.atan2(y,x)*180/Math.PI+360)%360;
  return ["北","东北","东","东南","南","西南","西","西北"][Math.round(b/45)%8];
}
/* 坐标最近的城市；limitKm 内才算命中，避免定位漂到境外时选出荒唐结果 */
function nearestCity(lat,lng,limitKm){
  var best=null, bd=1e9, k, c;
  for(k in cityMap){
    if(!Object.prototype.hasOwnProperty.call(cityMap,k)) continue;
    c=cityMap[k];
    var d=geoDist(lat,lng,c.lat,c.lng);
    if(d<bd){ bd=d; best=k; }
  }
  if(!best || bd>(limitKm||300)) return null;
  return {city:best, km:bd};
}
/* 逆地理返回的街道名 → 区（区名不含"区"字）。覆盖深圳全部街道，
   其它城市街道不在此表时按"××区"直接识别（去掉"区"字）。 */
var SZ_DISTRICT={"\u9F99\u5C97":"\u9F99\u5C97","\u9F99\u57CE":"\u9F99\u5C97","\u5E03\u5409":"\u9F99\u5C97","\u5357\u6E7E":"\u9F99\u5C97","\u5742\u7530":"\u9F99\u5C97","\u6A2A\u5C97":"\u9F99\u5C97","\u5E73\u6E56":"\u9F99\u5C97","\u576A\u5730":"\u9F99\u5C97","\u5409\u534E":"\u9F99\u5C97","\u56ED\u5C71":"\u9F99\u5C97","\u5B9D\u9F99":"\u9F99\u5C97","\u5357\u5934":"\u5357\u5C71","\u5357\u5C71":"\u5357\u5C71","\u6C99\u6CB3":"\u5357\u5C71","\u86C7\u53E3":"\u5357\u5C71","\u62DB\u5546":"\u5357\u5C71","\u7CA4\u6D77":"\u5357\u5C71","\u6843\u6E90":"\u5357\u5C71","\u897F\u4E3D":"\u5357\u5C71","\u56ED\u5CAD":"\u798F\u7530","\u5357\u56ED":"\u798F\u7530","\u798F\u7530":"\u798F\u7530","\u6C99\u5934":"\u798F\u7530","\u6885\u6797":"\u798F\u7530","\u534E\u5F3A\u5317":"\u798F\u7530","\u9999\u871C\u6E56":"\u798F\u7530","\u83B2\u82B1":"\u798F\u7530","\u534E\u5BCC":"\u798F\u7530","\u798F\u4FDD":"\u798F\u7530","\u9EC4\u8D1D":"\u7F57\u6E56","\u4E1C\u95E8":"\u7F57\u6E56","\u5357\u6E56":"\u7F57\u6E56","\u6842\u56ED":"\u7F57\u6E56","\u7B0B\u5C97":"\u7F57\u6E56","\u6E05\u6C34\u6CB3":"\u7F57\u6E56","\u7FE0\u7AF9":"\u7F57\u6E56","\u4E1C\u6E56":"\u7F57\u6E56","\u4E1C\u6653":"\u7F57\u6E56","\u83B2\u5858":"\u7F57\u6E56","\u65B0\u5B89":"\u5B9D\u5B89","\u897F\u4E61":"\u5B9D\u5B89","\u822A\u57CE":"\u5B9D\u5B89","\u798F\u6C38":"\u5B9D\u5B89","\u798F\u6D77":"\u5B9D\u5B89","\u6C99\u4E95":"\u5B9D\u5B89","\u65B0\u6865":"\u5B9D\u5B89","\u677E\u5C97":"\u5B9D\u5B89","\u71D5\u7F57":"\u5B9D\u5B89","\u77F3\u5CA9":"\u5B9D\u5B89","\u6D77\u5C71":"\u76D0\u7530","\u6885\u6C99":"\u76D0\u7530","\u6C99\u5934\u89D2":"\u76D0\u7530","\u76D0\u7530":"\u76D0\u7530","\u9F99\u534E":"\u9F99\u534E","\u6C11\u6CBB":"\u9F99\u534E","\u5927\u6D6A":"\u9F99\u534E","\u89C2\u6F9C":"\u9F99\u534E","\u89C2\u6E56":"\u9F99\u534E","\u798F\u57CE":"\u9F99\u534E","\u576A\u5C71":"\u576A\u5C71","\u5751\u6893":"\u576A\u5C71","\u9F99\u7530":"\u576A\u5C71","\u77F3\u4E95":"\u576A\u5C71","\u9A6C\u5CE6":"\u576A\u5C71","\u78A7\u5CAD":"\u576A\u5C71","\u5149\u660E":"\u5149\u660E","\u516C\u660E":"\u5149\u660E","\u65B0\u6E56":"\u5149\u660E","\u51E4\u51F0":"\u5149\u660E","\u7389\u5858":"\u5149\u660E","\u9A6C\u7530":"\u5149\u660E","\u5927\u9E4F":"\u5927\u9E4F","\u5357\u6FB3":"\u5927\u9E4F","\u8475\u6D8C":"\u5927\u9E4F"};
/* 逆地理返回的城市名（如"深圳市"）归一为程序内的城市名（"深圳"） */
function cityNameOf(s){
  s=String(s||"").replace(/\s+/g,"");
  if(!s) return null;
  if(s.length>2 && s.charAt(s.length-1)==="\u5e02") s=s.slice(0,-1);
  return s||null;
}
/* 区级城市（如"深圳龙岗"）回退为市级名（"深圳"），供 wttr.in 等按市级查询；
   找不到更短的前缀城市时原样返回（北京/上海等无区级条目的城市不受影响） */
function baseCityOf(c){
  c=String(c||"");
  var b="", k;
  for(k in cityMap){
    if(!Object.prototype.hasOwnProperty.call(cityMap,k)) continue;
    if(k.length<c.length && c.indexOf(k)===0 && k.length>b.length) b=k;
  }
  return b||c;
}
/* 街道/区名 → 区（不含"区"字）；无法确定时返回 null */
function districtOf(d){
  d=String(d||"").replace(/\s+/g,"");
  if(!d) return null;
  if(SZ_DISTRICT[d]) return SZ_DISTRICT[d];
  if(d.length>2 && d.slice(-2)==="\u8857\u9053") d=d.slice(0,-2);
  if(SZ_DISTRICT[d]) return SZ_DISTRICT[d];
  if(d.length>1 && d.charAt(d.length-1)==="\u533a") return d.slice(0,-1);
  return null;
}
/* 创建一个受 regXhr 管理的 XHR（退出时统一中止）。
   优先 WinINet 栈的 Msxml2.XMLHTTP：和风响应带 Content-Encoding: gzip，
   ServerXMLHTTP 走 WinHTTP 不会自动解压，会拿到二进制导致解析失败。 */
function geoNewXhr(){
  try{ return regXhr(new ActiveXObject("Msxml2.XMLHTTP.6.0")); }catch(e){
    try{ return regXhr(new ActiveXObject("MSXML2.ServerXMLHTTP.6.0")); }catch(e2){
      try{ return regXhr(new XMLHttpRequest()); }catch(e3){ return null; }
    }
  }
}
/* ① Windows 定位服务（WiFi/GPS）。cb(ok, lat, lng, info) */
function geoWinLocation(cb){
  cb=cb||function(){};
  var s=shellObj(), fso=fsoObj();
  if(!s || !fso){ _log("[GeoWin] FAIL: shell/fso 不可用"); cb(false,0,0,null); return; }
  var folder=appFolder()||".";
  var psFile=folder+"\\hl_geoloc.ps1", outFile=folder+"\\hl_geo.txt";
  try{
    var f=fso.CreateTextFile(psFile,true);
    f.Write(GEOLOC_PS1); f.Close();
    try{ if(fso.FileExists(outFile)) fso.DeleteFile(outFile); }catch(e1){}
  }catch(e){ _log("[GeoWin] FAIL: 写 ps1 失败 "+e.message); cb(false,0,0,null); return; }
  var pw="C:\\Windows";
  try{ pw=s.ExpandEnvironmentStrings("%SystemRoot%")||pw; }catch(e2){}
  var cmd='"'+pw+'\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "'+psFile+'" "'+outFile+'"';
  _log("[GeoWin] 启动 PowerShell 定位脚本…");
  try{ s.Run(cmd,0,false); }catch(e){ _log("[GeoWin] FAIL: Run 失败 "+e.message); cb(false,0,0,null); return; }
  var waited=0;
  function poll(){
    if(waited>35000){ _log("[GeoWin] 超时：35 秒内脚本未写出结果文件"); cb(false,0,0,null); return; }
    waited+=600;
    try{
      if(fsoObj() && fso.FileExists(outFile)){
        var f2=fso.OpenTextFile(outFile,1), t=String(f2.ReadAll()||""); f2.Close();
        try{ fso.DeleteFile(outFile); }catch(e3){}
        if(/^FAIL,/.test(t)){ _log("[GeoWin] 脚本返回 "+t.substring(0,150)); cb(false,0,0,null); return; }
        var parts=String(t).split(","), pi;
        for(pi=0;pi<parts.length;pi++){ parts[pi]=String(parts[pi]).replace(/^\s+|\s+$/g,""); }
        if(parts.length>=3){
          var la=parseFloat(parts[0]), lo=parseFloat(parts[1]);
          if(!isNaN(la) && !isNaN(lo) && Math.abs(la)<=90 && Math.abs(lo)<=180){
            _log("[GeoWin] OK lat="+la+" lng="+lo+" acc="+(parseFloat(parts[2])||0)+" prov="+(parts[5]||"geolocator"));
            cb(true,la,lo,{
              acc:parseFloat(parts[2])||0,
              city:parts[3]?ascUnescape(parts[3]):"",
              district:parts[4]?ascUnescape(parts[4]):""
            });
            return;
          }
        }
        cb(false,0,0,null); return;
      }
    }catch(e){ cb(false,0,0,null); return; }
    setTimeout(poll,600);
  }
  poll();
}
/* ② ipip.net：{data:{location:["中国","广东","深圳","","移动"]}}，按城市名匹配 */
function geoIpip(cb){
  cb=cb||function(){};
  var xhr=geoNewXhr();
  if(!xhr){ cb(false,"",null); return; }
  var done=false;
  function finish(ok,city,info){ if(done) return; done=true; try{ xhr.abort(); }catch(e){} cb(ok,city||"",info); }
  try{
    try{ xhr.setTimeouts(12000,12000,12000,12000); }catch(e5){}
    xhr.open("GET",GEO_URL_IPIP,true);
    xhr.onreadystatechange=function(){
      if(xhr.readyState!=4) return;
      if(xhr.status!=200){ finish(false,"",null); return; }
      var city="";
      try{
        var t=String(xhr.responseText||"");
        var m=/\"location\"\s*:\s*\[\s*([^\]]*)\]/.exec(t);
        if(m){
          var parts=m[1].split(","), arr=[], i, p;
          for(i=0;i<parts.length;i++){
            p=String(parts[i]).replace(/^\s*\"\s*|\s*\"\s*$/g,"");
            arr.push(p);
          }
          /* [国家, 省, 市, 区, 运营商]；直辖市无市一级，省即市 */
          var prov=arr[1]||"", cty=arr[2]||"", dct=arr[3]||"";
          city=String(cty||prov).replace(/市$/,"");
          var base=city, geoLat=0, geoLng=0;
          /* 区级不依赖 cityMap：ipip 的区名统一去掉"区/县/市/旗"后缀再拼接，
             如 深圳 + 南山区 → 深圳南山。坐标取所属市级条目的经纬度兜底
             （IPIP 不返回坐标），下游走临时城市路径，和风按坐标直查。 */
          if(dct){
            var dt=String(dct).replace(/(区|县|市|旗)$/,"");
            if(dt && dt!==base){
              var mc=cityMap[base];
              if(mc){ geoLat=mc.lat; geoLng=mc.lng; city=base+dt; }
            }
          }
        }
      }catch(e6){}
      if(!city){ finish(false,"",null); return; }
      /* 区级临时城市不在 cityMap 中，用携带的市级坐标走临时城市路径 */
      if(!cityMap[city] && !(geoLat && geoLng)){ finish(false,"",null); return; }
      finish(true,city,{src:"ipip", lat:geoLat, lng:geoLng});
    };
    xhr.send(null);
  }catch(e){ finish(false,"",null); }
}
/* ③ ip-api.com：经纬度 + 最近城市（兜底） */
/* 和风 GeoAPI 按坐标反查行政区（单一数据源）：返回「市 + 区县」，
   如 113.947,22.5416 → adm2=深圳、name=南山。IP 库只给到市级时靠它补到县区。 */
function geoQwLookup(lat,lng,cb){
  cb=cb||function(){};
  if(!QWEATHER_KEY||!QWEATHER_HOST){ cb(false,null); return; }
  var xhr=geoNewXhr();
  if(!xhr){ cb(false,null); return; }
  var done=false;
  function fin(r){ if(done) return; done=true; try{ xhr.abort(); }catch(e){} cb(!!r,r||null); }
  /* 保险：反查最多等 4 秒，超时按失败处理，避免定位链卡在这里 */
  setTimeout(function(){ if(!done){ _log("[GeoQw] 超时"); fin(null); } },4000);
  try{
    try{ xhr.setTimeouts(8000,8000,8000,8000); }catch(e5){}
    xhr.open("GET","https://"+QWEATHER_HOST+"/geo/v2/city/lookup?location="+lng+","+lat+"&key="+QWEATHER_KEY,true);
    xhr.onreadystatechange=function(){
      if(xhr.readyState!=4) return;
      if(xhr.status!=200){ _log("[GeoQw] HTTP="+xhr.status); fin(null); return; }
      try{
        var t=String(xhr.responseText||"");
        var m=/"location"\s*:\s*\[\s*\{([\s\S]*?)\}\s*\]/.exec(t);
        if(!m){ _log("[GeoQw] 解析失败 len="+t.length); fin(null); return; }
        var obj=m[1];
        function fld(k){
          var r=new RegExp("\""+k+"\"\\s*:\\s*\"([^\"]*)\"").exec(obj);
          return r?r[1]:"";
        }
        var city=String(fld("adm2")||"").replace(/市$/,"");
        var dist=String(fld("name")||"").replace(/(区|县|市|旗)$/,"");
        if(dist===city) dist="";
        /* 自治州/地区/盟全称太长（如"大理白族自治州大理"），
           有县级名时显示县级名，天气仍按坐标查不受影响 */
        if(/(自治州|地区|盟)$/.test(city) && dist){ city=dist; dist=""; }
        if(!city) city=String(fld("adm1")||"").replace(/(省|市|自治区)$/,"");
        if(!city){ fin(null); return; }
        var qlat=parseFloat(fld("lat")), qlng=parseFloat(fld("lon"));
        _log("[GeoQw] "+lat+","+lng+" → "+city+(dist||"")+" ("+qlat+","+qlng+")");
        fin({city:city, district:dist, lat:isNaN(qlat)?lat:qlat, lng:isNaN(qlng)?lng:qlng});
      }catch(e){ fin(null); }
    };
    xhr.send(null);
  }catch(e){ fin(null); }
}
function geoIpapi(cb){
  cb=cb||function(){};
  var xhr=geoNewXhr();
  if(!xhr){ cb(false,"",null); return; }
  var done=false;
  function finish(ok,city,info){ if(done) return; done=true; try{ xhr.abort(); }catch(e){} cb(ok,city||"",info); }
  try{
    try{ xhr.setTimeouts(12000,12000,12000,12000); }catch(e5){}
    xhr.open("GET",GEO_URL_IPAPI,true);
    xhr.onreadystatechange=function(){
      if(xhr.readyState!=4) return;
      if(xhr.status!=200){ finish(false,"",null); return; }
      var lat=NaN, lng=NaN, nm="";
      try{
        var t=String(xhr.responseText||"");
        var m=/"lat"\s*:\s*(-?[0-9.]+)/.exec(t); if(m) lat=parseFloat(m[1]);
        m=/"lon"\s*:\s*(-?[0-9.]+)/.exec(t);       if(m) lng=parseFloat(m[1]);
        m=/"city"\s*:\s*"([^"]*)"/.exec(t);        if(m) nm=m[1];
        m=/"regionName"\s*:\s*"([^"]*)"/.exec(t); if(m) nm=nm||m[1];
      }catch(e6){}
      if(isNaN(lat)||isNaN(lng)||Math.abs(lat)>90||Math.abs(lng)>180){ finish(false,"",null); return; }
      var near=nearestCity(lat,lng,500);
      if(!near){ finish(false,"",null); return; }
      /* IP 库通常只到市级（本机 ipip 的区字段为空，ip-api 给的是
         "Keji yuan" 这类街道/园区名）。用和风按坐标反查行政区，
         可得到「深圳南山」这样的县区级名称，天气也用和风自己的坐标。 */
      geoQwLookup(lat,lng,function(qok,q){
        var baseCity=(q&&q.city)||near.city||nm;
        if(!baseCity){ finish(false,"",null); return; }
        var name=baseCity;
        if(q && q.district && q.district!==baseCity) name=baseCity+q.district;
        finish(true,name,{
          lat:(q&&q.lat)||lat, lng:(q&&q.lng)||lng,
          km:near.km, raw:nm, src:"ipapi", temp:!cityMap[name]
        });
      });
    };
    xhr.send(null);
  }catch(e){ finish(false,"",null); }
}
/* 执行定位：WiFi/GPS 优先，IP 兜底。
   两条链路并行发出（IP 结果先算好备用），但 IP 不抢先：
   必须等 WiFi/GPS 落定（成功或超时失败）后才允许使用 IP 结果。
   原因：WiFi/GPS 通常 5~15 秒才出结果，IP 链路 1~3 秒就返回，
   先到先得会让运营商 NAT 的 IP 偏差（实测：深圳龙岗被定到广州越秀）
   永远盖过更准的 WiFi 定位。
   耗时：WiFi 成功 = WiFi 耗时；WiFi 失败 = WiFi 超时窗口（IP 早已就绪）。 */
function geoDetect(cb){
  cb=cb||function(){};
  var done=false, ipStarted=false, ipRes=null, winSettled=false;
  function finish(ok,city,info){ if(done) return; done=true; cb(ok,city||"",info); }
  function maybeUseIp(){
    if(done || !winSettled || !ipRes) return;
    finish(ipRes.ok, ipRes.city||"", ipRes.info||null);
  }
  function ipChain(){
    if(ipStarted) return; ipStarted=true;
    geoIpapi(function(ok,city,info){
      if(ok){ ipRes={ok:true,city:city,info:info}; maybeUseIp(); return; }
      geoIpip(function(ok2,city2,info2){
        ipRes=ok2?{ok:true,city:city2,info:info2}:{ok:false};
        maybeUseIp();
      });
    });
  }
  geoWinLocation(function(ok,lat,lng,info){
    if(ok){
      /* Windows 有坐标时同样交给和风反查行政区，结果口径与 IP 链路一致 */
      geoQwLookup(lat,lng,function(qok,q){
        var name="";
        if(q && q.city){
          name=q.city+((q.district && q.district!==q.city)?q.district:"");
        }else if(info && info.city){
          var cty=cityNameOf(info.city), dct=districtOf(info.district);
          if(cty) name=cty+(dct||"");
        }
        if(!name){
          var near=nearestCity(lat,lng,500);
          if(near) name=near.city;
        }
        if(name){ finish(true,name,{lat:lat,lng:lng,km:0,acc:info?info.acc:0,src:"win",temp:!cityMap[name]}); return; }
        winSettled=true; maybeUseIp();
      });
      return;
    }
    winSettled=true; maybeUseIp();
  });
  ipChain();
}
/* 定位成功后应用城市并落盘 */
function applyGeoCity(cityName){
  if(!cityMap[cityName]) return false;
  cfg.city=cityName;
  cfg.code=cityMap[cityName].code;
  cfg.lat=cityMap[cityName].lat;
  cfg.lng=cityMap[cityName].lng;
  cfg.geoDone=1;
  cfg.manualCity=0;   /* 自动定位结果：允许下次启动再次自动定位 */
  lastWeather=null; live=null; lastOfficialType="";
  try{ saveCfg(); }catch(e){}
  return true;
}
/* 临时城市（不在 cityMap 中）：用真实地名+坐标设置 cfg，
   无 weather.com.cn 编码（code 置空），和风按坐标直查 */
function applyGeoCityTemp(cityName, lat, lng){
  cfg.city=cityName;
  cfg.code="";
  cfg.lat=lat;
  cfg.lng=lng;
  cfg.geoDone=1;
  cfg.manualCity=0;   /* 自动定位结果：允许下次启动再次自动定位 */
  lastWeather=null; live=null; lastOfficialType="";
  try{ saveCfg(); }catch(e){}
  return true;
}
/* 自动定位：silent=true 时不打扰用户（启动流程用），
   silent=false 时在设置面板里给出明确反馈（手动点「重新定位」用） */
function tryAutoGeo(silent){
  var tip=document.getElementById("geoTip");
  if(!silent && tip) tip.innerHTML="正在自动定位…";
  geoDetect(function(ok,cityName,info){
    var box=document.getElementById("geoRow");
    _log("[Geo] ok="+ok+" city="+(cityName||"")+" src="+(info&&info.src)+" lat="+(info&&info.lat)+" lng="+(info&&info.lng)+" cfg.city="+cfg.city);
    if(ok){
      /* IP 兜底在运营商 NAT 下可能偏出几百公里（如深圳家庭宽带出口落在广州越秀），
         静默启动时若已有缓存城市，而 IP 结果要跨市推翻缓存 → 不信任，保留缓存。
         WiFi 定位（src="win"）精度足够，仍允许纠正；手动「重新定位」也不拦截。 */
      if(silent && cfg.city && cityName && info && info.src!=="win" && cityName!==cfg.city){
        var sameCity = cityName.indexOf(cfg.city)===0 || cfg.city.indexOf(cityName)===0
                    || cityName.substring(0,2)===cfg.city.substring(0,2);
        if(!sameCity){
          _log("[Geo] distrust "+info.src+" result "+cityName+", keep cached "+cfg.city);
          return;
        }
      }
      /* 只在启动时的静默自动定位中防止降级：避免 IP 定位把"深圳龙岗"降级为"深圳"。
         手动点「重新定位」时用户明确要更新位置，不阻止降级/换区。 */
      if(silent && cfg.city && cityName && cityName.length<cfg.city.length && cfg.city.indexOf(cityName)===0){
        cityName=cfg.city;
      }
      var changed=(cityName!==cfg.city);
      var applied=applyGeoCity(cityName);
      /* cityMap 中无此城市：用真实地名+坐标临时设置（和风按坐标查天气） */
      if(!applied && info && info.lat && info.lng){
        applyGeoCityTemp(cityName, info.lat, info.lng);
        changed=true;
      }
      if(!silent && tip){
        var dTxt="";
        if(info){
          if(info.src==="win"){
            dTxt=(info.acc&&info.acc>0)?("（WiFi 定位，精度约 "+Math.round(info.acc)+" 米）"):"（Windows 定位）";
          }else if(info.src==="ipip"){
            dTxt="（IP 定位）";
          }else if(info.km){
            dTxt="（距该点约 "+Math.round(info.km)+" 公里）";
          }
        }
        tip.innerHTML="已定位到 <b>"+escHtml(cityName)+"</b>"+dTxt+(changed?"，天气已切换":"");
      }
      whenIdle(function(){
        fetchWeather(true);
        if(!QWEATHER_KEY) fetchLive();
        if(box) updateGeoRow();
        redrawCurrent();
      });
    }else{
      /* 失败不写 geoDone，下次启动自动重试 */
      if(!silent && tip) tip.innerHTML="<span style='color:#a8231a'>自动定位失败（无网络或未开启 Windows 定位），可在下方手动选择城市</span>";
    }
  });
}
function updateGeoRow(){
  var tip=document.getElementById("geoTip");
  if(!tip) return;
  var c=settingsCity||cfg.city;
  if(cfg.geoDone===1) tip.innerHTML="已自动定位：<b>"+escHtml(c)+"</b>（启动时只查询一次；换城市可点右侧重新定位）";
  else tip.innerHTML="尚未自动定位，启动时会自动尝试一次";
}
function closeApp(){
  if(closing) return;
  closing=true;
  cleanupAll();
  try{ window.close(); }catch(e){}
  setTimeout(function(){
    try{ if(typeof oHuangLi=="object") oHuangLi.Close(); }catch(e){}
    try{ window.close(); }catch(e){}
  },80);
}
/* 仅保留 Alt+↑/↓ 微调窗口高度。
   曾用 Esc/F4 退出，但切换到别的窗口再切回来时按键会被误送到本程序，
   极易把程序直接关掉，代价远大于收益——退出只认右上角 ✕ 按钮。 */
function bindKeys(){
  document.onkeydown=function(){
    var e=window.event;
    if(!e) return;
    var k=e.keyCode||e.which;
    if(e.altKey && (k==38||k==40)){
      var step=(e.shiftKey)?40:12;
      try{ window.resizeBy(0, k==38?-step:step); }catch(x){}
      layoutStage();
      try{ e.returnValue=false; }catch(x){}
      return false;
    }
  };
}
function bindDrag(){
  document.onmousedown=function(){
    var e=window.event, t=e.srcElement;
    if(!t) return;
    if(t.id=="resizeGrip") return;   /* 交给 bindResize 的 onmousedown */
    if(t.tagName=="BUTTON"||t.tagName=="INPUT"||t.tagName=="SELECT"||t.tagName=="TEXTAREA"||t.tagName=="A") return;
    var p=t;
    while(p){
      if(p.id=="settings") return;
      p=p.parentNode;
    }
    offX=e.screenX-window.screenLeft;
    offY=e.screenY-window.screenTop;
    if(t.tagName=="TD"||t.tagName=="TH"||t.tagName=="OPTION"){
      /* 日历表格几乎占满整个窗口，若直接排除就等于"无处可拖"。
         这里先按住不动，移动超过阈值才转为拖动窗口，
         从而兼顾"拖动窗口"与"点击单元格切换日期"两种操作。 */
      dragPending=true; dragSx=e.screenX; dragSy=e.screenY;
      return;
    }
    dragging=true; dragPending=false;
  };
  document.onmousemove=function(){
    var e=window.event;
    if(rzOn) return resizeMove(e);   /* 缩放优先，缩放期间禁止移动窗口 */
    if(dragPending && (Math.abs(e.screenX-dragSx)>4 || Math.abs(e.screenY-dragSy)>4)){
      dragPending=false; dragging=true;
    }
    if(dragging){
      var nx=e.screenX-offX, ny=e.screenY-offY, now=new Date().getTime();
      /* moveTo 只做 60fps 节流（同一像素不重复调用）。
       卡顿的主因是拖动期间发生界面重绘，已由 isGesturing/whenIdle 拦掉，
       这里不必过度节流，否则反而会出现"追不上鼠标"的顿挫感。 */
      if(now-mvLast>=16 && (nx!=mvX || ny!=mvY)){
        mvLast=now; mvX=nx; mvY=ny;
        try{ window.moveTo(nx,ny); }catch(x){}
      }
    }
    /* 正在拖动窗口时不必更新栏位：此时鼠标位置相对窗口是跳变的，
       判断出来的"靠近上/下边缘"没有意义，而且能省掉每帧的 clientHeight 读取
       （读取布局属性会触发强制重排，本身就是拖动卡顿的一环）。 */
    if(!dragging && !rzOn) updateBars();
  };
  document.onmouseup=function(){
    var wasDragging=dragging;
    dragging=false; dragPending=false; resizeEnd();
    /* 拖动过窗口也要记住新位置，否则只有缩放才会触发落盘 */
    if(wasDragging) saveWindowSize();
    flushIdle();   /* 手势结束，立刻执行期间推迟的界面更新 */
  };
  /* 指针离开窗口：立即收起（relatedTarget 为空表示真的离开了文档） */
  document.onmouseleave=function(){ dragging=false; hideBars(); clearBarTimers(); };
  document.onmouseout=function(){
    var e=window.event;
    /* 缩放期间即使光标短暂出窗也不能中断——手柄靠 setCapture 继续跟踪，
       只有真正松开（mouseup）才结束 resizeEnd()。 */
    if(!e.relatedTarget && !rzOn){ dragging=false; hideBars(); clearBarTimers(); }
  };
  window.onblur=function(){ hideBars(); clearBarTimers(); };
}

function tick(){
  /* 拖动/缩放窗口期间完全跳过后台任务：
     这里会发网络请求，响应回来就会重绘界面，正好撞上拖动就会造成卡顿。
     30 秒一轮，下一轮自然会补上，不会漏掉同步。 */
  if(isGesturing()) return;
  /* 跨天自动翻页 + 天气定时刷新 + 调休安排每日复查 */
  var n=new Date();
  var key=todayKeyOf(n);
  if(!lastTodayKey) lastTodayKey=key;
  if(key!==lastTodayKey){
    /* 真实日期已变。若用户原本停在"今天"，自动跟进新的一天；否则保持所看日期不动，只刷新标记 */
    var oldY=Math.floor(lastTodayKey/10000), oldM=Math.floor(lastTodayKey/100)%100;
    if(inMonthView){
      if(viewY===oldY && viewM===oldM){ viewY=n.getFullYear(); viewM=n.getMonth()+1; }
      renderMonth();
    }else{
      if(isKeyOf(lastTodayKey, cur)){ cur=new Date(n.getFullYear(), n.getMonth(), n.getDate()); }
      renderedYMD=null;
      renderDay();
    }
    lastTodayKey=key;
    fetchWeather(true);
    if(!QWEATHER_KEY) fetchLive();
  }else if(!inMonthView && isToday(cur.getFullYear(),cur.getMonth()+1,cur.getDate()) && key!=renderedYMD){
    renderDay();
  }
  fetchWeather(false);
  if(holNeedSync()) syncHolidays(false, function(st,updated){ if(updated) redrawCurrent(); });
  if(schoolNeedSync()) syncSchool(false, function(){ redrawCurrent(); });
  /* 实况每 10 分钟刷新一次（原 30 分钟，过于滞后）；
     官方实况(weather1d)也在此独立轮询——官方整点观测发布有几分钟延迟，
     若只跟天气一起每 30 分钟刷，会长时间显示上一小时的旧观测，
     与官网页面（分钟级更新的实况）出现 0.5° 级温差 */
  var nowMs=n.getTime();
  if(nowMs-lastLiveTs>=10*60*1000){
    lastLiveTs=nowMs;
    /* 和风有 key 时 fetchQWeather 已覆盖实况+预警，不再调 backup 源 */
    if(!QWEATHER_KEY){
      fetchLive();
      fetchTyphoon();
      fetchOfficialLive();
    }
  }
}
var lastLiveTs=0;
function redrawCurrent(){
  whenIdle(function(){
    try{
      if(inMonthView) renderMonth(); else renderDay();
    }catch(e){}
  });
}

var mfMsgTimer=0;
function mfMsg(txt, ok){
  var el=document.getElementById("mfMsg");
  if(!el) return;
  el.innerHTML=txt?("<span class='"+(ok?"ok":"err")+"'>"+escHtml(txt)+"</span>"):"";
  try{ if(mfMsgTimer){ clearTimeout(mfMsgTimer); mfMsgTimer=0; } }catch(e){}
  if(txt){
    try{ mfMsgTimer=setTimeout(function(){ var e2=document.getElementById("mfMsg"); if(e2) e2.innerHTML=""; }, 5000); }
    catch(e2){}
  }
}
/* 日期提示随"重复方式"联动，回答用户"每年要不要填年份"这个疑问 */
var MF_DATE_HELP={
  Y:'<div class="fl">示例：填「03-14」表示每年公历 3 月 14 日（如生日）；<b>不用填年份</b>。也接受 3-14、2027-03-14。</div>',
  L:'<div class="fl">示例：填「8-15」表示每年<b>农历</b>八月十五（如中秋）；<b>不用填年份</b>。</div>',
  O:'<div class="fl">示例：填「2027-03-14」，<b>只在这一天提醒，必须填年份</b>。过了就不再提醒。</div>'
};
function mfDateHelp(){
  var yEl=document.getElementById("mfType"), dEl=document.getElementById("mfDate"), tip=document.getElementById("mfDateTip");
  if(!yEl||!dEl||!tip) return;
  var t=String(yEl.value||"Y");
  tip.innerHTML=MF_DATE_HELP[t]||"";
  dEl.placeholder = (t=="Y") ? "03-14（生日，不用填年）"
             : (t=="L") ? "8-15（农历，不用填年）"
             : "2027-03-14（需填年份）";
}
function mfSetBtn(editing){
  var b=document.getElementById("mfAdd"), c=document.getElementById("mfCancel");
  if(b) b.innerHTML=editing?"保存修改":"添加";
  if(c) c.style.display=editing?"inline-block":"none";
}
function mfStartEdit(idx){
  var it=MYF[idx];
  if(!it) return;
  mfEditIdx=idx;
  var nEl=document.getElementById("mfName"), dEl=document.getElementById("mfDate"),
      tEl=document.getElementById("mfText"), yEl=document.getElementById("mfType"),
      pEl=document.getElementById("mfPic");
  if(nEl) nEl.value=it.name;
  if(yEl) yEl.value=it.type;
  if(dEl) dEl.value=(it.type=="L")?it.date:it.date;
  if(tEl) tEl.value=it.text||"";
  if(pEl) pEl.value=it.pic||"";
  mfSetBtn(true);
  mfMsg("正在修改「"+it.name+"」，改完点「保存修改」", true);
  try{ nEl.focus(); }catch(e){}
}
function mfCancelEdit(){
  mfEditIdx=-1;
  var nEl=document.getElementById("mfName"), dEl=document.getElementById("mfDate"),
      tEl=document.getElementById("mfText"), pEl=document.getElementById("mfPic");
  if(nEl) nEl.value=""; if(dEl) dEl.value=""; if(tEl) tEl.value=""; if(pEl) pEl.value="";
  mfSetBtn(false);
  mfMsg("");
}
function mfAddAction(){
  var nEl=document.getElementById("mfName"), dEl=document.getElementById("mfDate"),
      tEl=document.getElementById("mfText"), yEl=document.getElementById("mfType"),
      pEl=document.getElementById("mfPic");
  if(!nEl||!dEl||!yEl) return;
  var name=String(nEl.value||"").replace(/^\s+|\s+$/g,"");
  if(!name){ mfMsg("请先填写名称"); try{ nEl.focus(); }catch(e1){} return; }
  var type=String(yEl.value||"Y");
  if(type!="Y" && type!="L" && type!="O") type="Y";
  var dt=myNormalizeDate(dEl.value, type);
  if(!dt){
    mfMsg(type=="O"?"日期格式应为 2027-03-14":(type=="L"?"农历日期格式应为 8-15":"公历日期格式应为 03-14"));
    try{ dEl.focus(); }catch(e2){}
    return;
  }
  var i, it;
  for(i=0;i<MYF.length;i++){
    if(i===mfEditIdx) continue;
    it=MYF[i];
    if(it.type==type && it.name==name && it.date==dt){ mfMsg("「"+name+"」"+myTypeLabel(type)+" "+dt+" 已存在"); return; }
  }
  var rec={type:type, name:name, date:dt, text:String((tEl&&tEl.value)||"").replace(/^\s+|\s+$/g,""),
            pic:String((pEl&&pEl.value)||"").replace(/^\s+|\s+$/g,"")};
  var editing=mfEditIdx>=0;
  if(editing) MYF[mfEditIdx]=rec; else MYF.push(rec);
  mfEditIdx=-1;
  myRebuildMap();
  var saved=mySave();
  renderMfList(); redrawCurrent();
  nEl.value=""; dEl.value=""; if(tEl) tEl.value=""; if(pEl) pEl.value="";
  mfSetBtn(false);
  mfMsg(saved
      ?(editing?("已保存「"+name+"」的修改"):("已添加「"+name+"」"+myDesc(rec)))
      :(editing?("已修改，但写入 myfest.txt 失败，重启后会恢复"):("已添加，但写入 myfest.txt 失败，重启后会丢失")),
      saved);
  try{ nEl.focus(); }catch(e3){}
}
/* 设置面板中"选中但未保存"的预览城市：空=与 cfg.city 一致（保存/取消时重置） */
var settingsCity="";
function bindSettingsUI(){
  var addBtn=document.getElementById("mfAdd");
  if(addBtn) addBtn.onclick=mfAddAction;
  var typeSel=document.getElementById("mfType");
  if(typeSel) typeSel.onchange=mfDateHelp;   /* 切换重复方式即时更新日期示例 */
  mfDateHelp();
  var kf=function(e){
    var k=e.keyCode||e.which;
    if(k==13){ try{ e.returnValue=false; }catch(e4){} mfAddAction(); }
  };
  var ids=["mfName","mfDate","mfText","mfPic"];
  for(var q=0;q<ids.length;q++){
    var inp=document.getElementById(ids[q]);
    if(inp) inp.onkeypress=kf;
  }
  var canBtn=document.getElementById("mfCancel");
  if(canBtn) canBtn.onclick=mfCancelEdit;
  document.getElementById("mfList").onclick=function(e){
    var t=e.srcElement;
    if(!t) return;
    if(t.className=="x"){
      var idx=parseInt(t.getAttribute("data-i"),10);
      if(isNaN(idx)) return;
      if(!confirm("删除「"+MYF[idx].name+"」？")) return;
      if(mfEditIdx===idx) mfCancelEdit();
      else if(mfEditIdx>idx) mfEditIdx--;
      MYF.splice(idx,1);
      myRebuildMap();
      var okDel=mySave();
      renderMfList();
      redrawCurrent();
      if(!okDel) mfMsg("已删除，但写入 myfest.txt 失败，重启后会恢复", false);
      return;
    }
    if(t.className=="e"){
      var ei=parseInt(t.getAttribute("data-i"),10);
      if(!isNaN(ei)) mfStartEdit(ei);
      return;
    }
    var p=t;
    while(p && p.id!="mfList"){
      if(String(p.className||"").indexOf("mfItem")>=0){
        var ci=parseInt(p.getAttribute("data-e"),10);
        if(!isNaN(ci)) mfStartEdit(ci);
        return;
      }
      p=p.parentNode;
    }
  };
}
function renderMfList(){
  var el=document.getElementById("mfList");
  if(!el) return;
  if(!MYF.length){ el.innerHTML="<div class='mfEmpty'>还没有自定义节日，在下面添加吧。</div>"; return; }
  var html="", i, it;
  for(i=0;i<MYF.length;i++){
    it=MYF[i];
    html+="<div class='mfItem"+(i===mfEditIdx?" editing":"")+"' data-e='"+i+"'>"
        +"<span class='e' data-i='"+i+"' title='编辑'>✎</span>"
        +"<span class='x' data-i='"+i+"' title='删除'>✕</span>"
        +"<b>"+escHtml(it.name)+"</b> <span class='d'>"+myDesc(it)+"</span>"
        +"<span class='d'> · "+myTypeLabel(it.type)+"</span>"
        +(it.text?("<div class='t'>"+escHtml(it.text)+"</div>"):"")
        +(it.pic?("<div class='t' style='color:#2e7d32'>配图："+escHtml(it.pic)+"</div>"):"")
        +"</div>";
  }
  el.innerHTML=html;
}
/* ============================================================
   开机自动启动（写 HKCU Run，无需管理员权限）
   本程序是 GUI 程序，不能做成 Windows Service（Service 在 Session 0
   无桌面，无法显示窗口），因此改为登录后自动启动。
   ============================================================ */
var RUN_SUB="Software\\Microsoft\\Windows\\CurrentVersion\\Run";
var RUN_NAME="WinCalendar";
function shellObj(){ try{ return new ActiveXObject("WScript.Shell"); }catch(e){ return null; } }
function runRegFull(){ return "HKCU\\"+RUN_SUB+"\\"+RUN_NAME; }
function currentHtaPath(){
  try{
    if(typeof location=="undefined"||!location) return "";
    return String(location.pathname||"").replace(/\//g,"\\");
  }catch(e){ return ""; }
}
/* 从启动项命令行里抠出 .hta 路径 */
function autostartEntryHta(){
  try{
    var s=shellObj();
    if(!s) return "";
    var v=s.RegRead(runRegFull());
    if(!v) return "";
    var m=/"([^"]+\.hta)"/i.exec(v);
    if(m) return m[1];
    m=/(\S+\.hta)/i.exec(v);
    return m?m[1]:"";
  }catch(e){ return ""; }
}
function normPath(p){ return String(p||"").replace(/\//g,"\\").toLowerCase(); }
/* 自愈：程序被移盘/改名、或存在多份副本时，
   把启动项统一改写为"当前正在运行的这一份"，保证下次登录打开的是用户在用的版本。 */
function fixAutostartPath(){
  var cur=currentHtaPath();
  if(!/\.hta$/i.test(cur)) return false;
  var old=autostartEntryHta();
  if(!old) return false;                          /* 没开启动项，不动 */
  if(normPath(old)===normPath(cur)) return false;  /* 已指向当前 */
  /* 启动项指向别的副本时，一律跟随到"当前正在运行的这一份"。
     早前的做法是「旧路径文件仍存在就不动」，想让用户自己去设置里重开开关；
     但只要旧副本还在（比如换 U 盘、或同一部电脑上留了两份），
     启动项就会永远停在旧路径上，登录后打开的不是用户正在用的那一份。
     现在以实际运行的这份为准，符合直觉。 */
  var s=shellObj();
  if(!s) return false;
  try{
    s.RegWrite(runRegFull(), autostartCmd(cur), "REG_SZ");
    return true;
  }catch(e2){ return false; }
}
function autostartCmd(htaPath){
  var raw="";
  if(htaPath!=null) raw=String(htaPath);
  else{
    try{ raw=String((typeof location!="undefined" && location && location.pathname)||""); }catch(e){ raw=""; }
  }
  var hta=raw.replace(/\//g,"\\");
  if(!/\.hta$/i.test(hta)) return "";
  var mshta="mshta.exe";
  try{
    var s=new ActiveXObject("WScript.Shell");
    if(s) mshta=s.ExpandEnvironmentStrings("%SystemRoot%\\System32\\mshta.exe");
  }catch(e){}
  return '"'+mshta+'" "'+hta+'"';
}
function isAutostart(){
  try{
    var s=shellObj();
    if(!s) return false;
    var v=s.RegRead(runRegFull());
    return !!(v && String(v).length);
  }catch(e){ return false; }
}
function setAutostart(on){
  var s=shellObj();
  if(!s) return false;
  var p=runRegFull();
  if(on){
    var cmd=autostartCmd();
    if(!cmd) return false;
    try{ s.RegWrite(p, cmd, "REG_SZ"); return true; }catch(e){ return false; }
  }
  if(!isAutostart()) return true;   /* 本来就是关的，无需删除 */
  try{ s.RegDelete(p); return !isAutostart(); }catch(e2){ return false; }
}
/* ============================================================
   台风信息（中国气象局台风网 typhoon.nmc.cn，免密钥、支持 HTTP）
   和风 weatheralert 已覆盖台风/高温/暴雨/大风/雷电/寒潮/沙尘暴等
   所有预警类型，作为优先来源；nmc 仅作为远洋台风跟踪的补充。
   ============================================================ */
var TYPHOON_URL="http://typhoon.nmc.cn/weatherservice/typhoon/jsons/list_default";
var TYPHOONS=[];          /* 活跃台风 [{cn,en,num}] */
var TYPHOON_AT="";
var TYPHOON_STATUS={TS:"热带风暴",STS:"强热带风暴",TY:"台风",STY:"强台风",SuperTY:"超强台风",TD:"热带低压"};
/* 16 方位移向映射 */
var TYPHOON_DIR={N:"北",NNE:"北东北",NE:"东北",ENE:"东东北",E:"东",ESE:"东东南",SE:"东南",SSE:"南东南",
  S:"南",SSW:"南西南",SW:"西南",WSW:"西西南",W:"西",WNW:"西西北",NW:"西北",NNW:"北西北"};
/* 解析单个台风详情（view_{id}），返回最新轨迹点的强度/风速/气压/位置/移向移速 */
function parseTyphoonDetail(txt){
  try{
    /* 去掉 JSONP 包裹 typhoon_jsons_view_xxx({...}) */
    var s=txt, i=s.indexOf("{"), j=s.lastIndexOf("}");
    if(i<0||j<0||j<=i) return null;
    var d=JSON.parse(s.substring(i,j+1));
    var arr=d&&d.typhoon;
    if(!arr||!arr.length||!arr[8]||!arr[8].length) return null;
    var tp=arr[8][arr[8].length-1];   /* 最新轨迹点 */
    if(!tp||tp.length<10) return null;
    var lvCode=String(tp[3]||"");
    return {
      time:String(tp[1]||""),
      intensity:TYPHOON_STATUS[lvCode]||lvCode,
      lon:tp[4], lat:tp[5],
      pressure:tp[6], wind:tp[7],
      moveDir:TYPHOON_DIR[String(tp[8]||"")]||String(tp[8]||""),
      moveSpeed:tp[9]
    };
  }catch(e){ return null; }
}
/* 和风实时气象预警（高温/暴雨/大风/雷电/寒潮/沙尘暴/大雾/霾/台风…） */
var LAST_ALERTS=[];         /* [{eventType:{code,name}, severity, headline, description, color:{code}, issuedTime}] */
var LAST_ALERTS_AT="";
/* 把 JSONP 里的一条数组按顶层逗号切分，正确跳过引号与嵌套括号 */
function splitTopLevel(s){
  var out=[], buf="", i, c, depth=0, q=false;
  for(i=0;i<s.length;i++){
    c=s.charAt(i);
    if(q){
      buf+=c;
      if(c==="\\"){ buf+=s.charAt(++i); continue; }
      if(c==='"') q=false;
      continue;
    }
    if(c==='"'){ q=true; buf+=c; continue; }
    if(c==="["||c==="{"){ depth++; buf+=c; continue; }
    if(c==="]"||c==="}"){ depth--; buf+=c; continue; }
    if(c===","&&depth===0){ out.push(buf); buf=""; continue; }
    buf+=c;
  }
  if(buf.length) out.push(buf);
  return out;
}
function parseTyphoonList(txt){
  try{
    var rows=[], re=/\[\s*(\d+)\s*,/g, m, start;
    while((m=re.exec(txt))){
      start=m.index;
      var depth=0, i, c, end=-1, q=false;
      for(i=start;i<txt.length;i++){
        c=txt.charAt(i);
        if(q){ if(c==="\\"){ i++; continue; } if(c==='"') q=false; continue; }
        if(c==='"'){ q=true; continue; }
        if(c==="[") depth++;
        else if(c==="]"){ depth--; if(depth===0){ end=i; break; } }
      }
      if(end<0) break;
      var inner=txt.substring(start,end+1);
      var f=splitTopLevel(inner.substring(1,inner.length-1));
      if(f.length>=8) rows.push(f);
      re.lastIndex=end;
    }
    /* 解析不出任何条目：区分"合法的空列表"与"响应损坏"。
       返回 null 表示本次失败，调用方会保留上一次的台风数据，不会误清空。 */
    if(!rows.length){
      return /"typhoonList"\s*:\s*\[\s*\]/.test(txt)?[]:null;
    }
    var out=[], i, r;
    for(i=0;i<rows.length;i++){
      r=rows[i];
      var status=String(r[7]||"").replace(/"/g,"");
      if(status==="stop") continue;            /* 已停编，不显示 */
      out.push({
        id:r[0].replace(/"/g,""),
        en:String(r[1]||"").replace(/"/g,""),
        cn:String(r[2]||"").replace(/"/g,"").replace(/\\n/g,""),
        num:r[3].replace(/"/g,""),
        status:status,
        level:TYPHOON_STATUS[status]||"编号中"
      });
    }
    return out;
  }catch(e){ return null; }
}
function fetchTyphoon(cb){
  cb=cb||function(){};
  xhrGet(TYPHOON_URL,function(ok,data){
    if(ok&&data){
      var txt=data.text||"";
      /* nmc 返回 Content-Type: application/octet-stream，无 charset；
         ServerXMLHTTP.responseText 会按系统代码页（中文系统为 GBK）解码 UTF-8 字节，
         导致台风中文名乱码，typhoonLabel 退化成"2630号"这类无意义编号。
         用 ADODB.Stream 强制按 UTF-8 解码 responseBody，拿到正确中文名。 */
      if(data.body){ try{
        var stm=new ActiveXObject("ADODB.Stream");
        stm.Type=1; stm.Open(); stm.Write(data.body);
        stm.Position=0; stm.Type=2; stm.Charset="utf-8";
        txt=stm.ReadText(); stm.Close();
      }catch(e){} }
      var t=parseTyphoonList(txt);
      if(t){
        TYPHOONS=t; TYPHOON_AT=nowClock();
        /* 先渲染一版（仅有名称），再逐个补详情 */
        whenIdle(function(){ renderTyphoonLine(); });
        /* 逐个拉详情：强度/风速/气压/位置/移向移速。
           每个详情回来就更新对应台风并重渲染，避免一个失败拖累全部。 */
        for(var di=0;di<TYPHOONS.length;di++){
          (function(idx){
            var ty=TYPHOONS[idx];
            if(!ty||!ty.id) return;
            xhrGet("http://typhoon.nmc.cn/weatherservice/typhoon/jsons/view_"+ty.id,function(dok,ddata){
              if(!dok||!ddata) return;
              var dtxt=ddata.text||"";
              if(ddata.body){ try{
                var s2=new ActiveXObject("ADODB.Stream");
                s2.Type=1; s2.Open(); s2.Write(ddata.body);
                s2.Position=0; s2.Type=2; s2.Charset="utf-8";
                dtxt=s2.ReadText(); s2.Close();
              }catch(e2){} }
              var det=parseTyphoonDetail(dtxt);
              if(det){
                var cur=TYPHOONS[idx];
                if(cur){
                  cur.intensity=det.intensity; cur.wind=det.wind; cur.pressure=det.pressure;
                  cur.lat=det.lat; cur.lon=det.lon;
                  cur.moveDir=det.moveDir; cur.moveSpeed=det.moveSpeed; cur.time=det.time;
                  cur.src="nmc";   /* 远洋跟踪，非本地预警 */
                }
                whenIdle(function(){ renderTyphoonLine(); });
              }
            });
          })(di);
        }
      }
    }
    cb(ok);
  });
}
/* 单个台风的展示文案。
   - nmc 来源（远洋跟踪）：名称（强度）· 风速 · 气压 · 位置 · 移向移速
   - alert 来源（本地预警）：名称（严重程度）+ 描述 */
function typhoonLabel(t){
  var cn=String(t.cn||""), num=String(t.num||"");
  var nm=(/[\u4e00-\u9fa5]/.test(cn))?cn:((num)?num+"号":"新台风");
  /* 本地台风预警：和风给的是严重程度 + 描述 */
  if(t.src==="alert"){
    var sevMap={extreme:"特别严重",severe:"严重",moderate:"中等",minor:"轻微",unknown:""};
    var sev=t.level&&sevMap[t.level]?sevMap[t.level]:"";
    return nm+(sev?("（"+sev+"）"):"")+(t.desc?("："+t.desc):"");
  }
  /* nmc/和风 远洋跟踪：强度/风速/气压/位置/移向/64节大风半径 */
  var parts=[];
  if(t.intensity) parts.push(t.intensity);
  if(t.wind!=null) parts.push(Math.round(t.wind*10)/10+"m/s");
  if(t.pressure!=null) parts.push(t.pressure+"hPa");
  /* 位置：相对当前定位城市的方位+距离（如"位于东南1290km"），比经纬度直观；
     cfg.lat/lng 是本次定位落盘的坐标，恒有值（默认北京） */
  if(t.lat!=null&&t.lon!=null){
    var d=geoDist(cfg.lat,cfg.lng,t.lat,t.lon);
    var dd=d>=100?Math.round(d/10)*10:Math.round(d);
    parts.push("位于"+bearingDir(cfg.lat,cfg.lng,t.lat,t.lon)+dd+"km");
  }
  if(t.moveDir&&t.moveSpeed!=null) parts.push(t.moveDir+" "+t.moveSpeed+"km/h");
  /* 64节（约118km/h，强台风级）大风半径，从和风 tropical-cyclone 返回的 windRadius64 */
  var wr=t.windRadius64;
  if(wr){
    var qMap={neRadius:"东北",seRadius:"东南",swRadius:"西南",nwRadius:"西北"};
    var wrs=[];
    ["neRadius","seRadius","swRadius","nwRadius"].forEach(function(k){ if(wr[k]) wrs.push(qMap[k]+wr[k]); });
    if(wrs.length) parts.push("64节风圈 "+wrs.join("/")+"km");
  }
  if(parts.length) return nm+"（"+parts.join(" · ")+"）";
  return nm;
}
/* 台风提示文案；无台风返回空串 */
function typhoonText(){
  if(!TYPHOONS.length) return "";
  var a=[], i;
  for(i=0;i<TYPHOONS.length;i++){ a.push(typhoonLabel(TYPHOONS[i])); }
  return a.join("；");
}
/* 渲染独立的台风行。
   nmc 远洋跟踪用 🌀 蓝色信息风（不是本地预警，不制造恐慌）；
   和风本地台风预警用 ⚠ 红色警示风。 */
function renderTyphoonLine(){
  var el=document.getElementById("tyLine");
  if(!el) return;
  var t=typhoonText();
  if(!t){ el.style.display="none"; el.innerHTML=""; return; }
  /* 任意一个台风来自本地预警，就用警示样式 */
  var isAlert=false, hasQw=false, i;
  for(i=0;i<TYPHOONS.length;i++){
    if(TYPHOONS[i].src==="alert"){ isAlert=true; }
    if(TYPHOONS[i].src==="storm"){ hasQw=true; }   /* 和风 tropical-cyclone */
  }
  var icon=isAlert?"⚠":"🌀";
  var cls="tyBox"+(isAlert?" tyAlert":"");
  var prefix=isAlert?"台风预警":"台风";
  var srcTag=isAlert?"（本地预警）":(hasQw?"（和风跟踪）":"（nmc兜底）");
  el.innerHTML="<span class='"+cls+"' title='"+icon+" "+prefix+" "+srcTag+"："+escHtml(t)+(TYPHOON_AT?("（"+TYPHOON_AT+" 更新）"):"")+"'>"
              +icon+" "+prefix+" "+escHtml(t)+"</span>";
  el.style.display="block";
}
/* 和风实时气象预警行：高温/暴雨/大风/雷电/寒潮/沙尘暴/大雾/霾/干旱/冰雹等。
   按严重程度（severe/extreme 优先）取前 3 条，颜色来自和风预警 color.code。 */
var ALERT_COLORS={blue:"#1565c0",yellow:"#f9a825",amber:"#ef6c00",orange:"#d84315",red:"#c62828",purple:"#6a1b9a",white:"#424242",gray:"#616161",green:"#2e7d32",black:"#212121"};
var ALERT_SEVERITY_ORDER={extreme:0, severe:1, moderate:2, minor:3, unknown:4};
function renderAlerts(){
  var el=document.getElementById("alertLine");
  if(!el) return;
  if(!LAST_ALERTS || !LAST_ALERTS.length){ el.style.display="none"; el.innerHTML=""; return; }
  /* 台风已在 tyLine 单独显示，不在 alertLine 重复 */
  var nonTy=[], i;
  for(i=0;i<LAST_ALERTS.length;i++){
    var a=LAST_ALERTS[i];
    if(a.eventType && (a.eventType.code==="1001" || a.eventType.name==="台风")) continue;
    nonTy.push(a);
  }
  if(!nonTy.length){ el.style.display="none"; el.innerHTML=""; return; }
  nonTy.sort(function(a,b){
    var sa=ALERT_SEVERITY_ORDER[a.severity]!=null?ALERT_SEVERITY_ORDER[a.severity]:9;
    var sb=ALERT_SEVERITY_ORDER[b.severity]!=null?ALERT_SEVERITY_ORDER[b.severity]:9;
    return sa-sb;
  });
  var shown=nonTy.slice(0,3);
  var html="";
  for(i=0;i<shown.length;i++){
    var al=shown[i];
    var c=al.color&&al.color.code?ALERT_COLORS[al.color.code]:"#c62828";
    var bg=al.color&&al.color.code?(al.color.code==="blue"?"#e3f2fd":al.color.code==="yellow"?"#fffde7":al.color.code==="amber"?"#fff8e1":al.color.code==="orange"?"#fbe9e7":al.color.code==="red"?"#ffebee":al.color.code==="purple"?"#f3e5f5":"#ffebee"):"#ffebee";
    var label=al.eventType?al.eventType.name:"预警";
    var sevMap={extreme:"特别严重", severe:"严重", moderate:"中等", minor:"轻微", unknown:""};
    var sevTxt=al.severity&&sevMap[al.severity]?(" "+sevMap[al.severity]):"";
    var title=(al.description||al.headline||label)+(LAST_ALERTS_AT?(" （"+LAST_ALERTS_AT+" 更新）"):"");
    html+="<span class='alertBox' style='color:"+c+";background:"+bg+";border-color:"+c+";' title='"+escHtml(title)+"'>⚠ "+escHtml(label+sevTxt)+"</span>　";
  }
  el.innerHTML=html;
  el.style.display="block";
}
/* ============================================================
   窗口尺寸自适应
   ------------------------------------------------------------
   设计基准固定为 430 x 660（BASE_W/BASE_H），窗口可由用户自由拉伸。
   每次窗口变化时按 min(窗口宽/430, 窗口高/660) 算出缩放系数，
   用 zoom 作用于 #stage 实现整体等比缩放，再在 #app 内居中，
   因此字体、按钮、月相图标、表格行高等会随窗口同步放大缩小，
   在任意分辨率、任意 DPI、跨屏拖动时观感都保持一致。
   ============================================================ */
var BASE_W=430, BASE_H=681;
var WIN_TOP=30;
var stageEl=null, appEl=null;
var layoutTimer=0;
function layoutStage(){
  if(!stageEl) stageEl=document.getElementById("stage");
  if(!appEl)   appEl=document.getElementById("app");
  if(!stageEl||!appEl) return;
  var aw=appEl.clientWidth||appEl.offsetWidth||BASE_W;
  var ah=appEl.clientHeight||appEl.offsetHeight||BASE_H;
  var s=Math.min(aw/BASE_W, ah/BASE_H);
  /* 夹取范围而非回退到 1：窗口极小时按比例缩到 0.35 仍保持布局正确（仅内容被裁切），
     极大时封顶 3 倍，避免高分屏下被放大得过于夸张。
     这里只改 zoom、不调 resizeTo，避免在 onresize 中反向触发窗口调整形成死循环。 */
  s=Math.max(0.35, Math.min(3, s));
  try{ stageEl.style.zoom=s; }catch(e){}
  /* zoom 缩放的是布局尺寸，居中需按缩放后的实际尺寸算 */
  var w=BASE_W*s, h=BASE_H*s;
  stageEl.style.left=Math.max(0,Math.round((aw-w)/2))+"px";
  stageEl.style.top=Math.max(0,Math.round((ah-h)/2))+"px";
}
function onWinResize(){
  try{ if(layoutTimer) clearTimeout(layoutTimer); }catch(e){}
  layoutTimer=setTimeout(layoutStage,60);
}
/* 仅用于决定「初始」窗口大小：屏幕装不下基准尺寸时先缩小一点，
   之后用户随意拉伸，内容由 layoutStage() 的 zoom 负责适配。 */
function initScale(){
  var aw=0, ah=0;
  try{ aw=screen.availWidth||0; ah=screen.availHeight||0; }catch(e){}
  if(!aw||!ah) return 1;
  var s=1;
  if(aw < BASE_W+12) s=Math.min(s, aw/(BASE_W+12));
  if(ah < BASE_H+40) s=Math.min(s, ah/(BASE_H+40));
  if(s>=1) return 1;
  return Math.max(0.6, Math.round(s*100)/100);
}
/* 立即把当前窗口大小与位置写入配置 */
function writeWindowSize(){
  try{
    var w=window.outerWidth||0, h=window.outerHeight||0;
    var x=window.screenLeft||0, y=window.screenTop||0;
    if(w>=RZ_MIN_W && h>=RZ_MIN_H && w<=RZ_MAX_W && h<=RZ_MAX_H){
      if(cfg.winW!==w||cfg.winH!==h||cfg.winX!==x||cfg.winY!==y){
        cfg.winW=w; cfg.winH=h; cfg.winX=x; cfg.winY=y;
        saveCfg();
      }
    }
  }catch(e){}
}
/* 窗口尺寸变化后写盘（去抖）：拖动过程中 resizeEnd 会被反复触发，
   每次都写文件会显著拖慢 IO，因此延后 600ms 只写最后一次结果。 */
var saveWinTimer=0;
function saveWindowSize(){
  try{ if(saveWinTimer) clearTimeout(saveWinTimer); }catch(e){}
  saveWinTimer=setTimeout(function(){
    saveWinTimer=0;
    writeWindowSize();
  },600);
}
function flushWindowSize(){
  if(!saveWinTimer) return;
  try{ clearTimeout(saveWinTimer); }catch(e){}
  saveWinTimer=0;
  writeWindowSize();   /* 退出前把还没落盘的尺寸补写，避免"调完就关"丢失 */
}
/* 仅用于决定初始窗口位置，避免窗口落在屏幕外 */
function centerWindow(w,h){
  var x=Math.round((screen.availWidth-w)/2), y=Math.round((screen.availHeight-h)/2);
  if(y<0) y=0;
  try{ window.moveTo(x,y); }catch(e){}
}
/* 把窗口位置收进当前屏幕可见范围内。
   多显示器时 screenLeft/screenTop 可以为负，若原来放在已拔掉的扩展屏上，
   不夹一下窗口就会开在看不见的地方。 */
function clampWinPos(x,y,w,h){
  var aw=screen.availWidth, ah=screen.availHeight;
  if(!aw||!ah) return [x,y];
  if(typeof x!=="number"||isNaN(x)) x=0;
  if(typeof y!=="number"||isNaN(y)) y=0;
  if(x>aw-60) x=Math.max(0,aw-w-20);
  if(x<60-w) x=20;
  if(y>ah-40) y=Math.max(0,ah-80);
  if(y<0) y=0;
  return [x,y];
}
/* 恢复上次退出时的窗口大小与位置；没有存档时按设计基准放到右上角。 */
function applySavedWindow(){
  var S=initScale();
  var fw=cfg.winW||0, fh=cfg.winH||0;
  var hasSize=(fw>=RZ_MIN_W && fw<=RZ_MAX_W && fh>=RZ_MIN_H && fh<=RZ_MAX_H);
  var x,y;
  if(hasSize){
    x=(cfg.winX||0); y=(cfg.winY||0);
  }else{
    fw=Math.round(BASE_W*S); fh=Math.round(BASE_H*S);
    x=screen.availWidth-Math.round(460*S); y=Math.round(WIN_TOP*S);
  }
  var p=clampWinPos(x,y,fw,fh); x=p[0]; y=p[1];
  try{ window.resizeTo(fw,fh); }catch(e){}
  try{ window.moveTo(x,y); }catch(e){}
  layoutStage();
  if(!hasSize) return;
  /* window.onload 阶段窗口可能尚未完全就绪，resizeTo 有时会被系统忽略。
     延后再核验一次，若尺寸仍不符则重设，避免"存了却没恢复"。 */
  defer(function(){
    try{
      var cw=window.outerWidth||0, ch=window.outerHeight||0;
      if(cw>0 && ch>0 && (Math.abs(cw-fw)>2 || Math.abs(ch-fh)>2)){
        var q=clampWinPos(x,y,fw,fh);
        window.resizeTo(fw,fh);
        window.moveTo(q[0],q[1]);
      }
    }catch(e){}
    layoutStage();
  },260);
}
function initApp(){
  /* 必须先 loadCfg 再决定窗口尺寸与位置：
     存档里的 winW/winH/winX/winY 要在这里才可用，否则读到的是初始值 0，
     恢复分支永远进不去。 */
  loadCfg();
  applySavedWindow();
  /* 只监听 onresize。
   早期还监听了 window.onmove，想在跨屏拖动时重算缩放，但 onmove 在拖动过程中
   每帧都触发，而 layoutStage() 会做 zoom 重算 + 整个日历重新排版，
   等于每帧全量重排一次——这就是"拖动窗口很卡"的根因。
   移动窗口不改变客户区尺寸，缩放系数无需重算，故完全不监听 onmove。 */
try{ window.onresize=onWinResize; }catch(e){}
  try{ fixAutostartPath(); }catch(e9){}   /* 程序移盘后自动修正启动项路径 */
  bindDrag();
  bindResize();
  bindKeys();
  bindPoster();
  bindToast();
  bindMarquee();
  bindSettingsUI();
  bindSchoolUI();
  myLoad();
  schoolLoad();
  holInit(); holLoad();
  document.getElementById("btnClose").onclick=closeApp;
  document.getElementById("btnSettings").onclick=function(){
    settingsCity="";
    var sel=document.getElementById("cfgCity");
    if(!sel.options.length){
      for(var k in cityMap){
        sel.options[sel.options.length]=new Option(k,k);
      }
    }
    /* 自动定位到的临时城市（不在 cityMap 中，如外地用户定位到的区县）：
       先清掉旧的临时项，再把当前生效城市插到首位，保证下拉框正确回显——
       否则 sel.value 匹配不到任何 option，IE 下会显示空白/第一项，误导用户 */
    for(var oi=sel.options.length-1;oi>=0;oi--){
      if(!cityMap[sel.options[oi].value]) sel.remove(oi);
    }
    if(cfg.city && !cityMap[cfg.city]){
      var tmpOpt=new Option(cfg.city,cfg.city);
      try{ sel.options.add(tmpOpt,0); }catch(eOpt){ sel.options[sel.options.length]=tmpOpt; }
    }
    sel.value=cfg.city;
    var wsel=document.getElementById("cfgWeek");
    if(wsel) wsel.value=(cfg.weekStart===0)?"0":"1";
    var ssel=document.getElementById("cfgSchool");
    if(ssel) ssel.value=(cfg.showSchool===1)?"1":"0";
    var asel=document.getElementById("cfgAuto");
    if(asel) asel.value=isAutostart()?"1":"0";
    updateGeoRow();
    document.getElementById("btnGeo").onclick=function(){
      var b=this;
      b.disabled=true;
      tryAutoGeo(false);
      setTimeout(function(){ b.disabled=false; },4000);
    };
    /* 选择城市只做 UI 预览，点「保存」才真正写入 cfg 并生效；
       直接关闭（取消/✕/点外面）则重置，设置与日历始终一致。
       切到有校历数据的城市时自动打开校历开关（防之前切无校历城市
       把 showSchool 置 0 后切回深圳仍不显示假期）；用户仍可保存前手动关掉。 */
    sel.onchange=function(){
      settingsCity=sel.value;
      var ssel=document.getElementById("cfgSchool");
      if(ssel && schoolSeedOf(sel.value)) ssel.value="1";
      updateGeoRow();
      updateSchoolRow();
      renderSchList();
    };
    updateSchoolRow();
    renderSchList();
    renderMfList();
    mfDateHelp();
    document.getElementById("holTip").innerHTML=
      escHtml(holStatusText()+"　"+schoolStatusText())
      +"<br>调休来自国务院办公厅通知，深圳校历来自市教育局发文；两者每天首次运行时自动同步。";
    document.getElementById("settings").style.display="block";
  };
  document.getElementById("cfgSave").onclick=function(){
    /* 开机自启：写/删 HKCU Run 注册表项 */
    var asel=document.getElementById("cfgAuto");
    if(asel){
      var wantOn=(asel.value==="1");
      var okAuto=setAutostart(wantOn);
      if(!okAuto){
        alert(wantOn?"无法写入启动项，请检查注册表权限。":"无法删除启动项，请检查注册表权限。");
      }else if(wantOn){
        asel.title=autostartCmd();
      }
    }
    var city=document.getElementById("cfgCity").value;
    var ssel=document.getElementById("cfgSchool");
    cfg.showSchool=(ssel&&ssel.value==="1" && schoolSeedOf(city))?1:0;
    if(city && cityMap[city]){
      cfg.city=city;
      cfg.code=cityMap[city].code;
      cfg.lat=cityMap[city].lat;
      cfg.lng=cityMap[city].lng;
      cfg.geoDone=1;   /* 手动选城市视为明确选择：下次启动不再自动定位覆盖 */
      cfg.manualCity=1;
      /* 重置全部天气缓存，否则新城市名会配旧城市的天气/实况/AQI，
         出现"北京 多云"却显示广州温度的串城市错误 */
      lastWeather=null; weatherFailed=false; live=null; lastOfficialType="";
      fetchWeather(true); if(!QWEATHER_KEY) fetchLive();
    }
    settingsCity="";
    /* 每周起始日与城市无关，单独设置并始终落盘 */
    var wsel=document.getElementById("cfgWeek");
    cfg.weekStart=(wsel&&wsel.value==="0")?0:1;
    saveCfg();
    document.getElementById("settings").style.display="none";
    redrawCurrent();
  };
  document.getElementById("cfgCancel").onclick=function(){
    settingsCity="";
    document.getElementById("settings").style.display="none";
  };
  document.getElementById("setClose").onclick=function(){
    settingsCity="";
    document.getElementById("settings").style.display="none";
  };
  /* 点击面板之外的区域也可关闭，符合"点外面收起"的直觉。
     注意：bindDrag() 已占用 document.onmousedown，直接赋值会被覆盖，
     故用 attachEvent 追加监听（IE5+ 支持），互不干扰。 */
  var panel=document.getElementById("settings");
  var outsideDown=function(){
    if(panel.style.display==="none") return;
    var e=window.event, t=e.srcElement;
    if(!t) return;
    var p=t;
    while(p){
      if(p.id==="settings"||p.id==="btnSettings") return;
      p=p.parentNode;
    }
    settingsCity="";
    panel.style.display="none";
  };
  try{ document.attachEvent("onmousedown",outsideDown); }catch(e10){}
  /* 调休与校历都已每日自动同步，这里只提供一个"立刻再取一次"的入口，
     放在提示行里做成链接，不与主要按钮抢注意力。 */
  document.getElementById("syncLink").onclick=function(){
    var link=this, tip=document.getElementById("holTip");
    if(link.className.indexOf("disabled")>=0) return;
    link.className="syncLink disabled"; link.innerHTML="正在更新…";
    var done=0;
    syncHolidays(true,function(st,updated){
      if(updated) done++;
      syncSchool(true,function(st2){
        if(st2=="synced") done++;
        link.className="syncLink"; link.innerHTML="立即更新假期数据（调休 + 校历）";
        tip.innerHTML=(done?("已更新 "+done+" 项"):"未获取到更新（可能尚未公布或无网络）")
          +"　当前："+holStatusText()+"　"+schoolStatusText();
        updateSchoolRow();
        redrawCurrent();
      });
    });
  };
  document.getElementById("prevBtn").onclick=function(){ inMonthView?shiftMonth(-1):shiftDay(-1); };
  document.getElementById("nextBtn").onclick=function(){ inMonthView?shiftMonth(1):shiftDay(1); };
  document.getElementById("todayBtn").onclick=goToday;
  document.getElementById("toggleBtn").onclick=function(){ showView(!inMonthView); };
  document.getElementById("prevYear").onclick=function(){ shiftMonth(-12); };
  document.getElementById("nextYear").onclick=function(){ shiftMonth(12); };
  /* 万年历 -> 每日黄历。放在月视图表头内，常驻可见：
     底部导航条会浮动收起且按钮多时易被裁掉，这里才是可靠的返回入口。 */
  document.getElementById("mBackBtn").onclick=function(){ showView(false); };
  document.getElementById("prevMonth").onclick=function(){ shiftMonth(-1); };
  document.getElementById("nextMonth").onclick=function(){ shiftMonth(1); };
  document.getElementById("calBody").onclick=function(){
    var e=window.event, t=e.srcElement;
    while(t && t.tagName!="TD") t=t.parentNode;
    if(t && t.getAttribute("data-d")){
      cur=new Date(viewY,viewM-1,parseInt(t.getAttribute("data-d"),10));
      showView(false);
    }
  };
  showView(false);
  lastTodayKey=todayKeyOf(new Date());
  defer(function(){ fetchWeather(true); if(!QWEATHER_KEY) fetchLive(); }, 400);
  /* 每次启动静默自动定位（IP 城市名变短时保留原区级城市）；
     用户在设置里手动选过城市（manualCity=1）则尊重其选择，不自动定位覆盖 */
  if(!cfg.manualCity) defer(function(){ tryAutoGeo(true); }, 700);
  /* 防"显示桌面"隐藏：窗口若被系统最小化/隐藏，自动还原（用户无法手动最小化，不抢操作） */
  defer(function(){ try{ bindAutoRestore(); }catch(e){} }, 1500);
  /* 和风有 key 时 typhoon.nmc.cn / wttr.in 都降级为 backup */
  defer(function(){ if(!QWEATHER_KEY){ fetchTyphoon(); fetchLive(); } }, 900);
  /* 调休安排：启动后延迟同步（避开 onload 阶段的请求限制），之后每天复查一次 */
  defer(function(){ syncHolidays(false, function(st,updated){ if(updated) redrawCurrent(); }); }, 1200);
  tickTimer=setInterval(tick,30000);
}
try{ window.onbeforeunload=cleanupAll; }catch(e){}
if(typeof window!="undefined"){ window.onload=initApp; }
//__HL_END__
</script>
</body>
</html>
